          "entries": [
            {
              "label": "EditorHistory.h",
              "path": "Editor/include/history/EditorHistory.h",
              "topic": "履歴と編集中の操作を保持",
              "explanation": "Entry は適用するコマンドと状態を、PendingEdit は確定前の値を管理します。Begin と CommitEdit によりドラッグ全体を1件にできます。",
              "follow": "Entry・PendingEdit と BeginTransforms／CommitEdit。"
            },
            {
              "label": "EditorHistory.cpp",
              "path": "Editor/src/history/EditorHistory.cpp",
              "topic": "確定とUndo／Redoのカーソル",
              "explanation": "CommitEdit は操作前後を比較して履歴を作ります。Undoはカーソル直前、Redoはカーソル位置を使い、適用成功後にカーソルを更新します。",
              "follow": "CommitEdit → AppendPrepared。Undo・Redo・MarkSaved。"
            },
            {
              "label": "ActiveCommand.h",
              "path": "Editor/include/history/ActiveCommand.h",
              "topic": "物体自身の有効設定の履歴",
              "explanation": "対象IDと有効設定の変更前後を保持します。子への有効状態の継承はシーン側が計算します。",
              "follow": "Undo／Redo と SceneActivity::BuildStates。"
            },
            {
              "label": "ActiveCommand.cpp",
              "path": "Editor/src/history/ActiveCommand.cpp",
              "topic": "有効設定を元に戻す・再適用する",
              "explanation": "Undo／Redo は対象の物体を検索し、期待する現在値を確認してから active を更新します。",
              "follow": "Undo と Redo の期待値の向き。"
            },
            {
              "label": "ColliderCommand.h",
              "path": "Editor/include/history/ColliderCommand.h",
              "topic": "Colliderの追加・変更・削除の履歴",
              "explanation": "Collider設定を変更前後で保持します。値がないことも変更の一部として記録できるため、追加と削除を戻せます。",
              "follow": "HasChanges と Undo／Redo。"
            },
            {
              "label": "ColliderCommand.cpp",
              "path": "Editor/src/history/ColliderCommand.cpp",
              "topic": "衝突設定を履歴値へ切り替える",
              "explanation": "Undo／Redo は変更前後を逆向きに使ってColliderを切り替えます。適用時に対象と現在の設定を確認します。",
              "follow": "Undo／Redo から共通の適用処理を追う。"
            },
            {
              "label": "AlignmentAxis.h",
              "path": "Editor/include/history/AlignmentAxis.h",
              "topic": "整列と等間隔配置の軸",
              "explanation": "ワールド座標で編集に使うX・Y・Z軸を指定する列挙型です。整列・等間隔配置の処理が軸を受け取ります。",
              "follow": "EditorHistory::AlignObjects と DistributeObjects。"
            },
            {
              "label": "CommandGroup.h",
              "path": "Editor/include/history/CommandGroup.h",
              "topic": "複数の操作を履歴1件にまとめる",
              "explanation": "異なる種類のコマンドを実行順に保持します。グループ全体をUndo／Redoの1単位として扱います。",
              "follow": "Command とコンストラクタ、Undo／Redo。"
            },
            {
              "label": "CommandGroup.cpp",
              "path": "Editor/src/history/CommandGroup.cpp",
              "topic": "順序を守って一括で取り消す",
              "explanation": "Undo は逆順、Redo は順方向に実行します。作業用シーンで全部成功したときに確定するため、途中の失敗で半分だけ反映されません。",
              "follow": "Undo の rbegin と Redo の順方向ループ、ApplyTransaction。"
            },
            {
              "label": "ComponentCommand.h",
              "path": "Editor/include/history/ComponentCommand.h",
              "topic": "任意コンポーネントに共通する編集履歴",
              "explanation": "テンプレート引数で SceneObject のどのフィールドを変更するかを指定します。optional の前後の値を用い、追加・変更・削除を扱えます。",
              "follow": "Apply の現在値チェックと CameraCommand／RigidBodyCommand の型定義。"
            },
            {
              "label": "ModelPathCommand.h",
              "path": "Editor/include/history/ModelPathCommand.h",
              "topic": "Meshとモデル参照の編集履歴",
              "explanation": "Meshがあるかと形状の参照を一緒に変更前後として保持します。保持している素材参照の書き換えもできます。",
              "follow": "Undo／Redo と RewriteObjects。"
            },
            {
              "label": "ModelPathCommand.cpp",
              "path": "Editor/src/history/ModelPathCommand.cpp",
              "topic": "Mesh設定を履歴から適用",
              "explanation": "Undo／Redo は現在の Mesh を確認してから入れ替えます。素材移動時には履歴側の参照も RewriteObjects で更新できます。",
              "follow": "Undo・Redo・RewriteObjects。"
            },
            {
              "label": "ObjectArraySettings.h",
              "path": "Editor/include/history/ObjectArraySettings.h",
              "topic": "行と列で物体を複製する設定",
              "explanation": "列の間隔、行の間隔、件数を持ちます。GetCopyCount は元の物体のぶんを除き、IsValid は増える総オブジェクト数も制限します。",
              "follow": "GetCopyCount と GetPosition の行・列の計算。"
            },
            {
              "label": "ObjectCommand.h",
              "path": "Editor/include/history/ObjectCommand.h",
              "topic": "追加・削除の履歴に物体データを保持",
              "explanation": "物体ID、物体のデータ、CREATE／DELETEの区別を保持します。削除した物体も同じIDとデータで戻すための記録です。",
              "follow": "Kind と保持する object_ を Undo／Redo と照合。"
            },
            {
              "label": "ObjectCommand.cpp",
              "path": "Editor/src/history/ObjectCommand.cpp",
              "topic": "物体を復元または削除する",
              "explanation": "CREATEのUndoは削除、DELETEのUndoは復元です。Redoはその逆を行い、復元では保存していたIDを使います。",
              "follow": "Undo と Redo の Kind 分岐 → Scene::RestoreObject。"
            },
            {
              "label": "ObjectRename.h",
              "path": "Editor/include/history/ObjectRename.h",
              "topic": "一括改名に渡す1件の情報",
              "explanation": "対象ID、変更前の名前、変更後の名前をまとめた値です。複数件を並べて一括で履歴へ渡せます。",
              "follow": "EditorHistory::RenameObjects。"
            },
            {
              "label": "ParentCommand.h",
              "path": "Editor/include/history/ParentCommand.h",
              "topic": "親変更前後の親IDとローカル変形",
              "explanation": "親を変更するとローカル変形も変わる場合があるため、親IDと変形の両方をUndo／Redoで戻せるように保存します。",
              "follow": "beforeParent_／afterParent_ と before_／after_。"
            },
            {
              "label": "ParentCommand.cpp",
              "path": "Editor/src/history/ParentCommand.cpp",
              "topic": "親とローカル変形を同時に反映",
              "explanation": "想定する現在の親IDとローカル変形を検証します。候補シーンへ両方を適用し、ワールド変形を構築できた場合に確定します。",
              "follow": "Apply の ApplyTransaction と BuildWorldTransforms。"
            },
            {
              "label": "RenameCommand.h",
              "path": "Editor/include/history/RenameCommand.h",
              "topic": "名前の変更前後を記録",
              "explanation": "名前の文字列の前後と対象IDを保持します。HasChanges で実際に変化があった操作かを判定できます。",
              "follow": "HasChanges と対象IDを使う Undo／Redo。"
            },
            {
              "label": "RenameCommand.cpp",
              "path": "Editor/src/history/RenameCommand.cpp",
              "topic": "現在の名前を確認してから置き換える",
              "explanation": "Undo／Redo は対象が存在し、現在の名前が履歴の予想どおりの場合に、保存していたもう一方の名前を適用します。",
              "follow": "Undo の after、Redo の before の比較。"
            },
            {
              "label": "ScenePatchCommand.h",
              "path": "Editor/include/history/ScenePatchCommand.h",
              "topic": "複数の物体の差分を履歴にする",
              "explanation": "SceneObjectの変更前後を物体IDとまとめて保持します。optional によって、ある時点で物体が存在しないことも記録できます。",
              "follow": "Values と Apply の expected・values。"
            },
            {
              "label": "ScenePatchCommand.cpp",
              "path": "Editor/src/history/ScenePatchCommand.cpp",
              "topic": "シーンの差分をまとめて適用する",
              "explanation": "前後のシーンを比べて変わった物体だけを保持します。Undo／Redo は現在値を検証し、作業用シーンで差分を適用します。",
              "follow": "コンストラクタの差分抽出 → Apply。"
            },
            {
              "label": "TextureSlotsCommand.h",
              "path": "Editor/include/history/TextureSlotsCommand.h",
              "topic": "テクスチャ割り当ての編集履歴",
              "explanation": "物体の TextureBindings の前後を記録します。素材名の変更や移動に合わせて、履歴にある参照も更新できます。",
              "follow": "Undo／Redo と RewriteObjects。"
            },
            {
              "label": "TextureSlotsCommand.cpp",
              "path": "Editor/src/history/TextureSlotsCommand.cpp",
              "topic": "画像の割り当てを復元する",
              "explanation": "Apply は対象の描画コンポーネントと現在の割り当てを確認し、成功時に別の割り当てを反映します。",
              "follow": "Apply の expected と value の使い方。"
            },
            {
              "label": "TransformCommand.h",
              "path": "Editor/include/history/TransformCommand.h",
              "topic": "変形前後を物体IDと保持",
              "explanation": "位置・回転・拡大率を含む Transform の前後を持ちます。複数物体なら物体ごとのコマンドをグループ化できます。",
              "follow": "EditorHistory::CommitEdit と CommandGroup。"
            },
            {
              "label": "TransformCommand.cpp",
              "path": "Editor/src/history/TransformCommand.cpp",
              "topic": "履歴の前後の変形へ切り替える",
              "explanation": "変更の比較は TransformUtils::AreEqual を使います。Undo／Redo は対象と現在の変形を確認してから適用します。",
              "follow": "HasChanges と Undo／Redo。"
            },
            {
              "label": "VisibilityCommand.h",
              "path": "Editor/include/history/VisibilityCommand.h",
              "topic": "メッシュの表示設定を履歴にする",
              "explanation": "対象IDと表示状態の前後を保持します。物体自身の有効設定は別の ActiveCommand で扱います。",
              "follow": "VisibilityCommand と ActiveCommand の対象フィールドを比較。"
            },
            {
              "label": "VisibilityCommand.cpp",
              "path": "Editor/src/history/VisibilityCommand.cpp",
              "topic": "表示フラグを復元する",
              "explanation": "Undo／Redo は物体の MeshRenderer と現在の visible を確認し、履歴にある反対側の値へ切り替えます。",
              "follow": "Undo・Redo が meshRenderer の visible を使う箇所。"
            }
          ]
        }
      }
    },
