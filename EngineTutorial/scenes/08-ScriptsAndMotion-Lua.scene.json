        "state": {
          "entries": [
            {
              "label": "LuaScript.h",
              "path": "Engine/include/scripting/LuaScript.h",
              "topic": "C++側からLuaを呼ぶ公開の入口",
              "explanation": "読み込み・コンパイル・実行を公開し、コンパイル結果のハンドルはLua VMの内部型を公開せず共有できます。",
              "follow": "LuaScriptProgram と LuaScript::Compile／Invoke。"
            },
            {
              "label": "LuaScript.cpp",
              "path": "Engine/src/scripting/LuaScript.cpp",
              "topic": "Luaコールバックを保護して実行",
              "explanation": "メモリと実行命令数に上限を設け、許可した環境内でコールバックを実行します。失敗時にはLuaのエラーをC++側へ返します。",
              "follow": "割り当てと命令フック、lua_pcall を使う経路。"
            },
            {
              "label": "LuaStateData.h",
              "path": "Engine/src/scripting/LuaStateData.h",
              "topic": "LuaとJSONの間で状態を運ぶAPI",
              "explanation": "事前検証した状態をツリーにし、保護呼び出しでLuaテーブルに変換します。読み戻す側の制約もここで宣言します。",
              "follow": "検証・事前変換と、Lua内での読み書きの分担。"
            },
            {
              "label": "LuaStateData.cpp",
              "path": "Engine/src/scripting/LuaStateData.cpp",
              "topic": "Luaテーブルを保存可能な状態に変換",
              "explanation": "キーや値の許可範囲、件数などを調べます。Luaの状態を直接保存する代わりに、JSONへ変換して結果を保持します。",
              "follow": "LuaStateData.h に宣言された検証・変換関数を追う。"
            },
            {
              "label": "ScriptMessage.h",
              "path": "Engine/include/scripting/ScriptMessage.h",
              "topic": "次の更新へ渡すLua通知",
              "explanation": "受け手や送り手を物体IDで保持し、データを複製して受け渡します。物体のアドレスやLuaテーブルを外へ持ち出さずに済みます。",
              "follow": "ScriptMailbox::Enqueue に渡す通知名とデータ。"
            },
            {
              "label": "ScriptMailbox.h",
              "path": "Engine/include/scripting/ScriptMailbox.h",
              "topic": "再生シーン内の通知キュー",
              "explanation": "次に配信する通知を制限付きでため、スクリプトの更新時に取り出す入口を公開します。",
              "follow": "Enqueue・BeginStep・RemoveMissingReceivers。"
            },
            {
              "label": "ScriptMailbox.cpp",
              "path": "Engine/src/scripting/ScriptMailbox.cpp",
              "topic": "送信時と配信時を分ける",
              "explanation": "Enqueue で通知を追加し、BeginStep で前回までにたまった通知を取り出します。存在しない受け手への通知は整理できます。",
              "follow": "Enqueue と BeginStep。名前の検証は ScriptMessage::IsValidName。"
            },
            {
              "label": "SceneScripts.h",
              "path": "Engine/include/gameplay/SceneScripts.h",
              "topic": "物体ごとに状態と開始済み情報を管理",
              "explanation": "コンパイル済みのコードを共有し、各物体の状態や次回処理する通知を分けて保持します。",
              "follow": "Configure・Run・QueueTriggers。"
            },
            {
              "label": "SceneScripts.cpp",
              "path": "Engine/src/gameplay/SceneScripts.cpp",
              "topic": "対象物体のLuaをスケジュールする",
              "explanation": "設定からスクリプトを準備し、開始・更新や接触と通知に応じてコールバックを呼びます。失敗には物体を識別する情報を付けます。",
              "follow": "Configure → Run、通知側の QueueTriggers。"
            },
            {
              "label": "SceneSimulationScripts.cpp",
              "path": "Engine/src/gameplay/SceneSimulationScripts.cpp",
              "topic": "シーンの更新とLuaの実行を接続",
              "explanation": "ApplyScripts が入力や現在のシーンをスクリプト処理へ渡します。Luaからの要求はエンジンの再生用状態に反映されます。",
              "follow": "ApplyScripts → SceneScripts::Run。"
            },
            {
              "label": "GameScriptEditor.h",
              "path": "Engine/include/graphics/ui/GameScriptEditor.h",
              "topic": "配布アプリ内の任意のLua編集画面",
              "explanation": "指定されたボタンからLuaを開く、表示する、状態を消す操作を公開します。シーンに設定した場合に使用します。",
              "follow": "OpenClickedScript・Draw・Reset。"
            },
            {
              "label": "GameScriptEditor.cpp",
              "path": "Engine/src/graphics/ui/GameScriptEditor.cpp",
              "topic": "ボタンからコードを開き、画面内で試す",
              "explanation": "editInGame を有効にしたボタンから開きます。入力したコードは複製シーンに対して start だけ実行し、ログを表示します。",
              "follow": "OpenClickedScript の判定と Run の実行。"
            }
          ]
        }
      }
    },
