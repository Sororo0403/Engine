        "state": {
          "entries": [
            {
              "label": "Engine.slnx",
              "path": "Engine.slnx",
              "topic": "x64のソリューションと参照するプロジェクト",
              "explanation": "Engine、Editor、Runtimeを登録し、外部ライブラリ用のLua、Jolt、ImGuizmoのプロジェクトもまとめます。",
              "follow": "Project と /External/ フォルダ。"
            },
            {
              "label": "Engine.vcxproj",
              "path": "Engine/Engine.vcxproj",
              "topic": "静的ライブラリと実行用リソースのビルド",
              "explanation": "Engineをビルドし、LuaやJoltを参照します。ビルド後はEngineのシェーダーや外部DLLなどを実行用の出力先へ置きます。",
              "follow": "ProjectReference と PostBuildEvent。"
            },
            {
              "label": "Engine.vcxproj.filters",
              "path": "Engine/Engine.vcxproj.filters",
              "topic": "EngineのファイルをVisual Studio上で整理",
              "explanation": "コンパイルやプロジェクトで使うファイルを、Solution Explorerの階層へ対応付けます。",
              "follow": "ClCompile／ClInclude の Filter を対応する vcxproj と比較。"
            },
            {
              "label": "Editor.vcxproj",
              "path": "Editor/Editor.vcxproj",
              "topic": "Editorの実行ファイルと試遊に使う参照",
              "explanation": "EngineとImGuizmoを参照します。Editor固有のリソースはビルド後に配置されます。",
              "follow": "ProjectReference と resources/editor へのコピー。"
            },
            {
              "label": "Editor.vcxproj.filters",
              "path": "Editor/Editor.vcxproj.filters",
              "topic": "Editorのソースとヘッダーの表示階層",
              "explanation": "編集機能ごとにファイルが見えるようVisual Studioのフィルターを設定します。",
              "follow": "Filter の定義と実装ファイルの割り当て。"
            },
            {
              "label": "Runtime.vcxproj",
              "path": "Runtime/Runtime.vcxproj",
              "topic": "配布の元になるRuntimeを作る",
              "explanation": "Engineを参照し、MSVCの版と構成ごとの出力先を使います。Releaseでは配布用DLLとビルド情報も準備します。",
              "follow": "OutDir・IntDir と PostBuildEvent の --write-build-info。"
            },
            {
              "label": "Runtime.vcxproj.filters",
              "path": "Runtime/Runtime.vcxproj.filters",
              "topic": "Runtimeの入口とシーンの表示階層",
              "explanation": "コンパイル対象のファイルにソリューション上の表示場所を割り当てます。",
              "follow": "main.cpp と RuntimeScene の表示先。"
            },
            {
              "label": ".clang-format",
              "path": ".clang-format",
              "topic": "C++の空行とインデントの整形",
              "explanation": "タブによるインデント、短いブロック、関数の間の空行などを整形ツールへ設定します。",
              "follow": "UseTab・SeparateDefinitionBlocks・AllowShortBlocksOnASingleLine。"
            },
            {
              "label": ".editorconfig",
              "path": ".editorconfig",
              "topic": "文字コード・改行などの編集設定",
              "explanation": "UTF-8・CRLF・末尾改行の方針を指定します。C++やHLSLのタブと末尾空白の設定も含みます。",
              "follow": "全ファイルの指定と拡張子別の指定。"
            },
            {
              "label": ".gitattributes",
              "path": ".gitattributes",
              "topic": "Gitが扱う改行の基本設定",
              "explanation": "text=auto でテキストと判断したファイルの改行をGitが正規化します。",
              "follow": "先頭の text=auto と .editorconfig を照合。"
            },
            {
              "label": ".gitignore",
              "path": ".gitignore",
              "topic": "生成物をGit管理の対象から外す",
              "explanation": "ビルド出力、IDEの一時データなど、再生成できるファイルを無視する設定を持ちます。",
              "follow": "出力先 build/ が無視されることを確認。"
            }
          ]
        }
      }
    },
