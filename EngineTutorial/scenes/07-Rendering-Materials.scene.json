        "state": {
          "entries": [
            {
              "label": "ColorTint.h",
              "path": "Engine/include/graphics/material/ColorTint.h",
              "topic": "元の材質に掛けるRGB",
              "explanation": "モデルの材質へ掛ける赤・緑・青を持ちます。透明度やテクスチャ参照、UV設定は別に保持します。",
              "follow": "ColorTint の検証と ColorTintInspector の編集。"
            },
            {
              "label": "MaterialData.h",
              "path": "Engine/include/graphics/material/MaterialData.h",
              "topic": "GPUへ渡す材質の定数",
              "explanation": "ベース色、UV変形、照明の扱いなどを持ちます。部分表示や白黒効果に使うデータ型も定義します。",
              "follow": "MaterialData と Mesh.PS.hlsl の MaterialBuffer。"
            },
            {
              "label": "MaterialData.cpp",
              "path": "Engine/src/graphics/material/MaterialData.cpp",
              "topic": "材質や画面効果の値を検証する",
              "explanation": "材質の値と、部分表示・白黒効果の設定範囲を検証します。材質同士を比較する実装もあります。",
              "follow": "MaterialData::IsValid と RadialReveal／MonochromeEffect の IsValid。"
            },
            {
              "label": "Material.h",
              "path": "Engine/include/graphics/material/Material.h",
              "topic": "共有する元データと描画ごとの値",
              "explanation": "MaterialResource を参照しながら、描画に使う材質の値を定数バッファとして持ちます。",
              "follow": "Initialize・Update・GetTextureSrv。"
            },
            {
              "label": "Material.cpp",
              "path": "Engine/src/graphics/material/Material.cpp",
              "topic": "定数を書き換え、使う画像を取得する",
              "explanation": "Update で材質の定数を更新します。画像のSRVは参照する MaterialResource から取得します。",
              "follow": "Update・SetResource・GetTextureSrv。"
            },
            {
              "label": "MaterialHandle.h",
              "path": "Engine/include/graphics/material/MaterialHandle.h",
              "topic": "共有材質への参照を渡す",
              "explanation": "画像などの共有材質への参照を描画物体とマネージャーの間で使います。",
              "follow": "MaterialManager::LoadTexture の戻り値。"
            },
            {
              "label": "MaterialManager.h",
              "path": "Engine/include/graphics/material/MaterialManager.h",
              "topic": "モデルから独立した画像の共有",
              "explanation": "追加する画像を読み込んでGPUリソースを共有する入口です。",
              "follow": "LoadTexture と Finalize。"
            },
            {
              "label": "MaterialManager.cpp",
              "path": "Engine/src/graphics/material/MaterialManager.cpp",
              "topic": "画像を読み変換結果をキャッシュする",
              "explanation": "対象画像を読み込んで描画用に準備し、同じ画像を使う呼び出しで共有できるようにします。",
              "follow": "LoadTexture のキャッシュ判定と生成。"
            },
            {
              "label": "MaterialResource.h",
              "path": "Engine/include/graphics/material/MaterialResource.h",
              "topic": "共有する画像と材質の初期値",
              "explanation": "画像リソース、参照用のSRV、初期材質値を、メッシュとは別の共有リソースにまとめます。",
              "follow": "Initialize と GetTextureSrv。"
            },
            {
              "label": "MaterialResource.cpp",
              "path": "Engine/src/graphics/material/MaterialResource.cpp",
              "topic": "画像をシェーダーから読めるようにする",
              "explanation": "画像データからテクスチャとその参照用のSRVを準備し、描画側が使うハンドルを返します。",
              "follow": "Initialize → CreateTextureView → GetTextureSrv。"
            },
            {
              "label": "MeshRendererComponent.h",
              "path": "Engine/include/scene/MeshRendererComponent.h",
              "topic": "モデルの見た目を物体別に上書き",
              "explanation": "表示するかどうか、画像スロット、UV変形、霧の適用などをシーンの物体ごとに持ちます。",
              "follow": "IsValid と SceneRenderer::SynchronizeObjects。"
            }
          ]
        }
      }
    },
