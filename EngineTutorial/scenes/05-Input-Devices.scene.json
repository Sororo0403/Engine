        "state": {
          "entries": [
            {
              "label": "InputState.h",
              "path": "Engine/include/input/InputState.h",
              "topic": "同じフレームの入力スナップショット",
              "explanation": "アプリが入力を受け取るかと、キーボード・マウス・ゲームパッド・Wiiリモコンの状態をまとめます。",
              "follow": "WindowsInputBackend::Update が書き、InputSystem::Update が読む。"
            },
            {
              "label": "IInputBackend.h",
              "path": "Engine/include/input/IInputBackend.h",
              "topic": "OS入力の取り込み口を定義",
              "explanation": "Initialize・Update・Finalize を外部実装へ委ねます。Update が成功しても、非アクティブなら入力を受け取らない状態を返せます。",
              "follow": "Update の戻り値と InputState::active を比較。"
            },
            {
              "label": "InputSystem.h",
              "path": "Engine/include/input/InputSystem.h",
              "topic": "デバイスの状態を共通APIで読む",
              "explanation": "バックエンドを所有し、各デバイスの取得結果を更新します。呼び出し側はデバイスの状態を参照できます。",
              "follow": "Initialize に渡す IInputBackend とデバイス取得関数。"
            },
            {
              "label": "InputSystem.cpp",
              "path": "Engine/src/input/InputSystem.cpp",
              "topic": "入力取得に失敗したら状態を戻す",
              "explanation": "バックエンドを更新し、成功時は今回の状態を各デバイスへ渡します。非アクティブ時と失敗時は状態を消去し、失敗だけを呼び出し元に伝えます。",
              "follow": "Update の取得失敗と active の分岐 → Engine::MainLoop。"
            },
            {
              "label": "Key.h",
              "path": "Engine/include/input/Key.h",
              "topic": "OSから独立したキーの識別子",
              "explanation": "共通のキーを列挙値として持ちます。この値を使って配列の状態を読み、Windowsの仮想キーとは変換して対応付けます。",
              "follow": "Key → WindowsInputBackend::ToKey。"
            },
            {
              "label": "Keyboard.h",
              "path": "Engine/include/input/Keyboard.h",
              "topic": "キーの現在値と前回値を保持",
              "explanation": "State はキーごとの押している状態です。両フレームの値から長押しと押した瞬間を別々に取得できます。",
              "follow": "State・IsDown・IsPressed・IsReleased。"
            },
            {
              "label": "Keyboard.cpp",
              "path": "Engine/src/input/Keyboard.cpp",
              "topic": "長押しと押した瞬間を区別",
              "explanation": "Update で前回値を保存してから新しい値を入れます。IsPressed は前回オフで今回オン、IsReleased は逆の組み合わせです。",
              "follow": "Update と IsPressed の論理式。"
            },
            {
              "label": "MouseButton.h",
              "path": "Engine/include/input/MouseButton.h",
              "topic": "マウスボタンを共通の名前で表す",
              "explanation": "左・右・中・追加ボタンを列挙します。COUNT は状態配列の大きさに使われます。",
              "follow": "MouseState::buttons と ReadMouse の変換表。"
            },
            {
              "label": "MouseState.h",
              "path": "Engine/include/input/MouseState.h",
              "topic": "座標と相対移動を別々に持つ",
              "explanation": "deltaX／Y は前回からの相対移動量、positionX／Y はウィンドウ内の座標です。ホイール変化量と座標の有効フラグも持ちます。",
              "follow": "ReadMouse が座標と移動量を設定する箇所。"
            },
            {
              "label": "Mouse.h",
              "path": "Engine/include/input/Mouse.h",
              "topic": "マウスのフレーム間の状態を保持",
              "explanation": "ボタンの状態と移動量などを読み出すAPIです。ボタンを押した瞬間と離した瞬間を取得できます。",
              "follow": "GetState・IsPressed・IsReleased。"
            },
            {
              "label": "Mouse.cpp",
              "path": "Engine/src/input/Mouse.cpp",
              "topic": "ボタンの変化を判定する",
              "explanation": "前回値と現在値を保持します。切断時に状態をリセットし、無効なボタン番号では false を返します。",
              "follow": "Update と IsReleased、Reset。"
            },
            {
              "label": "GamepadButton.h",
              "path": "Engine/include/input/GamepadButton.h",
              "topic": "配置をもとにしたボタンの名前",
              "explanation": "SOUTHやWESTなどの位置名を定義します。Windows側は GameInput のAやXなどをこの名前へ対応付けます。",
              "follow": "WindowsInputBackend::ReadGamepad の対応表。"
            },
            {
              "label": "GamepadState.h",
              "path": "Engine/include/input/GamepadState.h",
              "topic": "スティックとトリガーの範囲",
              "explanation": "軸は左と下を負、右と上を正として扱います。トリガーは0から1で、ボタンの状態と接続状態もここに入ります。",
              "follow": "Gamepad::Update と GameActionReader の AxisValue。"
            },
            {
              "label": "Gamepad.h",
              "path": "Engine/include/input/Gamepad.h",
              "topic": "接続状態・ボタン・軸を読むAPI",
              "explanation": "接続中のボタンや軸の値を読み、前回からの変化を検出します。スティックのデッドゾーンを設定値として持ちます。",
              "follow": "GetState と ApplyDeadZone。"
            },
            {
              "label": "Gamepad.cpp",
              "path": "Engine/src/input/Gamepad.cpp",
              "topic": "スティックの中心付近の入力を除く",
              "explanation": "スティックの倒れた長さが閾値以下なら0にし、外側では方向を保ったまま強さを補正します。トリガーは0から1に収めます。",
              "follow": "ApplyDeadZone の hypot・strength と Update。"
            }
          ]
        }
      }
    },
