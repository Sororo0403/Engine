        "state": {
          "entries": [
            {
              "label": "WaveData.h",
              "path": "Engine/include/audio/WaveData.h",
              "topic": "非圧縮WAVのデータ表現",
              "explanation": "モノラルやステレオのサンプル、形式、サンプルレートをデバイスと独立して保持します。",
              "follow": "WaveReader が返し AudioClipManager が受け取る。"
            },
            {
              "label": "WaveData.cpp",
              "path": "Engine/src/audio/WaveData.cpp",
              "topic": "サンプルから再生フレーム数を求める",
              "explanation": "形式からサンプルあたりのバイト数を求め、チャンネル数も使ってフレーム数や秒数を計算します。",
              "follow": "GetBytesPerSample → GetFrameCount → GetDurationSeconds。"
            },
            {
              "label": "WaveReader.h",
              "path": "Engine/include/audio/WaveReader.h",
              "topic": "RIFF/WAVEの読み込みAPI",
              "explanation": "非圧縮PCMやIEEE float32をデコードして WaveData に変換します。ファイル読み込みとバイト列からの変換が分かれています。",
              "follow": "Load と Decode の引数を比較。"
            },
            {
              "label": "WaveReader.cpp",
              "path": "Engine/src/audio/WaveReader.cpp",
              "topic": "チャンクを検証してサンプルを読む",
              "explanation": "RIFFの範囲、fmtの形式、データの整合を調べます。ファイルを読む場合はサイズも確認し、条件を満たしたデータを返します。",
              "follow": "Load → Decode の fmt チャンクの処理。"
            },
            {
              "label": "AudioClipHandle.h",
              "path": "Engine/include/audio/AudioClipHandle.h",
              "topic": "読み込んだ音声データの寿命を共有",
              "explanation": "デバイスの終了やキャッシュの解除と別に、クリップのデータを保持できる共有参照です。",
              "follow": "AudioClipManager::Load と AudioSystem::Play。"
            },
            {
              "label": "AudioClipManager.h",
              "path": "Engine/include/audio/AudioClipManager.h",
              "topic": "パスごとにWAVを共有するAPI",
              "explanation": "WAVを読み込んで、正規化済みパスで共有します。クリップは再生デバイスと独立です。",
              "follow": "Create・Load・Reload。"
            },
            {
              "label": "AudioClipManager.cpp",
              "path": "Engine/src/audio/AudioClipManager.cpp",
              "topic": "同じファイルの読み込みを再利用",
              "explanation": "LoadFile がパスでキャッシュを調べ、必要なときだけデータを読みます。Reload は読み込みし直す入口です。",
              "follow": "Load／Reload → LoadFile → WaveReader。"
            },
            {
              "label": "AudioPlaybackHandle.h",
              "path": "Engine/include/audio/AudioPlaybackHandle.h",
              "topic": "1回の再生を識別する",
              "explanation": "停止した再生の参照が後から別の再生を指さないよう、個々の再生を識別する値を持ちます。",
              "follow": "AudioSystem::Play と GetState。"
            },
            {
              "label": "AudioSettings.h",
              "path": "Engine/include/audio/AudioSettings.h",
              "topic": "音の聞き手と発音位置を指定",
              "explanation": "聞き手の向きと位置、音源の位置と距離による減衰、音量とループなどを表します。空間音源にはモノラルを使います。",
              "follow": "AudioListenerPose・AudioEmitterSettings・AudioPlaybackSettings。"
            },
            {
              "label": "AudioSettings.cpp",
              "path": "Engine/src/audio/AudioSettings.cpp",
              "topic": "音源とリスナーの値を検証",
              "explanation": "位置や向き、減衰距離、音量などが計算に使える範囲かを調べます。",
              "follow": "各設定の IsValid と SpatialAudio。"
            },
            {
              "label": "AudioEmitterChange.h",
              "path": "Engine/include/audio/AudioEmitterChange.h",
              "topic": "聞き手と同時に空間音源を更新する値",
              "explanation": "1回の処理で変える音源の情報をまとめます。聞き手の姿勢と同じ更新で確定させるために使います。",
              "follow": "AudioSystem::SetSpatialState の引数。"
            },
            {
              "label": "AudioSystem.h",
              "path": "Engine/include/audio/AudioSystem.h",
              "topic": "音声デバイスと個々の再生を管理",
              "explanation": "開始・停止・一時停止、音量や姿勢の更新を提供します。デコードされた音声データは再生間で共有できます。",
              "follow": "Play・Stop・SetSpatialState。"
            },
            {
              "label": "AudioSystem.cpp",
              "path": "Engine/src/audio/AudioSystem.cpp",
              "topic": "XAudio2の音声再生をフレーム更新",
              "explanation": "クリップをSource Voiceで再生します。再生中はデータを保持し、終了やデバイスの再初期化を扱います。",
              "follow": "Play の CreateSourceVoice。空間音は SetOutputMatrix。"
            },
            {
              "label": "SpatialAudio.h",
              "path": "Engine/src/audio/SpatialAudio.h",
              "topic": "スピーカー配分を計算するAPI",
              "explanation": "聞き手とモノラル音源の位置からスピーカーごとの配分を求めます。結果が全部計算できた場合にだけ出力を置き換えます。",
              "follow": "CanCalculate と Calculate。"
            },
            {
              "label": "SpatialAudio.cpp",
              "path": "Engine/src/audio/SpatialAudio.cpp",
              "topic": "空間音をスピーカー行列にする",
              "explanation": "X3DAudioにスピーカー構成と聞き手・音源を渡して行列を求めます。再生側はその行列を音声出力に使います。",
              "follow": "X3DAudioInitialize → X3DAudioCalculate。"
            },
            {
              "label": "AudioSourceComponent.h",
              "path": "Engine/include/scene/AudioSourceComponent.h",
              "topic": "物体に音源の参照と設定を付ける",
              "explanation": "WAVへの参照と再生の設定を持ち、物体のワールド位置で再生できます。空の参照も未割り当てとして扱えます。",
              "follow": "SceneAudio::Collect と SceneAudioPlayer。"
            },
            {
              "label": "AudioSourceComponent.cpp",
              "path": "Engine/src/scene/AudioSourceComponent.cpp",
              "topic": "音源設定の保存値を検証",
              "explanation": "音声参照や音量、空間音の設定が有効かを確認します。",
              "follow": "IsValid を AudioInspector とシーン読み込み側から追う。"
            },
            {
              "label": "AudioListenerComponent.h",
              "path": "Engine/include/scene/AudioListenerComponent.h",
              "topic": "物体を音の聞き手にする",
              "explanation": "物体のワールド位置と向きをリスナーとして使います。有効なリスナーの選択はシーン側が扱います。",
              "follow": "SceneAudio::Collect でリスナーを選ぶ箇所。"
            },
            {
              "label": "AudioInspector.h",
              "path": "Editor/include/audio/AudioInspector.h",
              "topic": "音源とリスナーの編集画面",
              "explanation": "音声の割り当て、再生設定、追加・削除を編集履歴に接続するUIです。",
              "follow": "Draw と GetRevealRequest。"
            },
            {
              "label": "AudioInspector.cpp",
              "path": "Editor/src/audio/AudioInspector.cpp",
              "topic": "割り当て前に空間音の条件を確認",
              "explanation": "WAVの参照や空間配置時のモノラル条件を調べ、編集は履歴へ渡します。",
              "follow": "割り当ての検証と Draw。"
            },
            {
              "label": "AudioPreview.h",
              "path": "Editor/include/audio/AudioPreview.h",
              "topic": "シーンと別の試聴を制御するAPI",
              "explanation": "プレビュー用に1件の再生を管理し、停止や解放を個別に行います。",
              "follow": "Load・Play・GetPositionSeconds・Clear。"
            },
            {
              "label": "AudioPreview.cpp",
              "path": "Editor/src/audio/AudioPreview.cpp",
              "topic": "選択したWAVを試聴する",
              "explanation": "クリップを読み込んで再生し、再生済みのフレームから位置を秒で表示できます。停止の対象は自身の試聴です。",
              "follow": "Play と GetPositionSeconds、Stop。"
            }
          ]
        }
      }
    },
