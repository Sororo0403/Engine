        "state": {
          "entries": [
            {
              "label": "CameraPose.h",
              "path": "Engine/include/graphics/camera/CameraPose.h",
              "topic": "カメラのワールド上の姿勢",
              "explanation": "位置と注視点、上方向を保持します。ビュー行列を作るために使います。",
              "follow": "Camera::SetPose と SceneCameraUtils::FromTransform。"
            },
            {
              "label": "CameraSettings.h",
              "path": "Engine/include/graphics/camera/CameraSettings.h",
              "topic": "縦視野角と描画距離の設定",
              "explanation": "透視投影の縦視野角と、手前・奥のクリップ距離を持ちます。",
              "follow": "Camera::Update が投影行列を作る部分。"
            },
            {
              "label": "Camera.h",
              "path": "Engine/include/graphics/camera/Camera.h",
              "topic": "ビューと投影、画面からのレイを提供",
              "explanation": "姿勢と投影設定を保持し、描画行列やクリック位置からのレイを取得できます。",
              "follow": "GetViewMatrix・GetProjectionMatrix・CreatePickingRay。"
            },
            {
              "label": "Camera.cpp",
              "path": "Engine/src/graphics/camera/Camera.cpp",
              "topic": "姿勢と画面寸法から行列を作る",
              "explanation": "Update でビュー・投影を計算します。CreatePickingRay は画像上の位置からワールド空間のレイを作ります。",
              "follow": "Update → CreatePickingRay で行列の使い方を比較。"
            },
            {
              "label": "ShadowCamera.h",
              "path": "Engine/include/graphics/camera/ShadowCamera.h",
              "topic": "光源から見た行列を構築するAPI",
              "explanation": "描画カメラの前方を覆う平行光の行列を作ります。影の画素単位に位置をそろえる処理も含みます。",
              "follow": "Build の入力と光源ビュー投影の出力。"
            },
            {
              "label": "ShadowCamera.cpp",
              "path": "Engine/src/graphics/camera/ShadowCamera.cpp",
              "topic": "影の見える範囲と位置を決める",
              "explanation": "カメラ前方の範囲を光源の座標でとらえ、影のテクスチャの画素に合うよう位置を調整します。",
              "follow": "Build の範囲計算と画素位置の丸め。"
            },
            {
              "label": "DockDirection.h",
              "path": "Engine/include/graphics/ui/DockDirection.h",
              "topic": "UIの分割方向の共通表現",
              "explanation": "ドッキング領域の左・右・上・下を指定する列挙値です。",
              "follow": "ImGuiSystem::SplitDockNode で対応する方向へ変換。"
            },
            {
              "label": "ViewportInput.h",
              "path": "Engine/include/graphics/ui/ViewportInput.h",
              "topic": "画像上の操作を受け取る型",
              "explanation": "正規化した画像内の位置と、マウスのボタン、ホイール、フォーカスをまとめます。",
              "follow": "ImGuiSystem::GetViewportInput → Sceneビューの操作。"
            },
            {
              "label": "ImGuiSystem.h",
              "path": "Engine/include/graphics/ui/ImGuiSystem.h",
              "topic": "Dear ImGuiとの接続をまとめるAPI",
              "explanation": "EditorのUI用にフレーム、描画、ドッキング、入力、描画した画像の表示を公開します。",
              "follow": "BeginFrame・Image・Render。"
            },
            {
              "label": "ImGuiSystem.cpp",
              "path": "Engine/src/graphics/ui/ImGuiSystem.cpp",
              "topic": "Win32とD3D12のDear ImGuiを初期化",
              "explanation": "入力や描画のバックエンドをつなぎ、作成したUIを描画します。別途描画したテクスチャも画像として表示できます。",
              "follow": "Initialize の Win32／D3D12 バックエンド、Image と Render。"
            }
          ]
        }
      }
    },
