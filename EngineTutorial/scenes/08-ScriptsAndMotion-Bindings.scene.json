        "state": {
          "entries": [
            {
              "label": "LuaBindings.h",
              "path": "Engine/src/scripting/LuaBindings.h",
              "topic": "保護呼び出し内の一時参照と共通API",
              "explanation": "呼び出し中だけ存在する対象や候補シーンへの参照をまとめます。分野別のLuaメソッドの登録関数も宣言します。",
              "follow": "Call と AddUIMethods などの登録API。"
            },
            {
              "label": "LuaBindings.cpp",
              "path": "Engine/src/scripting/LuaBindings.cpp",
              "topic": "Luaに見せる標準関数と物体APIを作る",
              "explanation": "許可した関数を環境へ用意し、物体をIDの分かる userdata にします。C++の物体メモリをLuaへ直接渡しません。",
              "follow": "OpenEnvironment・PushObject・物体の比較処理。"
            },
            {
              "label": "LuaAnimationBindings.cpp",
              "path": "Engine/src/scripting/LuaAnimationBindings.cpp",
              "topic": "シーン変形アニメーションをLuaから操作",
              "explanation": "Transform Animation の再生・停止・シークなどを、実行中のアニメーション状態に対する操作へつなぎます。",
              "follow": "AddAnimationMethods と引数を検証する処理。"
            },
            {
              "label": "LuaAnimatorBindings.cpp",
              "path": "Engine/src/scripting/LuaAnimatorBindings.cpp",
              "topic": "モデルのクリップをLuaから切り替える",
              "explanation": "モデル用のAnimatorからクリップの状態を読み、指定したクリップの再生・停止などへ接続します。",
              "follow": "AddAnimatorMethods → Animatorの操作。"
            },
            {
              "label": "LuaAudioBindings.cpp",
              "path": "Engine/src/scripting/LuaAudioBindings.cpp",
              "topic": "音源の再生や音量をLuaから操作",
              "explanation": "音声の再生と停止の要求を発行し、Audio Sourceの音量を読み書きできます。",
              "follow": "AddAudioMethods と音声要求の生成。"
            },
            {
              "label": "LuaMessageBindings.cpp",
              "path": "Engine/src/scripting/LuaMessageBindings.cpp",
              "topic": "物体へ次の更新用の通知を送る",
              "explanation": "Luaの名前やデータを検証・複製し、通知キューに追加します。",
              "follow": "AddMessageMethods の send_message → ScriptMailbox。"
            },
            {
              "label": "LuaParticleBindings.cpp",
              "path": "Engine/src/scripting/LuaParticleBindings.cpp",
              "topic": "発生・停止・消去をLuaから指定",
              "explanation": "作業中の粒子状態から値を取得し、発生元の操作や粒子の消去を要求できます。",
              "follow": "AddParticleMethods と SceneParticles の操作。"
            },
            {
              "label": "LuaPhysicsBindings.cpp",
              "path": "Engine/src/scripting/LuaPhysicsBindings.cpp",
              "topic": "剛体速度や力積をLuaから操作",
              "explanation": "引数を検証し、候補側の剛体状態を読み書きします。C++の操作で起きたエラーはLuaへ返します。",
              "follow": "AddPhysicsMethods と力積・速度の処理。"
            },
            {
              "label": "LuaPrefabBindings.cpp",
              "path": "Engine/src/scripting/LuaPrefabBindings.cpp",
              "topic": "名前付きPrefabから物体を生成する",
              "explanation": "Luaに渡した割り当て名と位置を使ってPrefabを生成し、新しい物体のルート参照を返します。",
              "follow": "AddPrefabMethods の instantiate。"
            },
            {
              "label": "LuaRaycastBindings.cpp",
              "path": "Engine/src/scripting/LuaRaycastBindings.cpp",
              "topic": "現在のColliderをLuaから調べる",
              "explanation": "レイや球、Colliderのキャストと球の重なり検索を公開します。問い合わせ回数や返す件数に制約を設けます。",
              "follow": "AddSpatialQueryMethods の raycast・cast_sphere・overlap_sphere。"
            },
            {
              "label": "LuaSceneBindings.cpp",
              "path": "Engine/src/scripting/LuaSceneBindings.cpp",
              "topic": "シーンを割り当て名で遷移させる",
              "explanation": "スクリプトの名前付きシーン参照を解決し、次回更新で遷移できるよう要求を作ります。",
              "follow": "AddSceneMethods の load_scene と参照の解決。"
            },
            {
              "label": "LuaUIBindings.cpp",
              "path": "Engine/src/scripting/LuaUIBindings.cpp",
              "topic": "UIの文字や色をLuaから更新",
              "explanation": "文字・矩形・UIの色などを取得・変更するメソッドを登録します。この教材も文字の表示を切り替えるために使います。",
              "follow": "AddUIMethods と Lua引数からUIを変更する処理。"
            }
          ]
        }
      }
    },
