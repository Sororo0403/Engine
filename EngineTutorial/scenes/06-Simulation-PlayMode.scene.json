          "entries": [
            {
              "label": "EditorPlayAction.h",
              "path": "Editor/include/gameplay/EditorPlayAction.h",
              "topic": "試遊操作を画面から返す列挙型",
              "explanation": "Gameパネルやショートカットの意図を共通の再生操作として表します。",
              "follow": "EditorPlayMode::DrawUI と PlayShortcuts。"
            },
            {
              "label": "PlayShortcuts.h",
              "path": "Editor/include/gameplay/PlayShortcuts.h",
              "topic": "ショートカットを押した瞬間に反応する",
              "explanation": "共通キーボードの押下エッジから再生操作を得ます。修飾キーと同時に押した場合は受け付けません。",
              "follow": "キーの条件と EditorPlayAction。"
            },
            {
              "label": "PlaybackClock.h",
              "path": "Editor/include/gameplay/PlaybackClock.h",
              "topic": "試遊で経過するゲーム時間を管理",
              "explanation": "通常の時間に倍率を掛けます。一時停止中のステップは倍率にかかわらず1/60秒を進めます。",
              "follow": "EditorPlaySession::Update から時計をたどる。"
            },
            {
              "label": "GameplayInput.h",
              "path": "Editor/include/gameplay/GameplayInput.h",
              "topic": "Game画像が入力を受け取れるかを判断",
              "explanation": "Gameが操作できる時だけ移動やジャンプを読みます。旋回に使うマウス入力は画像上にある場合に限ります。",
              "follow": "Read 側の入力許可と OrbitCameraInputReader。"
            },
            {
              "label": "EditorPlaySession.h",
              "path": "Editor/include/gameplay/EditorPlaySession.h",
              "topic": "試遊の開始時データとセッション",
              "explanation": "開始時データを保持し、再生の開始・停止・再実行や一時停止を管理します。",
              "follow": "Start・Restart・Stop・RequestStep。"
            },
            {
              "label": "EditorPlaySession.cpp",
              "path": "Editor/src/gameplay/EditorPlaySession.cpp",
              "topic": "試遊の時間を進め、接触イベントを記録",
              "explanation": "Update でセッションの時間を進め、シミュレーションを更新します。発生したTriggerイベントは検証用に保持します。",
              "follow": "Update と RememberTriggerEvents。"
            },
            {
              "label": "EditorPlayMode.h",
              "path": "Editor/include/gameplay/EditorPlayMode.h",
              "topic": "Gameパネルの描画・入力と試遊をつなぐ",
              "explanation": "試遊セッションの制御に加え、画面の表示や入力を扱います。編集時のプレビューも用意します。",
              "follow": "DrawUI・Update・UpdatePreview。"
            },
            {
              "label": "EditorPlayMode.cpp",
              "path": "Editor/src/gameplay/EditorPlayMode.cpp",
              "topic": "Gameパネルと実行シーンのやり取り",
              "explanation": "UIから試遊の操作を受け、入力を実行シーンへ渡します。開始と停止に応じて表示や描画側も更新します。",
              "follow": "DrawUI → Start／Stop。フレームごとの処理は Update。"
            },
            {
              "label": "EditorGamePreview.h",
              "path": "Editor/include/gameplay/EditorGamePreview.h",
              "topic": "再生する前のGameビューを準備",
              "explanation": "編集シーンの開始時の表示を得るAPIです。物理演算を進めずに見え方を確認できます。",
              "follow": "Prepare と Reset。"
            },
            {
              "label": "EditorGamePreview.cpp",
              "path": "Editor/src/gameplay/EditorGamePreview.cpp",
              "topic": "編集データから開始時の描画状態を作る",
              "explanation": "Prepare が開始時の姿勢やカメラを解決し、プレビュー用の状態を準備します。",
              "follow": "Prepare で開始状態を組み立てる処理。"
            },
            {
              "label": "GameplayInspector.h",
              "path": "Editor/include/gameplay/GameplayInspector.h",
              "topic": "移動・追従・復帰の設定画面",
              "explanation": "コンポーネントを編集し、追従先や復帰位置、ジャンプ範囲へ移動する要求を返せます。",
              "follow": "Draw と GetJumpFrameRequest／GetFollowRequest。"
            },
            {
              "label": "GameplayInspector.cpp",
              "path": "Editor/src/gameplay/GameplayInspector.cpp",
              "topic": "連続入力を履歴にまとめる",
              "explanation": "移動などの設定を編集します。ジャンプ予測を開くと、移動処理を使った方向別の予測を表示します。",
              "follow": "Draw の設定編集とジャンプ予測。"
            },
            {
              "label": "MotionPathInspector.h",
              "path": "Editor/include/gameplay/MotionPathInspector.h",
              "topic": "経路の編集を履歴へ渡すAPI",
              "explanation": "点、区間時間、再生方式を編集します。連続操作や履歴を通して値を変えられます。",
              "follow": "Draw と DrawReadOnly。"
            },
            {
              "label": "MotionPathInspector.cpp",
              "path": "Editor/src/gameplay/MotionPathInspector.cpp",
              "topic": "経路を編集して変更を確定する",
              "explanation": "経路設定を入力し、履歴を通してシーンへ反映します。読み取り専用の表示も別に提供します。",
              "follow": "Draw の設定変更と DrawReadOnly。"
            },
            {
              "label": "ScriptInspector.h",
              "path": "Editor/include/gameplay/ScriptInspector.h",
              "topic": "Lua割り当てと名前付き参照の編集UI",
              "explanation": "物体に割り当てるLuaや初期状態、他物体への名前付き参照を編集します。",
              "follow": "Draw と DrawReadOnly。"
            },
            {
              "label": "ScriptInspector.cpp",
              "path": "Editor/src/gameplay/ScriptInspector.cpp",
              "topic": "スクリプト設定をInspectorで変更する",
              "explanation": "Luaスクリプトの割り当てと参照の設定を表示し、変更を編集履歴へ渡します。読み取り専用の表示も持ちます。",
              "follow": "Draw の EditorHistory::SetScript と DrawReadOnly。"
            },
            {
              "label": "TriggerActionsInspector.h",
              "path": "Editor/include/gameplay/TriggerActionsInspector.h",
              "topic": "操作一覧の順序・条件・対象の編集",
              "explanation": "Trigger Actions の操作を並べ、条件や対象をInspectorで変更する入口です。",
              "follow": "Draw と DrawReadOnly の引数。"
            },
            {
              "label": "TriggerActionsInspector.cpp",
              "path": "Editor/src/gameplay/TriggerActionsInspector.cpp",
              "topic": "命令を選び、編集履歴へ渡す",
              "explanation": "操作種別や接触条件の表示を作ります。選んだ条件や操作順などの変更を履歴を通して適用します。",
              "follow": "Draw の選択と変更確定の経路。"
            },
            {
              "label": "FollowTargetPicker.h",
              "path": "Editor/include/gameplay/FollowTargetPicker.h",
              "topic": "名前やIDで追従先を選ぶ",
              "explanation": "物体の候補を検索し、選択した物体のIDを返します。",
              "follow": "Draw の optional の戻り値。"
            },
            {
              "label": "FollowTargetPicker.cpp",
              "path": "Editor/src/gameplay/FollowTargetPicker.cpp",
              "topic": "名前とIDの部分一致で候補を選ぶ",
              "explanation": "ASCII英字の大文字・小文字の違いを除いて比較し、選んだIDを返します。",
              "follow": "Draw の候補判定。"
            },
            {
              "label": "FollowCameraUsage.h",
              "path": "Editor/include/gameplay/FollowCameraUsage.h",
              "topic": "追従先から利用するカメラを探す",
              "explanation": "指定物体を直接追従するカメラを、非表示や未完成のものも含めて検索します。",
              "follow": "FindObjects の検索結果を SelectObjects で使う。"
            },
            {
              "label": "FollowCameraUsage.cpp",
              "path": "Editor/src/gameplay/FollowCameraUsage.cpp",
              "topic": "利用する追従カメラをまとめて選ぶ",
              "explanation": "追従対象が一致するカメラを集め、選択へ反映します。現在のアクティブ物体が結果にあれば維持します。",
              "follow": "SelectObjects と追従対象の照合。"
            },
            {
              "label": "FollowCameraPreview.h",
              "path": "Editor/include/gameplay/FollowCameraPreview.h",
              "topic": "追従開始時の視点を図で確認",
              "explanation": "追従先、開始時のカメラ位置、注視点や壁回避の余裕幅をSceneビューに表示します。",
              "follow": "BuildLines と GetFrameBounds。"
            },
            {
              "label": "FollowCameraPreview.cpp",
              "path": "Editor/src/gameplay/FollowCameraPreview.cpp",
              "topic": "カメラと追従先の関係を線にする",
              "explanation": "開始姿勢をもとにした補助線や表示範囲を用意します。Update で SceneRenderer に渡します。",
              "follow": "BuildLines → Update。"
            },
            {
              "label": "RespawnPreview.h",
              "path": "Editor/include/gameplay/RespawnPreview.h",
              "topic": "落下する高さと復帰先を表示",
              "explanation": "復帰位置と判定高度をSceneビューに描くためのAPIです。復帰を妨げる物体も確認できます。",
              "follow": "BuildLines・GetColliderBounds・FindBlockingObjects。"
            },
            {
              "label": "RespawnPreview.cpp",
              "path": "Editor/src/gameplay/RespawnPreview.cpp",
              "topic": "復帰位置にColliderを置いた範囲を求める",
              "explanation": "復帰先でのワールド形状を計算し、補助表示や妨げになる物体の確認に使います。",
              "follow": "BuildGeometry と FindBlockingObjects。"
            },
            {
              "label": "CharacterJumpPreview.h",
              "path": "Editor/include/gameplay/CharacterJumpPreview.h",
              "topic": "ジャンプを実行前に予測するAPI",
              "explanation": "実際に使う移動と衝突の処理で、選択した主人公のジャンプ軌跡を求めて表示します。",
              "follow": "BuildPaths・GetFrameBounds・Update。"
            },
            {
              "label": "CharacterJumpPreview.cpp",
              "path": "Editor/src/gameplay/CharacterJumpPreview.cpp",
              "topic": "予測した移動をSceneビューへ描く",
              "explanation": "試算したジャンプの軌跡を組み立て、範囲へのフォーカスや補助線の描画に使います。",
              "follow": "BuildPaths → GetFrameBounds／Update。"
            },
            {
              "label": "CharacterMotionTrail.h",
              "path": "Editor/include/gameplay/CharacterMotionTrail.h",
              "topic": "試遊中に動いた道筋を保持",
              "explanation": "主人公の原点をフレームごとに記録し、Sceneビューで動いた軌跡を確認できるようにします。",
              "follow": "Record と GetLineCount。"
            },
            {
              "label": "CharacterMotionTrail.cpp",
              "path": "Editor/src/gameplay/CharacterMotionTrail.cpp",
              "topic": "通った点を記録して線でつなぐ",
              "explanation": "試遊中の状態を読み取り、保存した位置から軌跡の線を作ります。表示範囲の計算にも使えます。",
              "follow": "Record → Update。境界は GetFrameBounds。"
            },
            {
              "label": "SampleStage.h",
              "path": "Editor/include/gameplay/SampleStage.h",
              "topic": "標準コンポーネントで組む試遊例",
              "explanation": "床・壁・主人公・カメラ・平行光を編集可能なシーンとして用意します。",
              "follow": "サンプル構築の宣言と SampleStage.cpp。"
            },
            {
              "label": "SampleStage.cpp",
              "path": "Editor/src/gameplay/SampleStage.cpp",
              "topic": "床・壁と主人公の設定を組み立てる",
              "explanation": "見た目と衝突形状を配置し、移動や復帰、カメラをコンポーネントで設定します。",
              "follow": "床・壁の作成から主人公のCharacterと復帰設定を追う。"
            }
          ]
        }
      }
