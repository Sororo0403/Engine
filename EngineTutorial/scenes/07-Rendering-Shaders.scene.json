        "state": {
          "entries": [
            {
              "label": "DebugLine.hlsli",
              "path": "Engine/resources/shaders/debug/DebugLine.hlsli",
              "topic": "線のシェーダー間の出力",
              "explanation": "頂点処理からピクセル処理へ投影後の位置と色を受け渡す型を定義します。",
              "follow": "DebugLineOutput を VS と PS で確認。"
            },
            {
              "label": "DebugLine.VS.hlsl",
              "path": "Engine/resources/shaders/debug/DebugLine.VS.hlsl",
              "topic": "線の端点をカメラで投影する",
              "explanation": "ワールド座標の線の頂点をカメラ行列で変換し、色を渡します。",
              "follow": "VSMain の行列との積と DebugLineOutput。"
            },
            {
              "label": "DebugLine.PS.hlsl",
              "path": "Engine/resources/shaders/debug/DebugLine.PS.hlsl",
              "topic": "受け取った線の色を返す",
              "explanation": "頂点側から受け取った色をピクセルの出力色にします。",
              "follow": "PSMain の return input.color。"
            },
            {
              "label": "Mesh.hlsli",
              "path": "Engine/resources/shaders/mesh/Mesh.hlsli",
              "topic": "メッシュの頂点出力を共有",
              "explanation": "画面に置く位置に加えて、テクスチャ座標やワールド位置・法線をピクセル側へ渡す型です。",
              "follow": "VertexOutput と Mesh.VS.hlsl／Mesh.PS.hlsl。"
            },
            {
              "label": "Mesh.VS.hlsl",
              "path": "Engine/resources/shaders/mesh/Mesh.VS.hlsl",
              "topic": "頂点を投影しワールド位置も渡す",
              "explanation": "頂点を worldViewProjection で変換し、照明に使うワールド位置と法線も計算します。",
              "follow": "VSMain の position・worldPosition・normal の出力。"
            },
            {
              "label": "Mesh.PS.hlsl",
              "path": "Engine/resources/shaders/mesh/Mesh.PS.hlsl",
              "topic": "テクスチャ・照明・影から色を求める",
              "explanation": "テクスチャや材質に照明を適用します。影は深度の比較で求め、霧などの効果も反映します。",
              "follow": "影の SampleCmpLevelZero と、PSMain の拡散光の saturate。"
            },
            {
              "label": "Shadow.VS.hlsl",
              "path": "Engine/resources/shaders/mesh/Shadow.VS.hlsl",
              "topic": "光源から見た深度を描く",
              "explanation": "頂点をモデルのワールド行列で変換してから光源のビュー投影行列で変換します。",
              "follow": "VSMain の world と shadowViewProjection。"
            },
            {
              "label": "Skinning.hlsli",
              "path": "Engine/resources/shaders/mesh/Skinning.hlsli",
              "topic": "ボーンの重みで頂点と法線を変形",
              "explanation": "最大8個の重み付き変換を合成します。重みがなければ末尾の所属ノード用変換を使います。",
              "follow": "SkinVertex のループと total == 0 の分岐。"
            },
            {
              "label": "SkinnedMesh.VS.hlsl",
              "path": "Engine/resources/shaders/mesh/SkinnedMesh.VS.hlsl",
              "topic": "ボーン変形したモデルを画面へ投影",
              "explanation": "SkinVertex で変形した位置と法線を描画用に変換し、通常のメッシュと共通の出力型で渡します。",
              "follow": "VSMain の SkinVertex と VertexOutput。"
            },
            {
              "label": "SkinnedShadow.VS.hlsl",
              "path": "Engine/resources/shaders/mesh/SkinnedShadow.VS.hlsl",
              "topic": "ボーン変形後のモデルから影を描く",
              "explanation": "ボーンによる頂点変形を行い、光源ビュー投影へ変換します。曲がったポーズでも影が形に沿います。",
              "follow": "SkinVertex → world → shadowViewProjection。"
            },
            {
              "label": "Particle.VS.hlsl",
              "path": "Engine/resources/shaders/particles/Particle.VS.hlsl",
              "topic": "粒子をカメラに向く四角形にする",
              "explanation": "頂点番号と粒子のサイズを使い、カメラに向く面の頂点を生成します。",
              "follow": "main の SV_VertexID とカメラの軸の使い方。"
            },
            {
              "label": "Particle.PS.hlsl",
              "path": "Engine/resources/shaders/particles/Particle.PS.hlsl",
              "topic": "粒子の画像と色を合成する",
              "explanation": "画像に粒子の色を掛けます。円形の場合はUVの中心からの距離に応じて透明度を落とします。",
              "follow": "main の circle と smoothstep。"
            },
            {
              "label": "Canvas.VS.hlsl",
              "path": "Engine/resources/shaders/ui/Canvas.VS.hlsl",
              "topic": "UIの矩形を頂点番号から生成",
              "explanation": "UIの位置と軸を使って矩形を組み立て、画像上の参照座標を渡します。",
              "follow": "main の SV_VertexID と uvRect。"
            },
            {
              "label": "Canvas.PS.hlsl",
              "path": "Engine/resources/shaders/ui/Canvas.PS.hlsl",
              "topic": "UI画像の色と明暗効果を反映",
              "explanation": "画像に色と透明度を掛けます。白黒効果が有効なときは輝度を求めて指定した明暗の範囲へ変換します。",
              "follow": "main の image.Sample と luminance。"
            }
          ]
        }
      }
    },
