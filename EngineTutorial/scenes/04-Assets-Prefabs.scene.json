          "entries": [
            {
              "label": "SceneDependencyGraph.h",
              "path": "Editor/include/assets/SceneDependencyGraph.h",
              "topic": "シーンとPrefabの依存関係",
              "explanation": "Load SceneやスクリプトのPrefab参照をたどるためのAPIです。循環や重複があっても同じファイルを繰り返し列挙しません。",
              "follow": "Read の Entry と依存関係の種類。"
            },
            {
              "label": "SceneDependencyGraph.cpp",
              "path": "Editor/src/assets/SceneDependencyGraph.cpp",
              "topic": "ひとつのシーンから到達するデータを収集",
              "explanation": "シーン遷移先とPrefab参照を探索し、見つかった参照を出力や検査で使える一覧にします。",
              "follow": "Read で経路を列挙し、訪問済みの対象を処理する箇所。"
            },
            {
              "label": "PrefabAsset.h",
              "path": "Editor/include/assets/PrefabAsset.h",
              "topic": "Prefabを保存・配置するEditorのAPI",
              "explanation": "ルート物体と子孫を捕捉し、Prefabとして保存するか、シーン内の新しい物体の組として配置できます。",
              "follow": "Capture・Save・Instantiate。"
            },
            {
              "label": "PrefabAsset.cpp",
              "path": "Editor/src/assets/PrefabAsset.cpp",
              "topic": "選択した階層をPrefabデータへ変える",
              "explanation": "物体の階層を別のシーンデータにまとめ、Prefab形式の読み書きを呼びます。配置用のAPIもここにあります。",
              "follow": "Capture → Serialize。配置側は Instantiate。"
            },
            {
              "label": "PrefabInstances.h",
              "path": "Editor/include/assets/PrefabInstances.h",
              "topic": "個別編集を残したPrefab更新のAPI",
              "explanation": "Prefabの元アセット、元ID、基準値を使い、更新やリンク解除を履歴付きで扱います。",
              "follow": "Refresh・Unpack・SaveToAsset。"
            },
            {
              "label": "PrefabInstances.cpp",
              "path": "Editor/src/assets/PrefabInstances.cpp",
              "topic": "基準値・現在値・最新版を比較する",
              "explanation": "現在値が基準のままなら最新版を採用し、個別に編集した値は残します。物体参照も元IDと実体IDの対応に従って変換します。",
              "follow": "Mapped と Merge。UIの操作は Refresh などから入る。"
            },
            {
              "label": "PrefabLinkComponent.h",
              "path": "Engine/include/scene/PrefabLinkComponent.h",
              "topic": "アセット元のIDと実体の対応表",
              "explanation": "基準値やID対応を保持し、Prefabインスタンスが元アセットとどう対応するかを表します。",
              "follow": "IsValid と GetInstance。"
            },
            {
              "label": "PrefabInspector.h",
              "path": "Editor/include/prefab/PrefabInspector.h",
              "topic": "Prefabの確認と操作要求のUI",
              "explanation": "Prefabの参照先を表示し、更新・保存・解除などの処理を別の箇所へ要求します。",
              "follow": "Draw の戻り値と操作内容。"
            },
            {
              "label": "PrefabInspector.cpp",
              "path": "Editor/src/prefab/PrefabInspector.cpp",
              "topic": "画面のボタンをPrefab編集要求に変換",
              "explanation": "Prefabとの対応をInspectorに表示します。項目を選んだときは操作の要求を返し、実際の編集側へ渡せます。",
              "follow": "Draw の更新・解除要求 → EditorScene。"
            },
            {
              "label": "ScenePrefabs.h",
              "path": "Engine/include/gameplay/ScenePrefabs.h",
              "topic": "試遊中のPrefab読み込みを管理",
              "explanation": "シーンから参照されるPrefabを扱い、取得したシーンを再利用できるAPIを持ちます。",
              "follow": "Configure と GetScenes。"
            },
            {
              "label": "ScenePrefabs.cpp",
              "path": "Engine/src/gameplay/ScenePrefabs.cpp",
              "topic": "実行中の生成に使うPrefabを準備",
              "explanation": "シーンに登録されたPrefab参照を読み、設定に従って既存の内容を保ちながら更新します。",
              "follow": "Configure の preserve 分岐と GetScenes。"
            }
          ]
        }
      }
    },
