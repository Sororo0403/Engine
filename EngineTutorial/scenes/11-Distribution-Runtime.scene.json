          "entries": [
            {
              "label": "GameExporter.h",
              "path": "Editor/include/export/GameExporter.h",
              "topic": "ゲーム出力と事前検査のAPI",
              "explanation": "書き出し設定に基づいて実際に出力する関数と、事前にまとめて確認する関数を公開します。",
              "follow": "Check と Export、CheckSummary。"
            },
            {
              "label": "GameExporter.cpp",
              "path": "Editor/src/export/GameExporter.cpp",
              "topic": "配布するファイルと参照を組み立てる",
              "explanation": "Release x64などを検査し、シーン遷移や素材を集めます。Runtime.exe を Game.exe としてコピーし、配布に合わせた設定を書きます。",
              "follow": "ValidateRuntimeBuild → Check／Export と CopyPlan。"
            },
            {
              "label": "OutputDirectory.h",
              "path": "Editor/include/files/OutputDirectory.h",
              "topic": "新しく出力するフォルダの操作",
              "explanation": "フォルダ、ファイルのコピー、テキストの作成、成功時の確定、失敗時の片付けを扱います。",
              "follow": "Create・Complete・Cleanup。"
            },
            {
              "label": "OutputDirectory.cpp",
              "path": "Editor/src/files/OutputDirectory.cpp",
              "topic": "失敗時に今回の出力だけを片付ける",
              "explanation": "作ったファイルの識別情報を保持します。片付けのときに同じ作成物か確認し、すでに置き換わったファイルの削除を避けます。",
              "follow": "Create・Copy と Cleanup の識別情報確認。"
            },
            {
              "label": "GameConfig.h",
              "path": "Engine/include/gameplay/GameConfig.h",
              "topic": "配布ゲームの起動条件を定義する",
              "explanation": "タイトル、サイズ、起動シーン、ゲーム操作などを保持します。スクリプトの設定を保存する場所に関わるAPIも持ちます。",
              "follow": "Load・GetScriptSettingsPath。"
            },
            {
              "label": "GameConfig.cpp",
              "path": "Engine/src/gameplay/GameConfig.cpp",
              "topic": "game.jsonとセーブ設定の形式を扱う",
              "explanation": "設定を検証して読み書きします。実行中のスクリプトが使う設定は別のファイルから読み込めます。",
              "follow": "Deserialize・LoadScriptSettings。"
            },
            {
              "label": "main.cpp",
              "path": "Runtime/src/main.cpp",
              "topic": "配布先からゲーム設定を読み込む",
              "explanation": "実行ファイルの隣にある game.json を読み、ウィンドウ設定を作って Engine::Run を呼びます。起動引数で保存モードも選びます。",
              "follow": "WinMain の executableDirectory と SaveMode。"
            },
            {
              "label": "RuntimeScene.h",
              "path": "Runtime/include/scene/RuntimeScene.h",
              "topic": "配布ゲーム側でISceneを実装する",
              "explanation": "更新・描画・終了を提供し、実行中のシーンや入力を管理します。通常起動、Editor試遊、セーブなしを分けられます。",
              "follow": "SaveMode と Initialize・Update・Draw・Finalize。"
            },
            {
              "label": "RuntimeScene.cpp",
              "path": "Runtime/src/scene/RuntimeScene.cpp",
              "topic": "起動シーンとセーブを読み、ゲームを進める",
              "explanation": "初期化で起動シーンを用意し、更新で入力を実行中のシーンへ渡します。通常起動とEditor試遊の保存を分け、セーブなしでは保存先を設定しません。",
              "follow": "Initialize → Update → SaveScriptSettings。"
            }
          ]
        }
      }
