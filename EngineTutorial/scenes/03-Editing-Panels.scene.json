          "entries": [
            {
              "label": "HierarchyPanel.h",
              "path": "Editor/include/panels/HierarchyPanel.h",
              "topic": "Hierarchyが扱うUI状態と操作要求",
              "explanation": "物体ツリーの検索や選択を管理します。各フレームの操作は Result で返し、別の処理へ渡せます。",
              "follow": "Draw の引数にある Scene と EditorSelection、戻り値 Result。"
            },
            {
              "label": "HierarchyPanel.cpp",
              "path": "Editor/src/panels/HierarchyPanel.cpp",
              "topic": "見えている物体を選ぶ",
              "explanation": "フィルターを通過した項目を使って一括選択やキー移動を行います。ドラッグやクリックから物体操作の要求も作ります。",
              "follow": "SelectAllVisible・NavigateSelection・SelectObject。"
            },
            {
              "label": "HierarchyFilter.h",
              "path": "Editor/include/panels/HierarchyFilter.h",
              "topic": "名前やタグ以外を使った絞り込み",
              "explanation": "名前・タグ・ID・表示などの条件に加え、物体が持つコンポーネントも条件にできます。",
              "follow": "Matches の引数から照合の実装を読む。"
            },
            {
              "label": "HierarchyFilter.cpp",
              "path": "Editor/src/panels/HierarchyFilter.cpp",
              "topic": "物体データと検索条件を照合",
              "explanation": "Matches でIDやタグなどを確認し、指定された属性やコンポーネントが合うかを判定します。",
              "follow": "Matches と Clear。視覚上の表示は HierarchyPanel。"
            },
            {
              "label": "InspectorPanel.h",
              "path": "Editor/include/panels/InspectorPanel.h",
              "topic": "表示する物体と編集要求を管理",
              "explanation": "選択中の物体に追従するほか、物体を固定して確認できます。素材を表示する要求やモデル選択などの要求を公開します。",
              "follow": "RequestInspect と ObjectRequest・ModelRequest。"
            },
            {
              "label": "InspectorPanel.cpp",
              "path": "Editor/src/panels/InspectorPanel.cpp",
              "topic": "コンポーネントごとのUIへ渡す",
              "explanation": "Draw は対象物体を選び、Collider・Camera・UIなどの専用Inspectorに処理を渡します。読み取り用の表示は DrawReadOnly にあります。",
              "follow": "Draw 内の各 Inspector 呼び出しと EditorHistory。"
            },
            {
              "label": "SceneViewPanel.h",
              "path": "Editor/include/panels/SceneViewPanel.h",
              "topic": "Scene画像と入力領域を管理",
              "explanation": "Sceneを映すテクスチャを持ち、画像上のギズモ・選択・アセットドロップの情報を呼び出し側に渡します。",
              "follow": "DrawUI・DrawGizmo・GetRenderTexture。"
            },
            {
              "label": "SceneViewPanel.cpp",
              "path": "Editor/src/panels/SceneViewPanel.cpp",
              "topic": "ウィンドウの大きさを描画先に反映",
              "explanation": "DrawUI は表示領域に合わせて RenderTexture を作成・リサイズします。ギズモには画像の矩形を渡し、ポインター位置と表示を対応させます。",
              "follow": "DrawUI の CreateRenderTexture／Resize と DrawGizmo。"
            },
            {
              "label": "AssetsPanel.h",
              "path": "Editor/include/panels/AssetsPanel.h",
              "topic": "素材を探して操作するUIの窓口",
              "explanation": "素材一覧や検索結果、選択、ペースト先などの状態を持ちます。削除や移動は操作要求として取得できます。",
              "follow": "GetRecycleRequest・GetMoveRequest・GetPasteRequest。"
            },
            {
              "label": "AssetsPanel.cpp",
              "path": "Editor/src/panels/AssetsPanel.cpp",
              "topic": "素材画面の状態とファイル操作の要求",
              "explanation": "Draw は素材一覧を操作し、移動・ペースト・配置などの要求を作ります。素材を移した後は選択や表示先のパスも更新できます。",
              "follow": "Draw で操作を発行し、RelocatePaths で表示用の状態を更新。"
            },
            {
              "label": "AudioPreviewPanel.h",
              "path": "Editor/include/panels/AudioPreviewPanel.h",
              "topic": "選んだ音声の情報表示と試聴",
              "explanation": "WAVの形式と長さを確認し、シーンで再生中の音源とは独立して音声を試聴するインターフェースです。",
              "follow": "Open と Stop、Clear を比較。"
            },
            {
              "label": "AudioPreviewPanel.cpp",
              "path": "Editor/src/panels/AudioPreviewPanel.cpp",
              "topic": "音声アセットの試聴を管理",
              "explanation": "読み込んだクリップからサンプルレートや再生時間を表示します。パネルで使う試聴は停止・解放の操作も持ちます。",
              "follow": "Open → Draw → Stop／Clear。AudioPreview が再生を管理。"
            },
            {
              "label": "TexturePreviewPanel.h",
              "path": "Editor/include/panels/TexturePreviewPanel.h",
              "topic": "画像1枚の独立したプレビュー",
              "explanation": "選んだ画像をUI用テクスチャで表示します。素材編集の結果を表示へ取り込むため、再読み込みも要求できます。",
              "follow": "Open・RequestReload・Clear。"
            },
            {
              "label": "TexturePreviewPanel.cpp",
              "path": "Editor/src/panels/TexturePreviewPanel.cpp",
              "topic": "プレビュー画像を画面に表示",
              "explanation": "Draw でプレビュー画像を用意して表示します。再読み込みが失敗した場合は、使える前の画像があれば保持します。",
              "follow": "Open が対象を切り替える箇所と Draw、Clear。"
            },
            {
              "label": "ConsolePanel.h",
              "path": "Editor/include/panels/ConsolePanel.h",
              "topic": "ログの絞り込みとエラーへの移動",
              "explanation": "ログの重要度や文字列のフィルターを持ちます。Playエラーに注目する要求や、ログを表示・コピーする状態も扱います。",
              "follow": "ShowPlayError・MarkPlayStart と Request。"
            },
            {
              "label": "ConsolePanel.cpp",
              "path": "Editor/src/panels/ConsolePanel.cpp",
              "topic": "更新されたログをフィルター表示",
              "explanation": "Logger::ReadEntries に更新番号を渡して一覧を取得します。表示条件は MatchesFilter で判定し、コピーにも同じ条件を使います。",
              "follow": "Draw → Logger::ReadEntries。BuildFilteredText も確認。"
            },
            {
              "label": "HistoryPanel.h",
              "path": "Editor/include/panels/HistoryPanel.h",
              "topic": "履歴の現在地点と保存地点を表示するAPI",
              "explanation": "履歴の状態を表示し、選ばれた移動先を任意の番号として返します。履歴のカーソルを実際に動かす処理は別にあります。",
              "follow": "Draw の optional の戻り値 → EditorHistory::MoveTo。"
            },
            {
              "label": "HistoryPanel.cpp",
              "path": "Editor/src/panels/HistoryPanel.cpp",
              "topic": "履歴一覧の操作を移動先へ変換",
              "explanation": "保存済みの印や現在地点を表示します。別の履歴を選ぶと、移動先のインデックスを呼び出し元へ返します。",
              "follow": "Draw が現在地点とクリックを区別する箇所。"
            },
            {
              "label": "PerformancePanel.h",
              "path": "Editor/include/panels/PerformancePanel.h",
              "topic": "Editorのフレーム間隔を観察",
              "explanation": "フレーム間隔の履歴と、シーンの物体数などを表示するパネルです。Record で経過秒数を受け取ります。",
              "follow": "Record と FrameTimingHistory。"
            },
            {
              "label": "PerformancePanel.cpp",
              "path": "Editor/src/panels/PerformancePanel.cpp",
              "topic": "フレーム間隔の集計をグラフ化",
              "explanation": "Record で間隔を蓄積し、Draw では集計結果に加えて PlotLines で時系列を表示します。フレーム間隔の値から描画の単独処理時間は求まりません。",
              "follow": "Draw の GetSummary と ImGui::PlotLines。"
            },
            {
              "label": "PlayStatePanel.h",
              "path": "Editor/include/panels/PlayStatePanel.h",
              "topic": "試遊中の物体を観察する画面",
              "explanation": "編集シーンと別のPlay状態を表示します。主人公や足元のColliderを確認し、対象への選択やFrameの要求を出せます。",
              "follow": "Draw が受ける EditorPlaySession と返す Request。"
            },
            {
              "label": "PlayStatePanel.cpp",
              "path": "Editor/src/panels/PlayStatePanel.cpp",
              "topic": "試遊セッションを読んで対象を調べる",
              "explanation": "試遊中の物体と再生状態を使って、キャラクターや描画カメラなどを表示します。選択やFrameは呼び出し元に要求として返します。",
              "follow": "Draw で再生シーンから状態を読む箇所。"
            },
            {
              "label": "SceneCheckPanel.h",
              "path": "Editor/include/panels/SceneCheckPanel.h",
              "topic": "シーンの検査結果を保持・表示",
              "explanation": "試遊設定や素材参照の問題を保持し、対象物体へ移動する要求を作れます。シーンや素材のパス変更にも対応します。",
              "follow": "OnSceneOpened・OnAssetsMoved・Draw。"
            },
            {
              "label": "SceneCheckPanel.cpp",
              "path": "Editor/src/panels/SceneCheckPanel.cpp",
              "topic": "問題の検出結果を表示にまとめる",
              "explanation": "Check は SceneValidation のシーン検査と入力検査を呼びます。Draw では結果を絞り込み、GetReport で文章としてまとめられます。",
              "follow": "Check → Inspect／InspectInputs → GetReport。"
            },
            {
              "label": "SelectionMeasurementsPanel.h",
              "path": "Editor/include/panels/SelectionMeasurementsPanel.h",
              "topic": "選択中の配置を数値で確認",
              "explanation": "二つの原点の距離やColliderの寸法・すき間を読むためのパネルです。シーンを測って表示します。",
              "follow": "Draw → SelectionMeasurement::Result。"
            },
            {
              "label": "SelectionMeasurementsPanel.cpp",
              "path": "Editor/src/panels/SelectionMeasurementsPanel.cpp",
              "topic": "測定結果をUIへ整形",
              "explanation": "選択された物体から SelectionMeasurement の結果を得て、選択数に応じた距離や範囲を表示します。",
              "follow": "Draw の Measure 呼び出しと結果の表示分岐。"
            },
            {
              "label": "ControlsPanel.h",
              "path": "Editor/include/panels/ControlsPanel.h",
              "topic": "Editorの操作案内を開く",
              "explanation": "操作一覧の表示状態を管理します。Show で開き、Draw でパネルを描きます。",
              "follow": "Show と Draw を呼ぶメニュー側の処理。"
            },
            {
              "label": "ControlsPanel.cpp",
              "path": "Editor/src/panels/ControlsPanel.cpp",
              "topic": "操作とショートカットの案内",
              "explanation": "操作と動作の説明を区分ごとに2列で表示します。必要な区分だけ開閉できます。",
              "follow": "Draw → DrawSection の CollapsingHeader と BeginTable。"
            },
            {
              "label": "EditorDockLayout.h",
              "path": "Editor/include/layout/EditorDockLayout.h",
              "topic": "Editorの初期パネル配置を定義",
              "explanation": "ウィンドウ名と左右・下の割合を持ち、Draw でドッキング領域を組み立てます。",
              "follow": "Draw の resetLayout とパネル名。"
            },
            {
              "label": "EditorDockLayout.cpp",
              "path": "Editor/src/layout/EditorDockLayout.cpp",
              "topic": "既存配置を保ちながら初期配置を作る",
              "explanation": "ドックが存在しないときやリセット時に領域を分割します。中央にScene／Game、左右にHierarchy／Inspector、下にAssetsなどを置きます。",
              "follow": "HasDockNode → SplitDockNode → DockWindow。描画は ImGuiSystem。"
            },
            {
              "label": "GameViewLayout.h",
              "path": "Editor/include/layout/GameViewLayout.h",
              "topic": "ゲーム画像を元の縦横比で収める",
              "explanation": "利用できる幅と高さから画像の表示サイズを計算し、中央へ寄せる余白も返します。",
              "follow": "Fit で幅・高さの倍率の小さいほうを選ぶ計算。"
            },
            {
              "label": "FrameTimingHistory.h",
              "path": "Editor/include/diagnostics/FrameTimingHistory.h",
              "topic": "直近のフレーム間隔を保存する",
              "explanation": "固定容量にサンプルをため、件数、平均、95パーセンタイルなどの集計を返します。",
              "follow": "Summary と AddSample、GetSummary。"
            },
            {
              "label": "FrameTimingHistory.cpp",
              "path": "Editor/src/diagnostics/FrameTimingHistory.cpp",
              "topic": "循環配列から間隔を集計する",
              "explanation": "新しいサンプルで古い値を置き換えます。GetSummary は累積時間からFPSを求め、並べ替えた値から95パーセンタイルを求めます。",
              "follow": "AddSample の剰余と GetSummary の percentileIndex。"
            }
          ]
        }
      }
    },
