        "state": {
          "entries": [
            {
              "label": "SceneMotion.h",
              "path": "Engine/include/gameplay/SceneMotion.h",
              "topic": "経路移動と乗客を管理する",
              "explanation": "経路の実行時の位置を分離し、衝突で止まる移動床や上にいる物体の移動を扱います。",
              "follow": "Configure・SetPlayback・Advance。"
            },
            {
              "label": "SceneMotion.cpp",
              "path": "Engine/src/gameplay/SceneMotion.cpp",
              "topic": "動く床を進め、乗っている物体も動かす",
              "explanation": "設定された経路の位置へ進めます。固体への衝突を調べ、床と乗客の食い込みを防いで移動を反映します。",
              "follow": "Advance と枝の衝突判定。"
            },
            {
              "label": "ParticleEmitterComponent.h",
              "path": "Engine/include/particles/ParticleEmitterComponent.h",
              "topic": "粒子の発生と見た目の設定",
              "explanation": "発生する形状、画像、色、移動などを編集・保存用の値として持ちます。",
              "follow": "SceneParticles::Configure に渡る設定。"
            },
            {
              "label": "ParticleEmitterComponent.cpp",
              "path": "Engine/src/particles/ParticleEmitterComponent.cpp",
              "topic": "発生元の設定値を検証する",
              "explanation": "粒子の寿命や発生・移動に関わる数値などが想定した範囲に収まるかを確認します。",
              "follow": "IsValid の範囲条件。"
            },
            {
              "label": "ParticlePlaybackState.h",
              "path": "Engine/include/particles/ParticlePlaybackState.h",
              "topic": "粒子の発生状況を確認する",
              "explanation": "発生元の進行時刻や設定状態、生きている粒子数を実行側から取得するための型です。",
              "follow": "SceneParticles が返す再生状態。"
            },
            {
              "label": "ParticleDrawBatch.h",
              "path": "Engine/include/particles/ParticleDrawBatch.h",
              "topic": "GPUに渡す粒子の描画データ",
              "explanation": "粒子の位置・大きさ・色などを保持し、同じ画像と混合方式を使う粒子をまとめます。",
              "follow": "ParticleDrawBatch → ParticleRenderer::Update。"
            },
            {
              "label": "SceneParticles.h",
              "path": "Engine/include/particles/SceneParticles.h",
              "topic": "発生元ごとのシミュレーション状態",
              "explanation": "乱数、経過時間と粒子を編集データから分けて管理し、発生・更新・描画情報の取得を提供します。",
              "follow": "Configure・Advance・Control・Snapshot。"
            },
            {
              "label": "SceneParticles.cpp",
              "path": "Engine/src/particles/SceneParticles.cpp",
              "topic": "粒子を生成し、寿命で取り除く",
              "explanation": "Emit で発生し、Integrate で進め、Advance で寿命が尽きた粒子を除きます。描画用の情報は Snapshot がまとめます。",
              "follow": "Emit → Integrate → Advance → Snapshot。"
            },
            {
              "label": "ParticleEmitterInspector.h",
              "path": "Editor/include/particles/ParticleEmitterInspector.h",
              "topic": "粒子の設定をInspectorで編集する",
              "explanation": "発生と動き、画像や色を変更し、連続編集を一つのUndoにまとめる入口です。",
              "follow": "Draw と DrawReadOnly。"
            },
            {
              "label": "ParticleEmitterInspector.cpp",
              "path": "Editor/src/particles/ParticleEmitterInspector.cpp",
              "topic": "粒子設定の編集を取り消し可能にする",
              "explanation": "画面の入力を設定へ反映し、履歴に編集を記録します。試遊で使う読み取り専用の表示もあります。",
              "follow": "Draw の EditorHistory と DrawReadOnly。"
            }
          ]
        }
      }
    },
