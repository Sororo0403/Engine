            {
              "label": "AssetDatabase.h",
              "path": "Editor/include/assets/AssetDatabase.h",
              "topic": "Editorが列挙する素材の種類",
              "explanation": "モデル・画像・音声・シーンなどの一覧を保持し、種類ごとに取り出せます。",
              "follow": "Refresh と GetModels、GetSceneTargets。"
            },
            {
              "label": "AssetDatabase.cpp",
              "path": "Editor/src/assets/AssetDatabase.cpp",
              "topic": "素材フォルダを走査して一覧を更新",
              "explanation": "Refresh で種類ごとの候補を作り、RefreshProjectScenes でプロジェクト側のシーン一覧を更新できます。",
              "follow": "SetRootDirectory → Refresh。シーンは RefreshProjectScenes。"
            },
            {
              "label": "AssetSources.h",
              "path": "Editor/include/assets/AssetSources.h",
              "topic": "探索する素材フォルダの集合",
              "explanation": "画面で選んだ探索先と、引き続き参照できる外部の素材フォルダを保持します。",
              "follow": "Select と Register の違い。"
            },
            {
              "label": "AssetSources.cpp",
              "path": "Editor/src/assets/AssetSources.cpp",
              "topic": "現在の探索先と登録先を管理",
              "explanation": "Select は現在の素材フォルダを設定します。Register では既存シーンが参照する取得元を集合に追加できます。",
              "follow": "Select・Register・GetDirectories。"
            },
            {
              "label": "AssetFolders.h",
              "path": "Editor/include/assets/AssetFolders.h",
              "topic": "安全な素材フォルダ操作の入口",
              "explanation": "使える新しい名前の候補、参照パスへの変換、既存フォルダの解決、新規作成を提供します。",
              "follow": "SuggestAvailableName・MakeReference・Resolve・Create。"
            },
            {
              "label": "AssetFolders.cpp",
              "path": "Editor/src/assets/AssetFolders.cpp",
              "topic": "衝突を避けて素材の名前を決める",
              "explanation": "同名の項目があれば拡張子の前に連番を付けて候補を作ります。作成時は配置先を検証します。",
              "follow": "SuggestAvailableName と Create。"
            },
            {
              "label": "AssetDragDrop.h",
              "path": "Editor/include/assets/AssetDragDrop.h",
              "topic": "素材の種類とパスをパネル間で渡す",
              "explanation": "画像やモデルなどを識別して、ドラッグ元と受け側で同じデータを扱います。",
              "follow": "DrawSource と AcceptTarget の Kind。"
            },
            {
              "label": "AssetDragDrop.cpp",
              "path": "Editor/src/assets/AssetDragDrop.cpp",
              "topic": "ImGuiのペイロードから対象パスを読む",
              "explanation": "ドラッグ元では種類に応じたデータを組み立て、ドロップ先では受け取る種類を指定してパスに戻します。",
              "follow": "DrawSource・AcceptTarget・AcceptAssetTarget。"
            },
            {
              "label": "AssetUsage.h",
              "path": "Editor/include/assets/AssetUsage.h",
              "topic": "参照の探索と素材操作のAPI",
              "explanation": "削除前の参照確認、同名を避けたコピー、移動に伴う参照更新を公開します。参照元のファイルや物体も表せます。",
              "follow": "Reference と Find・CopyTo・Relocate。"
            },
            {
              "label": "AssetUsage.cpp",
              "path": "Editor/src/assets/AssetUsage.cpp",
              "topic": "素材を移すとシーン内の参照も更新",
              "explanation": "旧パスと新パスの対応を作り、保存済みシーン・Prefabと編集中のデータへ反映します。",
              "follow": "Relocate の参照更新と FindAvailableMoveDestinations。"
            },
            {
              "label": "AssetDependencies.h",
              "path": "Editor/include/assets/AssetDependencies.h",
              "topic": "モデルの外部ファイルを調べるAPI",
              "explanation": "モデル本体と外部画像やバッファ、OBJの材質などを列挙します。依存ファイルがない場合の診断も扱います。",
              "follow": "ModelFiles と DescribeMissingModelDependency。"
            },
            {
              "label": "AssetDependencies.cpp",
              "path": "Editor/src/assets/AssetDependencies.cpp",
              "topic": "モデルを読み依存素材を集める",
              "explanation": "CPU側で読み込んだ内容から、素材を利用するために必要なファイルを得ます。画像・音声を直接参照する場合の検証も提供します。",
              "follow": "ModelFiles・TextureFiles・AudioFiles。"
            },
            {
              "label": "AudioImporter.h",
              "path": "Editor/include/assets/AudioImporter.h",
              "topic": "WAVインポートの入力と結果",
              "explanation": "外部のWAVと保存先・保存名を受け取り、Assetsへ音声を取り込むAPIです。",
              "follow": "AudioImportOptions と Import。"
            },
            {
              "label": "AudioImporter.cpp",
              "path": "Editor/src/assets/AudioImporter.cpp",
              "topic": "音声を検証してからコピー",
              "explanation": "読み込めるWAVかを確認してAssetsへコピーします。既存の素材を上書きしないよう対象パスを扱います。",
              "follow": "Import の音声検証からコピーまで。"
            },
            {
              "label": "ImageValidation.h",
              "path": "Editor/include/assets/ImageValidation.h",
              "topic": "画像を復号できるか確認するAPI",
              "explanation": "先頭フレームをRGBAとして読み、全行を取得できることを確認します。",
              "follow": "Read の引数と結果。"
            },
            {
              "label": "ImageValidation.cpp",
              "path": "Editor/src/assets/ImageValidation.cpp",
              "topic": "画像の先頭フレームを復号する",
              "explanation": "画像の形式だけで判断せず、WICで画素をRGBAに変換して読みます。",
              "follow": "Read の WIC フレーム取得・変換・画素読み込み。"
            },
            {
              "label": "TextureImporter.h",
              "path": "Editor/include/assets/TextureImporter.h",
              "topic": "画像取り込みの入力",
              "explanation": "外部画像、Assets内の対象フォルダ、保存名を受け取る取り込み処理です。",
              "follow": "TextureImportOptions と Import。"
            },
            {
              "label": "TextureImporter.cpp",
              "path": "Editor/src/assets/TextureImporter.cpp",
              "topic": "復号できる画像をAssetsへ取り込む",
              "explanation": "選んだ画像を検証し、新規ファイルとしてコピーします。復号に失敗した画像は取り込みに進みません。",
              "follow": "Import → ImageValidation::Read。"
            },
            {
              "label": "ModelImporter.h",
              "path": "Editor/include/assets/ModelImporter.h",
              "topic": "モデル取り込みの基準と作成先",
              "explanation": "モデル本体、依存ファイルを探す基準、Assetsに作る取り込み先をまとめます。",
              "follow": "ModelImportOptions と Import。"
            },
            {
              "label": "ModelImporter.cpp",
              "path": "Editor/src/assets/ModelImporter.cpp",
              "topic": "モデルと依存ファイルを一緒に配置",
              "explanation": "外部ファイルを含めて新規フォルダにコピーする処理を組み立てます。相対参照が使えるように配置を扱います。",
              "follow": "Import の依存ファイル収集と出力。"
            },
            {
              "label": "SceneImporter.h",
              "path": "Editor/include/assets/SceneImporter.h",
              "topic": "出力したゲームを再び取り込むAPI",
              "explanation": "配布ゲームの設定と、新しく作る素材フォルダを受け取ります。シーンと参照素材をまとめて読み込めます。",
              "follow": "SceneImportOptions と Import。"
            },
            {
              "label": "SceneImporter.cpp",
              "path": "Editor/src/assets/SceneImporter.cpp",
              "topic": "配布用のシーン参照を編集版に置き直す",
              "explanation": "ゲーム設定からシーンを探し、必要な素材の取り込みに合わせて参照を変換します。",
              "follow": "Import の配布設定の読み込みと参照変換。"
            },
            {
              "label": "SceneAssetValidation.h",
              "path": "Editor/include/assets/SceneAssetValidation.h",
              "topic": "シーンのモデルと画像を検証するAPI",
              "explanation": "モデルの読み込みや依存素材の存在、明示的に割り当てた画像を復号できるかを調べます。",
              "follow": "Inspect の結果を SceneCheckPanel からたどる。"
            },
            {
              "label": "SceneAssetValidation.cpp",
              "path": "Editor/src/assets/SceneAssetValidation.cpp",
              "topic": "素材欠損をシーンの検査結果に反映",
              "explanation": "物体ごとのモデルや材質の割り当てを検査し、問題があれば対象をたどれる情報とともに返します。",
              "follow": "モデル依存の収集と画像の復号検査。"
            },
            {
              "label": "ModelUsage.h",
              "path": "Editor/include/assets/ModelUsage.h",
              "topic": "モデルから参照元の物体を探す",
              "explanation": "選んだモデルを参照する物体を探します。非表示でも参照は存在するため結果に含めます。",
