        "state": {
          "entries": [
            {
              "label": "CanvasComponent.h",
              "path": "Engine/include/scene/CanvasComponent.h",
              "topic": "基準解像度と重ね順を指定",
              "explanation": "基準となる画面サイズ、表示先に合わせた拡縮、Canvas同士の描画順を保持します。",
              "follow": "CanvasLayout::Collect が設定を読む箇所。"
            },
            {
              "label": "CanvasComponent.cpp",
              "path": "Engine/src/scene/CanvasComponent.cpp",
              "topic": "Canvasの設定を検証",
              "explanation": "基準解像度と比率など、レイアウト計算に使う値を確認します。",
              "follow": "IsValid と CanvasLayout::Collect。"
            },
            {
              "label": "RectTransformComponent.h",
              "path": "Engine/include/scene/RectTransformComponent.h",
              "topic": "親のUI矩形に対する配置",
              "explanation": "アンカー、基準点、座標や寸法などを持ちます。UIのYの正方向は下向きです。",
              "follow": "CanvasLayout の親の矩形から子を配置する計算。"
            },
            {
              "label": "RectTransformComponent.cpp",
              "path": "Engine/src/scene/RectTransformComponent.cpp",
              "topic": "UIの変形の数値を検証する",
              "explanation": "アンカーや位置などの値が有効か確認し、親から子への矩形計算に不正な値が入るのを防ぎます。",
              "follow": "IsValid の各成分の検査。"
            },
            {
              "label": "TextComponent.h",
              "path": "Engine/include/scene/TextComponent.h",
              "topic": "UIの文言とフォント設定を持つ",
              "explanation": "UTF-8文字列、フォント、文字サイズ、配置と色を保存します。",
              "follow": "TextRasterizer::Rasterize が文字と設定を読む。"
            },
            {
              "label": "TextComponent.cpp",
              "path": "Engine/src/scene/TextComponent.cpp",
              "topic": "描画前に文字の設定を確認",
              "explanation": "サイズやテキストの形式などを検証し、描画や保存時に使用できるか確認します。",
              "follow": "IsValid と SceneUISerializer。"
            },
            {
              "label": "ImageComponent.h",
              "path": "Engine/include/scene/ImageComponent.h",
              "topic": "画面上の画像と色を設定",
              "explanation": "テクスチャと色を持ちます。画像が未割り当てでも、単色の矩形にできます。",
              "follow": "CanvasRenderer で画像参照が空の場合を見る。"
            },
            {
              "label": "ImageComponent.cpp",
              "path": "Engine/src/scene/ImageComponent.cpp",
              "topic": "画像コンポーネントの設定を確認",
              "explanation": "画像参照や色、塗る割合などの設定を検証します。",
              "follow": "IsValid と CanvasRenderer::Update。"
            },
            {
              "label": "ButtonComponent.h",
              "path": "Engine/include/scene/ButtonComponent.h",
              "topic": "クリックや決定操作を受ける設定",
              "explanation": "操作できるか、ナビゲーションの対象か、操作中にどの色で表示するかを保持します。",
              "follow": "SceneUI の有効判定と UIButtonVisual。"
            },
            {
              "label": "ButtonComponent.cpp",
              "path": "Engine/src/scene/ButtonComponent.cpp",
              "topic": "ボタン表示用の色を検証",
              "explanation": "通常や押下など、状態別に使う色が有効であることを調べます。",
              "follow": "IsValid と SceneUI が使う色。"
            },
            {
              "label": "CanvasLayout.h",
              "path": "Engine/include/ui/CanvasLayout.h",
              "topic": "描画と判定で共有するUIの配置",
              "explanation": "描画先のピクセル矩形や親から継承した変換の情報を持ちます。Collect は描画順に並んだ要素を返します。",
              "follow": "UIElement と Collect を CanvasRenderer／SceneUI から追う。"
            },
            {
              "label": "CanvasLayout.cpp",
              "path": "Engine/src/ui/CanvasLayout.cpp",
              "topic": "Canvasの基準座標から実際の矩形を作る",
              "explanation": "親から順にUIの矩形を計算し、画面の大きさやアンカー、親の変換を反映します。",
              "follow": "Collect の拡縮と親の位置の参照。"
            },
            {
              "label": "UIInput.h",
              "path": "Engine/include/ui/UIInput.h",
              "topic": "UIが受け取るポインターと決定の状態",
              "explanation": "描画先に正規化された位置、押下、選択移動などの値を保持します。",
              "follow": "UIInputReader::Read と SceneUI::Update。"
            },
            {
              "label": "UIInput.cpp",
              "path": "Engine/src/ui/UIInput.cpp",
              "topic": "UI入力の範囲を確認する",
              "explanation": "描画サイズや方向入力、ポインターが有効なら座標が0から1の範囲かを確認します。",
              "follow": "IsValid の寸法と pointerValid。"
            },
            {
              "label": "UIInputReader.h",
              "path": "Engine/include/ui/UIInputReader.h",
              "topic": "共通入力からUI入力を作るAPI",
              "explanation": "キーボード、ゲームパッドと任意のマウスを使い、UIに渡す値を組み立てます。",
              "follow": "Read の enabled と navigationEnabled。"
            },
            {
              "label": "UIInputReader.cpp",
              "path": "Engine/src/ui/UIInputReader.cpp",
              "topic": "描画寸法でポインター位置を正規化",
              "explanation": "クライアント座標を描画先の大きさに基づく比率へ変換します。選択や決定も共通入力から作ります。",
              "follow": "Read のポインター座標とナビゲーションの扱い。"
            },
            {
              "label": "UIButtonVisual.h",
              "path": "Engine/include/ui/UIButtonVisual.h",
              "topic": "再生中だけ変わるボタンの表示情報",
              "explanation": "ボタン設定と分けて、描画に使う試遊中のボタンの状態を保持します。",
              "follow": "SceneUI の出力から CanvasRenderer の色設定へ。"
            },
            {
              "label": "SceneUI.h",
              "path": "Engine/include/ui/SceneUI.h",
              "topic": "編集値を保ったままUIの操作状態を管理",
              "explanation": "選択中・押下中・クリックの状態を再生側で保持します。",
              "follow": "Update とクリック結果を読む側。"
            },
            {
              "label": "SceneUI.cpp",
              "path": "Engine/src/ui/SceneUI.cpp",
              "topic": "同じボタン上で離すとクリックになる",
              "explanation": "最前面の対象を調べます。押したボタンと離した位置のボタンが一致するとクリックを記録します。",
              "follow": "PointerHit と Update の released 分岐。"
            }
          ]
        }
      }
    },
