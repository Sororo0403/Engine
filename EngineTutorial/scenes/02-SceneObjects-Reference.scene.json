        "state": {
          "entries": [
            {
              "label": "SceneObject.h",
              "path": "Engine/include/scene/SceneObject.h",
              "topic": "物体の機能を組み合わせる",
              "explanation": "ID・親ID・Transform は共通です。描画や音などの機能は optional のフィールドに保存し、必要な物体だけに追加できます。",
              "follow": "HasMesh と IsRenderable の判定を比較。"
            },
            {
              "label": "SceneObject.cpp",
              "path": "Engine/src/scene/SceneObject.cpp",
              "topic": "各機能が物体を使う条件",
              "explanation": "CanAnimate はトラックが要求するコンポーネントがあるか調べます。HasSameSimulationSettings は物体のシミュレーション設定を比較します。",
              "follow": "CanAnimate のトラック種別による分岐。"
            },
            {
              "label": "SceneObjectId.h",
              "path": "Engine/include/scene/SceneObjectId.h",
              "topic": "物体を一意に指す番号",
              "explanation": "IDは64ビットの符号なし整数です。名前が同じ物体もIDで区別し、親ID 0 は親がいない状態を表します。",
              "follow": "Scene::CreateObject の採番と Scene::FindObject。"
            },
            {
              "label": "ObjectTag.h",
              "path": "Engine/include/scene/ObjectTag.h",
              "topic": "タグの文字列を検証する",
              "explanation": "空のタグも有効です。値を与えた場合は64バイト以下で、埋め込みNULがなく、有効なUTF-8であることを調べます。",
              "follow": "ObjectTag::IsValid → StringConversion::Utf8ToWide。"
            },
            {
              "label": "Scene.h",
              "path": "Engine/include/scene/Scene.h",
              "topic": "物体の保管と編集の入口",
              "explanation": "IDで物体を引く連想配列と、シーン全体の照明や霧の設定を保持します。作成・検索・一括編集などの関数を公開します。",
              "follow": "GetObjects の戻り値と ApplyTransaction の引数。"
            },
            {
              "label": "Scene.cpp",
              "path": "Engine/src/scene/Scene.cpp",
              "topic": "変更候補を検証してから反映する",
              "explanation": "ApplyTransaction は作業用シーンに操作を適用し、検証できた候補を反映します。FindObject は指定IDがなければ nullptr を返します。",
              "follow": "ApplyTransaction の GetEvaluationOrder と objects_.swap。"
            },
            {
              "label": "Transform.h",
              "path": "Engine/include/math/Transform.h",
              "topic": "物体自身の位置・向き・大きさ",
              "explanation": "移動の3成分、クォータニオンの4成分、拡大率の3成分を保持します。初期状態は位置0、回転なし、拡大率1です。",
              "follow": "SceneObject::transform → TransformUtils::MakeWorldMatrix。"
            },
            {
              "label": "SceneWorldTransform.h",
              "path": "Engine/include/scene/SceneWorldTransform.h",
              "topic": "親子を合成した後の変形",
              "explanation": "ワールド行列と合成した回転を持ちます。GetPosition は行列の _41・_42・_43 を位置として取り出します。",
              "follow": "SceneHierarchy.cpp の Compose → GetPosition。"
            },
            {
              "label": "SceneHierarchy.h",
              "path": "Engine/include/scene/SceneHierarchy.h",
              "topic": "親子関係の参照と編集",
              "explanation": "WorldTransforms はIDから変形を引く表です。GetSubtree で子孫を列挙し、SetParent で親を変更できます。",
              "follow": "WorldTransforms と BuildWorldTransforms。"
            },
            {
              "label": "SceneHierarchy.cpp",
              "path": "Engine/src/scene/SceneHierarchy.cpp",
              "topic": "親から子の順に変形を合成する",
              "explanation": "BuildWorldTransforms は親を先に処理します。SetParent は循環を拒否し、keepWorld が有効なら新しい親に対するローカル変形を求めます。",
              "follow": "GetEvaluationOrder → Compose。親変更では SetParent。"
            },
            {
              "label": "TransformUtils.h",
              "path": "Engine/include/math/TransformUtils.h",
              "topic": "変形を計算する共通API",
              "explanation": "Transform の検証、回転の正規化、行列への変換、行列からの復元と逆行列を扱います。",
              "follow": "TryFromWorldMatrix を SceneHierarchy::SetWorldTransform から追う。"
            },
            {
              "label": "TransformUtils.cpp",
              "path": "Engine/src/math/TransformUtils.cpp",
              "topic": "拡大・回転・移動を行列へ変換する",
              "explanation": "MakeWorldMatrix は拡大・回転・移動を順に合成します。逆の変換では、行列を Transform で表せるかも検証します。",
              "follow": "MakeWorldMatrix と TryFromWorldMatrix。計算に DirectXMath を使用。"
            },
            {
              "label": "MathUtils.h",
              "path": "Engine/include/math/MathUtils.h",
              "topic": "グリッド吸着と非有限値の検出",
              "explanation": "位置をグリッドに吸着する関数と、ベクトル・行列を検査する関数を公開します。IsFinite は NaN や無限大の検出に使います。",
              "follow": "SnapToGrid と各型の IsFinite。"
            },
            {
              "label": "MathUtils.cpp",
              "path": "Engine/src/math/MathUtils.cpp",
              "topic": "位置をセルの間隔に丸める",
              "explanation": "SnapToGrid は成分を間隔で割って丸め、間隔を掛け直します。間隔や演算結果が不正なら失敗を返します。",
              "follow": "SnapToGrid の間隔チェックと丸めの式。"
            },
            {
              "label": "Ray.h",
              "path": "Engine/include/math/Ray.h",
              "topic": "選択などに使う半直線",
              "explanation": "原点と単位方向、最大判定距離を持ちます。Sceneビューのクリックでは画面上の点をワールド空間の半直線にし、物体との交差を調べます。",
              "follow": "EditorScene.cpp の Ray と選択処理を追う。"
            },
            {
              "label": "SceneActivity.h",
              "path": "Engine/include/scene/SceneActivity.h",
              "topic": "実行上の有効状態を読むAPI",
              "explanation": "States は物体IDごとの実効状態です。BuildStates で全物体の状態をまとめて作り、複数の処理で再利用できます。",
              "follow": "BuildStates と IsActive の引数を比較。"
            },
            {
              "label": "SceneActivity.cpp",
              "path": "Engine/src/scene/SceneActivity.cpp",
              "topic": "親の有効状態を子に継承する",
              "explanation": "物体自身と親の両方が有効なとき、その物体も実行上有効です。この計算で子自身の active の設定値は書き換えません。",
              "follow": "GetEvaluationOrder → BuildStates。"
            },
            {
              "label": "SceneActiveChange.h",
              "path": "Engine/include/scene/SceneActiveChange.h",
              "topic": "有効状態の変更を伝える",
              "explanation": "変更する物体のIDと変更後の active を一組で持ちます。複数物体の変更も対象と値の対応を保って渡せます。",
              "follow": "objectId と active を実行時の有効化処理で確認。"
            },
            {
              "label": "SceneDestruction.h",
              "path": "Engine/include/scene/SceneDestruction.h",
              "topic": "削除する子階層の根を受け取るAPI",
              "explanation": "Apply は削除対象のIDを span で受け取り、成否と必要に応じて失敗理由を返します。",
              "follow": "SceneDestruction.cpp の Apply。"
            },
            {
              "label": "SceneDestruction.cpp",
              "path": "Engine/src/scene/SceneDestruction.cpp",
              "topic": "子孫と参照を含めて削除する",
              "explanation": "削除対象の子孫も集め、残る物体から消えるIDへの参照を整理します。一連の変更は ApplyTransaction 内で行います。",
              "follow": "Apply の GetEvaluationOrder → Remap。"
            },
            {
              "label": "SceneObjectReferences.h",
              "path": "Engine/include/scene/SceneObjectReferences.h",
              "topic": "物体間の参照を置換するAPI",
              "explanation": "Remap は物体参照を置き換えます。許可外の参照や削除された対象を調べて除去するAPIもあります。",
              "follow": "Remap は PrefabInstantiation、ClearTargets は EditorHistory でも使う。"
            },
            {
              "label": "SceneObjectReferences.cpp",
              "path": "Engine/src/scene/SceneObjectReferences.cpp",
              "topic": "設定の中から物体IDを探す",
              "explanation": "コンポーネントに埋め込まれた参照IDの列挙を共通化し、同じ対象を付け替えや消去の処理に使います。",
              "follow": "参照の列挙ヘルパーと Remap・ClearTargets。"
            },
            {
              "label": "MeshComponent.h",
              "path": "Engine/include/scene/MeshComponent.h",
              "topic": "モデルの参照と先読み指定",
              "explanation": "modelPath にモデルの場所、preload に事前に読み込むかを持ちます。描画の設定は MeshRendererComponent が担当します。",
              "follow": "SceneObject::HasMesh とモデルの先読みを行う箇所。"
            },
            {
              "label": "MeshRendererComponent.h",
              "path": "Engine/include/scene/MeshRendererComponent.h",
              "topic": "メッシュをどう見せるか",
              "explanation": "表示の有無、テクスチャ、UV変形、部分表示、霧の適用を持ちます。IsValid はテクスチャ設定やUV値も確認します。",
              "follow": "SceneObject::IsRenderable → SceneRenderer。"
            },
            {
              "label": "CameraComponent.h",
              "path": "Engine/include/scene/CameraComponent.h",
              "topic": "カメラを選んで映すための設定",
              "explanation": "投影設定を CameraSettings に持ち、primary はカメラの選択に使います。IsValid は CameraSettings に検証を委ねます。",
              "follow": "カメラ選択で primary を読む箇所。"
            },
            {
              "label": "DirectionalLightComponent.h",
              "path": "Engine/include/scene/DirectionalLightComponent.h",
              "topic": "物体として置く平行光",
              "explanation": "色、強度、影の設定を持ちます。向きには物体の回転を使い、IsValid は色や強度の範囲と影の設定を検証します。",
              "follow": "SceneRenderer で照明を集める箇所。"
            },
            {
              "label": "PointLightComponent.h",
              "path": "Engine/include/scene/PointLightComponent.h",
              "topic": "周囲に広がる点光源",
              "explanation": "色、強度、届く範囲を持ちます。強度や範囲の上限は描画側の PointLightData と共有します。",
              "follow": "IsValid の数値チェックと PointLightData。"
            },
            {
              "label": "SpotLightComponent.h",
              "path": "Engine/include/scene/SpotLightComponent.h",
              "topic": "光が当たる円すいの設定",
              "explanation": "色、強度、距離に加えて内角と外角を持ちます。内角が外角より大きい値は無効です。",
              "follow": "IsValid の角度の比較から描画側の SpotLightData へ。"
            },
            {
              "label": "PrefabLinkComponent.h",
              "path": "Engine/include/scene/PrefabLinkComponent.h",
              "topic": "Prefabの元データと実体を結ぶ",
              "explanation": "Prefab元と実体のID対応、参照するアセット、変更を比較する基準データを保持します。",
              "follow": "GetInstance と IsValid。保存と更新は第4章。"
            },
            {
              "label": "PrefabInstantiation.h",
              "path": "Engine/include/scene/PrefabInstantiation.h",
              "topic": "Prefabをシーンへ置く入口",
              "explanation": "追加先、Prefab、配置位置を受け取り、追加したルートのIDを返す関数を公開します。最大物体数も定義します。",
              "follow": "Instantiate のシグネチャから実装へ。"
            },
            {
              "label": "PrefabInstantiation.cpp",
              "path": "Engine/src/scene/PrefabInstantiation.cpp",
              "topic": "PrefabのIDをシーン用に付け替える",
              "explanation": "親から子の順に複製し、元のIDと新しいIDを対応付けます。その対応で参照先も書き換え、複製後のルートを返します。",
              "follow": "Instantiate の ApplyTransaction → Remap。"
            },
            {
              "label": "PrefabSerializer.h",
              "path": "Engine/include/scene/PrefabSerializer.h",
              "topic": "Prefabの読み書きと構造検証",
              "explanation": "Prefabをファイルやテキストから読み、指定したルートを持つデータを保存するAPIです。Validate はルートを特定して構造を検証します。",
              "follow": "Load／Deserialize と Serialize／Validate の役割を比較。"
            },
            {
              "label": "PrefabSerializer.cpp",
              "path": "Engine/src/scene/PrefabSerializer.cpp",
              "topic": "PrefabのJSONと参照制約を扱う",
              "explanation": "形式や構造を検証し、Prefab外の物体を指す参照などを扱います。シーン側のシリアライザーも利用します。",
              "follow": "Validate の参照検証と Serialize。JSONは nlohmann/json。"
            },
            {
              "label": "SceneAudio.h",
              "path": "Engine/include/scene/SceneAudio.h",
              "topic": "音声用に集めたシーン情報",
              "explanation": "SceneAudioFrame は聞き手の位置と向き、有効な音源の一覧を持ちます。Collect は事前計算した変形と有効状態も受け取れます。",
              "follow": "Collect の2つの宣言と SceneAudioFrame。"
            },
            {
              "label": "SceneAudio.cpp",
              "path": "Engine/src/scene/SceneAudio.cpp",
              "topic": "有効な音源と聞き手を集める",
              "explanation": "実効状態と世界座標を使って音源を集めます。聞き手となる物体がなければカメラを使います。",
              "follow": "Collect の AudioListener の選択と発音位置の設定。"
            },
            {
              "label": "SceneAudioAction.h",
              "path": "Engine/include/scene/SceneAudioAction.h",
              "topic": "特定音源の再生・停止命令",
              "explanation": "PLAY または STOP と、対象物体のIDを持ちます。対象が0の命令は無効です。",
              "follow": "Operation と IsValid。受け取り側は SceneAudioPlayer。"
            },
            {
              "label": "SceneAudioActions.h",
              "path": "Engine/include/scene/SceneAudioActions.h",
              "topic": "音声命令を更新単位で渡す",
              "explanation": "命令の span とリビジョンを持ちます。再生側は処理済みリビジョンを覚え、同じ命令セットを反復しないようにします。",
              "follow": "commands と revision → SceneAudioPlayer::Synchronize。"
            },
            {
              "label": "SceneAudioPlayer.h",
              "path": "Engine/include/scene/SceneAudioPlayer.h",
              "topic": "物体IDと音声再生状態を管理する",
              "explanation": "音源ごとに設定、クリップ、再生ハンドルを保持します。Start と Update にカメラと一時停止状態を渡します。",
              "follow": "Entry と Synchronize。音声の詳細は第9章。"
            },
            {
              "label": "SceneAudioPlayer.cpp",
              "path": "Engine/src/scene/SceneAudioPlayer.cpp",
              "topic": "音源の変化を再生へ反映する",
              "explanation": "集めた音源と再生状態を照合します。発音位置を更新し、消えた音源の停止や再生・停止命令を扱います。",
              "follow": "Start／Update → Synchronize → AudioSystem。"
            },
            {
              "label": "SceneRigidBodySerializer.h",
              "path": "Engine/src/scene/SceneRigidBodySerializer.h",
              "topic": "剛体の設定をJSONとやり取りする入口",
              "explanation": "SceneSerializer から呼ばれる剛体用の Read／Write を宣言します。読み込み側はシーン形式の版も受け取ります。",
              "follow": "SceneSerializer の呼び出しと照合。"
            },
            {
              "label": "SceneRigidBodySerializer.cpp",
              "path": "Engine/src/scene/SceneRigidBodySerializer.cpp",
              "topic": "剛体設定を厳密な型で読み込む",
              "explanation": "質量・摩擦・速度などを保存します。読み込み時には JSON の型を調べ、速度が数値3個の配列かなどを確認します。",
              "follow": "Velocity と Read。物理で使う流れは第6章。"
            },
            {
              "label": "LegacyMaterial.h",
              "path": "Engine/src/scene/LegacyMaterial.h",
              "topic": "旧材質の移行に使う途中データ",
              "explanation": "旧ファイルから読む材質パラメーターとベースカラーテクスチャをまとめます。",
              "follow": "LegacyMaterial と LegacyMaterialReader::Load。"
            },
            {
              "label": "LegacyMaterial.cpp",
              "path": "Engine/src/scene/LegacyMaterial.cpp",
              "topic": "以前の材質JSONを読み解く",
              "explanation": "EngineMaterial の版1・2を読み、色やUV値を検証します。版2では Lit と Unlit を描画側の列挙値に変えます。",
              "follow": "LegacyMaterialReader::Load。nlohmann/json と PathUtils を使う。"
            }
          ]
        }
      }
