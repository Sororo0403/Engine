        "state": {
          "questions": [
            {
              "source": "Engine/src/gameplay/SceneSimulation.cpp  /  Advance",
              "code": "if (!motion.Advance(working, seconds, /* 引数を省略 */))\n    return false;\n\nauto physics = physics_;\nstd::string physicsError;\nif (!physics.Advance(working, seconds, physicsError)) {\n    lastUpdateError_ = std::move(physicsError);\n    return false;\n}",
              "prompt": "移動経路と剛体の更新があるフレームで、ここではどちらを先に処理しますか？",
              "options": [
                "剛体を先に更新",
                "移動経路を先に更新",
                "両方を同時に更新"
              ],
              "correct": 2,
              "feedback": [
                "physics.Advance より手前に motion.Advance があります。",
                "正解。移動床などの経路を反映してから、作業中のシーンで剛体を更新します。",
                "ここは順番に呼びます。移動が失敗した場合は剛体更新まで進みません。"
              ]
            },
            {
              "source": "Engine/src/physics/CollisionWorld.cpp  /  Rebuild",
              "code": "if (!object.collider->isTrigger) {\n    // 衝突形状を作成する処理を省略\n    candidate.push_back({\n        id, bounds, object.collider->filter,\n        std::move(geometry), *object.collider,\n        transforms.at(id).matrix});\n}",
              "prompt": "床のColliderをTriggerにしました。通常のキャラクター移動を止める壁や床として扱われますか？",
              "options": [
                "床として止まる",
                "壁として止まる",
                "移動を止める候補には入らない"
              ],
              "correct": 3,
              "feedback": [
                "isTrigger が true のときは、このブロックに入りません。",
                "形状が壁でも同じ条件です。Trigger は重なり通知の処理で使います。",
                "正解。固体の衝突候補へ入れず、TriggerWorldで重なりを扱います。"
              ]
            },
            {
              "source": "Engine/src/gameplay/CharacterController.cpp  /  Step",
              "code": "if ((jumpPending_ || jumpBufferRemaining_ > 0.0) &&\n    (grounded_ || coyoteRemaining_ > 0.0)) {\n    verticalVelocity_ = settings_.jumpSpeed;\n    // ジャンプ後の状態更新を省略\n}",
              "prompt": "足場を出た直後で grounded_ は false ですが、coyoteRemaining_ は正です。この瞬間にジャンプを押すと？",
              "options": [
                "ジャンプできる",
                "次の着地まで必ず待つ",
                "下に向かって加速する"
              ],
              "correct": 1,
              "feedback": [
                "正解。接地が切れても、猶予時間が残っていればジャンプできます。",
                "この例では接地に代わる猶予の条件が成立しています。",
                "条件が成立すると、速度には設定された jumpSpeed を入れます。"
              ]
            },
            {
              "source": "Engine/src/gameplay/SceneSimulation.cpp  /  Advance",
              "code": "if (object->respawn &&\n    next.GetTransform().translation.y <\n        object->respawn->minimumY) {\n    if (!next.Teleport(spawn_, world))\n        return false;\n    respawned = true;\n}",
              "prompt": "復帰の高さを -8 に設定しました。主人公のYが -8 と等しいフレームでは、復帰しますか？",
              "options": [
                "復帰する",
                "まだ復帰しない",
                "速度が0なら復帰する"
              ],
              "correct": 2,
              "feedback": [
                "比較は <= ではなく < です。同じ値では分岐に入りません。",
                "正解。しきい値より下へ落ちて初めて spawn_ への移動を試みます。",
                "ここの条件は位置と復帰設定です。速度による条件はありません。"
              ]
            },
            {
              "source": "Engine/src/gameplay/SceneSimulation.cpp  /  Advance",
              "code": "const float blend = respawned || settings.smoothing == 0\n    ? ",
              "after": "\n    : static_cast<float>(-std::expm1(\n          -double(settings.smoothing) * std::min(seconds, 0.1f)));",
              "blank": true,
              "prompt": "復帰した瞬間は追従先にすぐ合わせます。ここでブレンド係数をいくつにしますか？",
              "options": [
                "0.0f",
                "0.5f",
                "1.0f"
              ],
              "correct": 3,
              "feedback": [
                "差分に0を掛けると、これまでの値から動きません。",
                "差分の半分しか進まないため、即座に追従先へは合わせられません。",
                "正解。差分をすべて加えます。通常時は経過秒数に応じた補間係数を使います。"
              ]
            }
          ]
        }
      }
