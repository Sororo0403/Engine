        "state": {
          "entries": [
            {
              "label": "Editor / main.cpp",
              "path": "Editor/src/main.cpp",
              "topic": "Editorの起動入口",
              "explanation": "WinMain は Editor のウィンドウ名とサイズを設定して、CreateInitialScene を Engine::Run に渡します。エンジンの共通機能が準備されてから、ファクトリが EditorScene を作ります。",
              "follow": "WinMain → Engine::Run → CreateInitialScene → EditorScene のコンストラクタ。"
            },
            {
              "label": "Runtime / main.cpp",
              "path": "Runtime/src/main.cpp",
              "topic": "配布アプリの起動入口",
              "explanation": "WinMain は実行ファイルと同じフォルダから game.json を読みます。読み込んだタイトルと画面サイズを EngineConfig に写し、RuntimeScene を作る関数を Engine::Run に渡します。",
              "follow": "GameExportConfig::Load → Engine::Run → CreateScene。書き出し前後の設定は第11章。"
            },
            {
              "label": "Engine.h",
              "path": "Engine/include/core/Engine.h",
              "topic": "アプリから呼ぶエンジンのAPI",
              "explanation": "Engine::Run の引数には起動設定と SceneFactory が必要です。SceneFactory は EngineContext を受け取り、IScene を所有する unique_ptr を返す関数ポインタです。",
              "follow": "Engine::SceneFactory と Engine::Run の宣言を、Editor・Runtimeの main.cpp の呼び出しと照合。"
            },
            {
              "label": "Engine.cpp",
              "path": "Engine/src/core/Engine.cpp",
              "topic": "共通機能の初期化とメインループ",
              "explanation": "Run はログとCOMを準備し、Impl がウィンドウ・描画・入力・音声などを初期化します。MainLoop は入力、シーンの更新、描画の順に進めます。Impl の破棄時はGPUを待ってから解放します。",
              "follow": "Run → Impl::Initialize → Impl::MainLoop → Impl::~Impl の順に読む。"
            },
            {
              "label": "EngineConfig.h",
              "path": "Engine/include/core/EngineConfig.h",
              "topic": "アプリから渡す起動設定",
              "explanation": "ウィンドウ名とサイズ、ImGuiの初期化、低消費電力GPUの優先をまとめた設定です。EditorとRuntimeは同じ構造体を使い、それぞれの値を設定します。",
              "follow": "Editor と Runtime の WinMain で設定し、Engine::Impl::Initialize で使う。"
            },
            {
              "label": "EngineContext.h",
              "path": "Engine/include/core/EngineContext.h",
              "topic": "シーンへ渡す共通機能への参照",
              "explanation": "モデル、描画、入力、ImGui、音声にアクセスする参照をまとめます。機能本体は Engine::Impl が保持し、入力は const 参照で渡されます。",
              "follow": "Engine::Impl::Initialize で組み立て、SceneFactory へ渡す。"
            },
            {
              "label": "IScene.h",
              "path": "Engine/include/scene/IScene.h",
              "topic": "アプリのシーンに共通する契約",
              "explanation": "Initialize・Update・Draw・Finalize を仮想関数で定義します。Update の経過時間は秒です。RequestClose を実装すると、確認画面を出す間は終了を保留できます。",
              "follow": "EditorScene と RuntimeScene が実装し、SceneManager が各関数を呼ぶ。"
            },
            {
              "label": "SceneManager.h",
              "path": "Engine/include/scene/SceneManager.h",
              "topic": "現在のシーンと切り替え予約",
              "explanation": "現在のシーンと次のシーンを別々の unique_ptr で保持します。RequestChange で予約し、ApplyPendingChange を呼んだ時点で切り替えを試みます。",
              "follow": "currentScene_ と pendingScene_ の宣言を SceneManager.cpp の代入箇所と照合。"
            },
            {
              "label": "SceneManager.cpp",
              "path": "Engine/src/scene/SceneManager.cpp",
              "topic": "次のシーンが準備できたら切り替える",
              "explanation": "新しいシーンの Initialize が失敗した場合は、そのシーンを Finalize して失敗を返します。成功した場合は、現在のシーンを Finalize してから新しいシーンを引き継ぎます。",
              "follow": "RequestChange → ApplyPendingChange。予約中のシーンは Finalize でそのまま破棄する。"
            },
            {
              "label": "FrameTimer.h",
              "path": "Engine/include/core/FrameTimer.h",
              "topic": "フレーム間隔を測る時計",
              "explanation": "Clock は単調に進む steady_clock の別名です。前回の時刻を保持し、Tick で経過秒数を求めるために使います。",
              "follow": "FrameTimer.cpp の Tick と Engine::Impl::MainLoop の deltaTime を照合。"
            },
            {
              "label": "FrameTimer.cpp",
              "path": "Engine/src/core/FrameTimer.cpp",
              "topic": "前フレームからの秒数を返す",
              "explanation": "Tick は現在時刻と previousTime_ の差を秒に変えて返し、その時刻を次回用に保存します。最小化から戻るときに Reset すると、待機時間を次の更新に持ち込みません。",
              "follow": "Engine::Impl::MainLoop の frameTimer.Tick と frameTimer.Reset の呼び出しを追う。"
            },
            {
              "label": "DateTime.h",
              "path": "Engine/include/core/DateTime.h",
              "topic": "ログに使う時刻文字列のAPI",
              "explanation": "GetCurrentTimeString を宣言します。Logger はこの関数で現在のローカル時刻を文字列として受け取ります。",
              "follow": "Logger::Write → DateTime::GetCurrentTimeString。"
            },
            {
              "label": "DateTime.cpp",
              "path": "Engine/src/core/DateTime.cpp",
              "topic": "時刻を HH:MM:SS に変換する",
              "explanation": "system_clock の時刻を localtime_s でローカル時刻へ変換し、strftime で時・分・秒の文字列を作ります。どちらかが失敗すると空文字列を返します。",
              "follow": "GetCurrentTimeString の空文字列を返す2つの分岐を確認。"
            },
            {
              "label": "LogEntry.h",
              "path": "Engine/include/core/LogEntry.h",
              "topic": "Editorでも使うログの1件分",
              "explanation": "ログの識別子、重要度、時刻、メッセージ、素材などの参照元パスを持ちます。文字列だけでは拾いにくい情報も、Editor側で扱えます。",
              "follow": "Logger::Write の LogEntry の組み立てと Logger::ReadEntries を追う。"
            },
            {
              "label": "Logger.h",
              "path": "Engine/include/core/Logger.h",
              "topic": "ログの記録と読み出しのAPI",
              "explanation": "Info・Warning・Error を呼び分けて記録します。ReadEntries では更新番号を使ってログ一覧の変更を調べられます。Play中のエラーを取得する関数もあります。",
              "follow": "Logger.cpp の Write・ReadEntries・BeginPlayLog の実装へ。"
            },
            {
              "label": "Logger.cpp",
              "path": "Engine/src/core/Logger.cpp",
              "topic": "時刻付きのログを保存する",
              "explanation": "Write は時刻と重要度を付け、LogEntry を履歴に残し、ファイルとデバッガーへ出力します。Editorは読み出しAPIで更新番号やPlay中のエラーを取得します。",
              "follow": "Engine::Run の Initialize／Finalize と Logger::Write を追う。"
            }
          ]
        }
      }
    },
