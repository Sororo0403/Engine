        "state": {
          "entries": [
            {
              "label": "AxisAlignedBox.h",
              "path": "Engine/include/physics/AxisAlignedBox.h",
              "topic": "ワールド軸に沿う外接ボックス",
              "explanation": "最小点と最大点で、ワールド座標のX・Y・Z軸に平行な範囲を表します。回転を含む形状も、この範囲で候補を絞れます。",
              "follow": "ColliderUtils::GetWorldBounds が返す箱と実形状を比較。"
            },
            {
              "label": "BoxCollider.h",
              "path": "Engine/include/physics/BoxCollider.h",
              "topic": "旧コード用のCollider型名",
              "explanation": "BoxCollider は Collider の型エイリアスです。共通型の shape で箱・球・カプセルを区別できます。",
              "follow": "using BoxCollider = Collider。"
            },
            {
              "label": "BoxColliderUtils.h",
              "path": "Engine/include/physics/BoxColliderUtils.h",
              "topic": "旧コード用の名前空間エイリアス",
              "explanation": "BoxColliderUtils を ColliderUtils の別名にし、既存の呼び出し側から同じ実装を使えるようにします。",
              "follow": "namespace BoxColliderUtils = ColliderUtils。"
            },
            {
              "label": "Collider.h",
              "path": "Engine/include/physics/Collider.h",
              "topic": "物体のローカル衝突形状",
              "explanation": "形状の種類、ローカル中心、寸法、衝突設定を保持します。カプセルの halfHeight には端の半球を含めません。",
              "follow": "Shape と halfHeight、isTrigger の定義。"
            },
            {
              "label": "Collider.cpp",
              "path": "Engine/src/physics/Collider.cpp",
              "topic": "衝突形状の妥当性と寸法",
              "explanation": "IsValid は中心、寸法、レイヤーを検証します。GetHalfExtents では選んだ形状を囲むローカル範囲を求めます。",
              "follow": "IsValid と GetHalfExtents。"
            },
            {
              "label": "ColliderUtils.h",
              "path": "Engine/include/physics/ColliderUtils.h",
              "topic": "形状の調整・ワールド境界のAPI",
              "explanation": "頂点を囲む形状へ調整する関数と、親子合成後の外接範囲を計算する関数を公開します。",
              "follow": "FitToPoints と GetWorldBounds の引数。"
            },
            {
              "label": "ColliderUtils.cpp",
              "path": "Engine/src/physics/ColliderUtils.cpp",
              "topic": "モデルやシーンの変形から衝突境界を計算",
              "explanation": "FitToPoints で頂点を囲む中心と寸法を求めます。GetWorldBounds ではワールド変形を考慮して外接範囲を作ります。",
              "follow": "FitToPoints の形状別分岐、GetWorldBounds。"
            },
            {
              "label": "CollisionFilter.h",
              "path": "Engine/include/physics/CollisionFilter.h",
              "topic": "双方のマスクが認める接触だけを扱う",
              "explanation": "Colliderごとに所属レイヤーと、相手のどのレイヤーを許すかのビットマスクを持ちます。衝突には両方の許可が必要です。",
              "follow": "CanCollide の2つのビット判定。"
            },
            {
              "label": "ColliderCastHit.h",
              "path": "Engine/include/physics/ColliderCastHit.h",
              "topic": "移動中に最初に触れた位置と法線",
              "explanation": "移動距離のうち接触まで進んだ割合と、障害物から移動形状へ向く単位法線を保持します。",
              "follow": "WorldCollider の形状キャストが埋める値。"
            },
            {
              "label": "RaycastHit.h",
              "path": "Engine/include/physics/RaycastHit.h",
              "topic": "レイが最初に当たる結果",
              "explanation": "交点の座標や距離と対象の物体IDを返します。IDが0なら交点がありません。",
              "follow": "SceneRaycast::Prepared::Cast の結果設定。"
            },
            {
              "label": "RaycastOptions.h",
              "path": "Engine/include/physics/RaycastOptions.h",
              "topic": "レイに当たる候補を選ぶ",
              "explanation": "対象レイヤー、Triggerの許可、除外する物体IDを指定します。レイはCollider同士の相互マスクを使わず所属レイヤーを調べます。",
              "follow": "layerMask・includeTriggers・ignored。"
            },
            {
              "label": "SceneRaycast.h",
              "path": "Engine/include/physics/SceneRaycast.h",
              "topic": "シーンへレイや球を飛ばすAPI",
              "explanation": "レイとColliderの最短の交点を求めます。Prepared で同じシーンの変形と実効状態を共有できます。",
              "follow": "Prepared::Build と Cast、球を使う CastSphere。"
            },
            {
              "label": "SceneRaycast.cpp",
              "path": "Engine/src/physics/SceneRaycast.cpp",
              "topic": "形状ごとの交点と最短結果を求める",
              "explanation": "箱や丸い形状の交差を調べ、レイヤーなどの条件を通過した最も近い結果を返します。",
              "follow": "Prepared::Cast のフィルターから IntersectBox／IntersectRound へ。"
            },
            {
              "label": "WorldCollider.h",
              "path": "Engine/include/physics/WorldCollider.h",
              "topic": "剛体を作らずに共有できるワールド形状",
              "explanation": "シーンの衝突形状を変更不可のワールド形状に変換し、別形状との重なりや形状キャストを調べられます。",
              "follow": "Create・GetBounds・Overlaps。"
            },
            {
              "label": "WorldCollider.cpp",
              "path": "Engine/src/physics/WorldCollider.cpp",
              "topic": "Jolt形状を使って接触を問い合わせる",
              "explanation": "ローカル形状と親子合成後の変形から問い合わせ用の形状を作ります。外接範囲を使って候補を絞ってから形状を調べます。",
              "follow": "Create → BoundsCanMeet → Overlaps。"
            },
            {
              "label": "WorldColliderImpl.h",
              "path": "Engine/src/physics/WorldColliderImpl.h",
              "topic": "Joltの形状と寿命を内部で保持",
              "explanation": "形状、スケール、回転、中心、外接範囲を保持します。型登録の共有参照は形状より後で解放されます。",
              "follow": "Impl の registry と shape の宣言順。"
            }
          ]
        }
      }
    },
