            {
              "label": "Engineのライセンス",
              "path": "Engine/external/licenses",
              "topic": "出力へ付属するライセンスと通知",
              "explanation": "Engineのビルド後に外部ライブラリのライセンスを出力先へコピーします。GameExporter は配布フォルダにも licenses を配置します。",
              "follow": "Engine.vcxproj の PostBuildEvent → GameExporter の licenses の計画。"
            },
            {
              "label": "Editorのライセンス",
              "path": "Editor/external/licenses",
              "topic": "Editorが使うImGuizmoのライセンス",
              "explanation": "ImGuizmo用のライセンスを保持します。Editorのビルド後に実行用の licenses フォルダへコピーします。",
              "follow": "Editor.vcxproj の PostBuildEvent と imguizmo-LICENSE.txt。"
            },
            {
              "label": "M PLUS 1p Regular",
              "path": "Engine/resources/fonts/MPLUS1p-Regular.ttf",
              "topic": "日本語を含む標準の文字表示",
              "explanation": "ImGuiSystemが通常フォントとして選び、TextRasterizerも同梱フォントの一つとして読み込みます。配布時は resources/engine/fonts に含めます。",
              "follow": "ImGuiSystem::Initialize と TextRasterizer::Impl::LoadBundledFonts。"
            },
            {
              "label": "M PLUS 1p Bold",
              "path": "Engine/resources/fonts/MPLUS1p-Bold.ttf",
              "topic": "ゲーム画面の太字に使うフォント",
              "explanation": "TextRasterizer が通常書体と一緒に読み込みます。Canvasの太字設定やこの教材の見出しで使います。",
              "follow": "TextRasterizer のフォント読み込みと TextComponent の bold。"
            },
            {
              "label": "EditorのBoxモデル",
              "path": "Editor/resources/models/box.glb",
              "topic": "Editorの組み込みプリミティブ",
              "explanation": "PrimitiveObjects::CreateBox が参照するモデルです。Editorの出力先には resources/editor/models/box.glb として配置されます。",
              "follow": "第3章の PrimitiveObjects.cpp と Editor.vcxproj。"
            }
          ]
        }
      }
