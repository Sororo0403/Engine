        "state": {
          "entries": [
            {
              "label": "RenderObjectHandle.h",
              "path": "Engine/include/graphics/render/RenderObjectHandle.h",
              "topic": "描画物体を安全に特定する識別子",
              "explanation": "ワールドID、格納位置、世代を持ち、削除後に同じ位置を再利用した物体と区別します。",
              "follow": "RenderWorld がハンドルを作成・解決する箇所。"
            },
            {
              "label": "SceneRenderer.h",
              "path": "Engine/include/scene/SceneRenderer.h",
              "topic": "シーンデータを描画へ渡すAPI",
              "explanation": "シーンから物体を描画ワールドへ反映します。描画、境界の取得、デバッグ線の追加などの入口も持ちます。",
              "follow": "Initialize・Update・Draw と GetObjectBounds。"
            },
            {
              "label": "SceneRenderer.cpp",
              "path": "Engine/src/scene/SceneRenderer.cpp",
              "topic": "シーンから表示対象を取り出す",
              "explanation": "物体の有効状態と描画条件を確認して、描画ワールドの物体を作成・更新します。シーンのカメラや灯りも描画へ渡します。",
              "follow": "Update → SynchronizeObjects。描画対象は IsRenderable で確認。"
            },
            {
              "label": "RenderWorld.h",
              "path": "Engine/include/graphics/render/RenderWorld.h",
              "topic": "描画ワールド単位の状態",
              "explanation": "物体、カメラ、ライトなどをワールド単位で管理します。シーンのデータから描画に必要な姿勢や値を準備できます。",
              "follow": "Update と Draw、DrawShadows の分担。"
            },
            {
              "label": "RenderWorld.cpp",
              "path": "Engine/src/graphics/render/RenderWorld.cpp",
              "topic": "カメラと影の候補を別に判定",
              "explanation": "物体の境界をカメラの範囲と光源の範囲に対して別々に調べます。画面外の物体でも影に必要なら残ります。",
              "follow": "Update の可視性判定 → Draw／DrawShadows。"
            },
            {
              "label": "RenderSystem.h",
              "path": "Engine/include/graphics/render/RenderSystem.h",
              "topic": "描画先に応じた描画処理の入口",
              "explanation": "RenderWorld を作成して更新し、画面か RenderTexture に描画するAPIを提供します。",
              "follow": "CreateRenderTexture と Draw のオーバーロード。"
            },
            {
              "label": "RenderSystem.cpp",
              "path": "Engine/src/graphics/render/RenderSystem.cpp",
              "topic": "複数の描画処理を同じ描画先へ送る",
              "explanation": "ワールドの描画に加え、必要に応じて粒子やCanvasを描きます。Sceneビューなどには RenderTexture を使えます。",
              "follow": "Draw の画面向けと RenderTexture 向けを比較。"
            },
            {
              "label": "MeshRenderer.h",
              "path": "Engine/include/graphics/render/MeshRenderer.h",
              "topic": "メッシュ用の描画とシェーダー入力",
              "explanation": "描画コマンドや材質・光源との接続を提供します。カメラ位置と霧は MeshFogData でGPUへ渡します。",
              "follow": "Draw・DrawShadow と MeshFogData。"
            },
            {
              "label": "MeshRenderer.cpp",
              "path": "Engine/src/graphics/render/MeshRenderer.cpp",
              "topic": "頂点・定数・描画状態をまとめて送る",
              "explanation": "メッシュ用のパイプラインやルートシグネチャを作り、描画時に必要な定数やテクスチャを設定します。",
              "follow": "Initialize → Draw。影側は DrawShadow。"
            },
            {
              "label": "ParticleRenderer.h",
              "path": "Engine/include/graphics/render/ParticleRenderer.h",
              "topic": "カメラに向けた粒子の描画API",
              "explanation": "粒子の描画データと今回のカメラを受け取り、透明合成する粒子を描画します。",
              "follow": "Update と Draw に渡す描画情報。"
            },
            {
              "label": "ParticleRenderer.cpp",
              "path": "Engine/src/graphics/render/ParticleRenderer.cpp",
              "topic": "透明粒子を奥から並べる",
              "explanation": "粒子の順序をカメラから見た奥行きで決め、頂点側でカメラ向きの面を作るためのデータをGPUへ送ります。",
              "follow": "Update の描画順と Draw の命令を追う。"
            },
            {
              "label": "DebugLine.h",
              "path": "Engine/include/graphics/render/DebugLine.h",
              "topic": "ワールド座標で引く線のデータ",
              "explanation": "始点・終点と色を持ちます。グリッドや物体の境界などのデバッグ表示を表します。",
              "follow": "SceneRenderer::AddDebugLine と DebugLineBatch。"
            },
            {
              "label": "DebugLineVertex.h",
              "path": "Engine/include/graphics/render/DebugLineVertex.h",
              "topic": "デバッグ線の1頂点",
              "explanation": "線の描画に使う位置と色を頂点の形式にします。HLSL側で同じ要素を頂点入力にします。",
              "follow": "DebugLine.VS.hlsl の VertexInput。"
            },
            {
              "label": "DebugLineBatch.h",
              "path": "Engine/include/graphics/render/DebugLineBatch.h",
              "topic": "複数の線の頂点をまとめて保持",
              "explanation": "描画ワールドの線を頂点バッファにまとめ、まとめて描画できるようにします。",
              "follow": "Update の入力と頂点バッファ情報。"
            },
            {
              "label": "DebugLineBatch.cpp",
              "path": "Engine/src/graphics/render/DebugLineBatch.cpp",
              "topic": "線ごとの両端を連続した頂点へ変換",
              "explanation": "線を描画用の頂点に展開し、頂点バッファを更新します。",
              "follow": "Update が DebugLine から頂点を組み立てる箇所。"
            },
            {
              "label": "DebugLineRenderer.h",
              "path": "Engine/include/graphics/render/DebugLineRenderer.h",
              "topic": "デバッグ線をまとめて描くAPI",
              "explanation": "更新した線のデータを受け取り、描画コマンドへ反映します。",
              "follow": "Initialize と Draw、DebugLineBatch の使い方。"
            },
            {
              "label": "DebugLineRenderer.cpp",
              "path": "Engine/src/graphics/render/DebugLineRenderer.cpp",
              "topic": "バッチの頂点を線として描く",
              "explanation": "線描画用の状態を設定し、まとめた頂点を一度に描く命令を記録します。",
              "follow": "Draw の頂点バッファ、トポロジー、DrawInstanced。"
            }
          ]
        }
      }
    },
