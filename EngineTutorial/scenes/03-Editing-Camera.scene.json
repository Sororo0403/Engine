        "state": {
          "entries": [
            {
              "label": "CameraView.h",
              "path": "Editor/include/camera/CameraView.h",
              "topic": "Sceneカメラを軸方向へそろえる",
              "explanation": "上・正面・側面などの視点を列挙します。方向は対象をどのワールド軸側から見るかを表します。",
              "follow": "EditorCameraController::SetView に渡す方向。"
            },
            {
              "label": "EditorCameraController.h",
              "path": "Editor/include/camera/EditorCameraController.h",
              "topic": "作業用カメラの状態と操作設定",
              "explanation": "Sceneカメラの視点や投影、操作速度などを保持します。Update では入力が利用できる領域と経過時間を受け取ります。",
              "follow": "Settings と ViewState、Update・FrameBounds。"
            },
            {
              "label": "EditorCameraController.cpp",
              "path": "Editor/src/camera/EditorCameraController.cpp",
              "topic": "入力から視点を動かして構図を作る",
              "explanation": "Update は操作中のマウス移動やキーを使って作業視点を動かします。FrameBounds は対象範囲が画面内に収まるよう位置を決めます。",
              "follow": "Update では ViewportInput、FrameBounds では境界の投影を追う。"
            },
            {
              "label": "EditorCameraBookmarks.h",
              "path": "Editor/include/camera/EditorCameraBookmarks.h",
              "topic": "作業用のカメラを5枠に保存",
              "explanation": "作業カメラの位置・向き・投影設定を ViewState として保持し、指定した番号から取り出せます。",
              "follow": "Set・Get・Clear と ViewState。"
            },
            {
              "label": "EditorCameraBookmarks.cpp",
              "path": "Editor/src/camera/EditorCameraBookmarks.cpp",
              "topic": "ブックマークの枠と姿勢を検証",
              "explanation": "Set は指定枠と ViewState の有効性を確認してから保存します。Clear で個別の枠を空にできます。",
              "follow": "Set の検証と Get／Clear の枠番号の扱い。"
            },
            {
              "label": "CameraObjects.h",
              "path": "Editor/include/camera/CameraObjects.h",
              "topic": "作業視点からCamera物体を作るAPI",
              "explanation": "姿勢とレンズ設定から SceneObject を作り、呼び出し元へ返します。シーンへの登録は別の処理が行います。",
              "follow": "CreateFromView の optional の戻り値。"
            },
            {
              "label": "CameraObjects.cpp",
              "path": "Editor/src/camera/CameraObjects.cpp",
              "topic": "カメラ姿勢を物体のTransformへ反映",
              "explanation": "CreateFromView は設定を検証し、CameraComponent を持つ物体を作ります。姿勢の適用に失敗すると空の結果を返します。",
              "follow": "CreateFromView → SceneCameraUtils::ApplyPose。"
            },
            {
              "label": "CameraFrustum.h",
              "path": "Editor/include/camera/CameraFrustum.h",
              "topic": "カメラの視野をSceneビューに描く",
              "explanation": "選んだカメラの撮影範囲を線で示せます。カメラだけでなく、表示する画面の寸法も受け取ります。",
              "follow": "BuildLines と Update の引数。"
            },
            {
              "label": "CameraFrustum.cpp",
              "path": "Editor/src/camera/CameraFrustum.cpp",
              "topic": "投影範囲の角から線を作る",
              "explanation": "BuildLines はカメラの撮影範囲を世界座標の線に変換します。Update はその線を SceneRenderer に登録します。",
              "follow": "BuildLines → Update。"
            },
            {
              "label": "ObjectFrameBounds.h",
              "path": "Editor/include/camera/ObjectFrameBounds.h",
              "topic": "表示できる形状がない物体にも寄る",
              "explanation": "Frame操作に使う境界の角を求めます。物体の変形やColliderを利用する方法を提供します。",
              "follow": "Get の Scene を受け取るオーバーロード。"
            },
            {
              "label": "ObjectFrameBounds.cpp",
              "path": "Editor/src/camera/ObjectFrameBounds.cpp",
              "topic": "Colliderか物体原点を境界にする",
              "explanation": "Colliderがあればワールド境界を計算します。なければ原点を囲む小さなボックスを作り、その8頂点を返します。",
              "follow": "Get → ColliderUtils::GetWorldBounds と kOriginHalfExtent。"
            },
            {
              "label": "CameraInspector.h",
              "path": "Editor/include/camera/CameraInspector.h",
              "topic": "Cameraコンポーネントを編集するUI",
              "explanation": "Cameraの設定を表示・編集し、描画後に実行する視点操作の要求も扱います。",
              "follow": "Draw の EditorHistory と操作要求。"
            },
            {
              "label": "CameraInspector.cpp",
              "path": "Editor/src/camera/CameraInspector.cpp",
              "topic": "カメラ設定の編集を履歴へ渡す",
              "explanation": "投影などの編集値を扱い、EditorHistory を通じて変更します。Sceneカメラとゲーム用Cameraの操作も区別して要求します。",
              "follow": "Draw の BeginCamera・CommitEdit と視点操作の要求。"
            },
            {
              "label": "ColorTintInspector.h",
              "path": "Editor/include/appearance/ColorTintInspector.h",
              "topic": "モデルの元の色へ掛ける色の編集",
              "explanation": "物体に設定できる色を表示・編集するUIです。操作は履歴で戻せます。",
              "follow": "Draw の SceneObject と EditorHistory。"
            },
            {
              "label": "ColorTintInspector.cpp",
              "path": "Editor/src/appearance/ColorTintInspector.cpp",
              "topic": "色の変更を履歴付きで行う",
              "explanation": "Draw はモデルに掛ける色の編集を受け付け、物体への設定を EditorHistory に渡します。",
              "follow": "Draw で色の追加・変更を履歴へ渡す箇所。"
            },
            {
              "label": "TextureSlotInspector.h",
              "path": "Editor/include/appearance/TextureSlotInspector.h",
              "topic": "スロットごとの画像とUVを編集する",
              "explanation": "モデルの画像スロットへの割り当てや、物体のUV調整を表示して編集します。",
              "follow": "Draw の ModelManager・AssetDatabase・EditorHistory。"
            },
            {
              "label": "TextureSlotInspector.cpp",
              "path": "Editor/src/appearance/TextureSlotInspector.cpp",
              "topic": "画像の割り当てとUV編集を処理",
              "explanation": "モデルのスロットを参照して画像候補を扱い、画像やUVの変更を履歴へ渡します。",
              "follow": "Draw 内のスロット表示から履歴への反映まで。"
            }
          ]
        }
      }
    },
