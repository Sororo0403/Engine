        "state": {
          "entries": [
            {
              "label": "GameActionBinding.h",
              "path": "Engine/include/gameplay/GameActionBinding.h",
              "topic": "一つの操作名を複数の機器へ割り当てる",
              "explanation": "キー、マウス、パッドのボタンと軸、Wiiリモコンを同じ操作名で設定できます。文字列と各選択肢の対応も持ちます。",
              "follow": "GamepadAxis・WiiRemoteInput と各機器の選択肢。"
            },
            {
              "label": "GameActionBinding.cpp",
              "path": "Engine/src/gameplay/GameActionBinding.cpp",
              "topic": "名前と割り当てを検証",
              "explanation": "有効なUTF-8の名前と対応する入力かを調べ、同じ名前の定義を重複して受け付けません。",
              "follow": "IsValidName・IsValid と UsesKey。"
            },
            {
              "label": "GameActionState.h",
              "path": "Engine/include/gameplay/GameActionState.h",
              "topic": "名前付き操作のフレーム結果",
              "explanation": "継続中か、押した瞬間か、離した瞬間か、入力の強さを保持します。複数の機器の強さは最大値を使います。",
              "follow": "GameActionReader::Read で GameActionState を作る箇所。"
            },
            {
              "label": "GameActionState.cpp",
              "path": "Engine/src/gameplay/GameActionState.cpp",
              "topic": "押下と解放の矛盾を検出",
              "explanation": "名前の重複や押下と解放が同時に成立する状態を拒否します。入力の強さは有限で0から1の範囲である必要があります。",
              "follow": "IsValid の pressed・released・down の条件。"
            },
            {
              "label": "GameActionReader.h",
              "path": "Engine/include/gameplay/GameActionReader.h",
              "topic": "機器をまたいだ押下履歴を保つ",
              "explanation": "EditorのPlayと配布ゲームが同じ Read を使います。開始直後や再接続では、一度離すまで入力を許可しない状態を保持します。",
              "follow": "Read の enabled／pointerEnabled と History::blocked。"
            },
            {
              "label": "GameActionReader.cpp",
              "path": "Engine/src/gameplay/GameActionReader.cpp",
              "topic": "軸の揺れを抑え、入力を合成する",
              "explanation": "軸は0.6以上で押下、0.4以下で解放します。複数機器のどれかが押され続けている間は、操作全体の押下を重複させません。",
              "follow": "AxisValue、axisDown、states_.push_back の押下条件。"
            },
            {
              "label": "GameInputBindings.h",
              "path": "Engine/include/gameplay/GameInputBindings.h",
              "topic": "移動・ジャンプに使う基本キーを設定",
              "explanation": "移動とジャンプなどの標準操作を持ち、設定ファイル用のキー名と列挙値を相互に変換します。",
              "follow": "kActions と GetName・FromName・IsValid。"
            },
            {
              "label": "CharacterInputReader.h",
              "path": "Engine/include/gameplay/CharacterInputReader.h",
              "topic": "カメラ方向に合わせて移動入力を作る",
              "explanation": "キーとゲームパッドから移動・ジャンプを読み、カメラを渡された場合は水平方向の視線に合わせて移動を変換します。",
              "follow": "Read の movementCamera 分岐と forwardX／forwardZ。"
            },
            {
              "label": "ViewportInput.h",
              "path": "Engine/include/graphics/ui/ViewportInput.h",
              "topic": "画像上でのポインター操作の状態",
              "explanation": "フォーカスや画像上の位置、ボタン状態をまとめます。画像内の位置は左上が0、右下が1の座標です。",
              "follow": "EditorCameraController::Update が受け取る ViewportInput。"
            },
            {
              "label": "UIInputReader.h",
              "path": "Engine/include/ui/UIInputReader.h",
              "topic": "共通入力をゲーム内UIへ渡すAPI",
              "explanation": "描画サイズやフォーカスを受け取り、決定・選択移動やポインターをUIInputに変換する関数です。",
              "follow": "Read の enabled と navigationEnabled。"
            },
            {
              "label": "UIInputReader.cpp",
              "path": "Engine/src/ui/UIInputReader.cpp",
              "topic": "ウィンドウ内の位置を比率に変換",
              "explanation": "Read はマウスのクライアント座標からUIで使う正規化座標を作ります。キーボードやパッドから選択移動・決定も受け取ります。",
              "follow": "Read の描画寸法による座標変換と入力の合成。"
            }
          ]
        }
      }
    },
