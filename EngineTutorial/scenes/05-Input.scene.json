        "state": {
          "questions": [
            {
              "source": "Engine/src/input/Keyboard.cpp  /  IsPressed",
              "code": "return keys_[index] && !previousKeys_[index];",
              "prompt": "あるキーを押したまま次のフレームに進みました。2フレーム目の IsPressed は何を返しますか？",
              "options": [
                "true",
                "false",
                "キー番号"
              ],
              "correct": 2,
              "feedback": [
                "前回も押されているので、!previousKeys_ が false です。",
                "正解。押し始めたフレームだけ true です。長押しの判定には IsDown を使います。",
                "戻り値は押し始めたかを示す bool です。キー番号は配列を引くために使います。"
              ]
            },
            {
              "source": "Engine/src/input/InputSystem.cpp  /  Update",
              "code": "if (!state.active) {\n    keyboard_.Reset();\n    mouse_.Reset();\n    gamepad_.Reset();\n    return true;\n}",
              "prompt": "バックエンドが非アクティブを返しました。前のフレームのキー状態はどうなりますか？",
              "options": [
                "入力状態をクリアする",
                "最後の押下を保持する",
                "更新失敗として終了する"
              ],
              "correct": 1,
              "feedback": [
                "正解。入力をクリアして true を返します。フォーカスが外れたときの押しっぱなしを防ぎます。",
                "Reset は現在と前回の入力をクリアします。押下状態は持ち越しません。",
                "非アクティブは正常な状態なので true です。取得エラーでは別の分岐で false を返します。"
              ]
            },
            {
              "source": "Engine/src/gameplay/GameActionReader.cpp  /  Read",
              "code": "const bool remoteConnected =\n    wiiRemote && wiiRemote->connected;\n\n// raw 配列の Wii リモコンの要素\nremoteConnected &&\n    ((binding.wiiRemote == WiiInput::A && wiiRemote->aDown) ||\n     (binding.wiiRemote == WiiInput::SHAKE && wiiRemote->shake))",
              "prompt": "アクションに Wii リモコンの A を割り当てました。接続中に振っただけで、この割り当ては反応しますか？",
              "options": [
                "振れば反応する",
                "接続した時点で反応する",
                "Aを押さない限り反応しない"
              ],
              "correct": 3,
              "feedback": [
                "振りに反応するのは SHAKE の割り当てです。",
                "接続は入力を読む前提です。A ボタンの状態も確認します。",
                "正解。A と SHAKE は別々の割り当てです。同じ名前の操作へ他デバイスの入力も割り当てられます。"
              ]
            },
            {
              "source": "Engine/src/gameplay/GameActionReader.cpp  /  Read",
              "code": "const bool axisDown = h.held[axisIndex] ||\n                      h.blocked[axisIndex]\n    ? strength > releaseThreshold\n    : strength >= pressThreshold;",
              "prompt": "軸の押下は0.6、解放は0.4が境界です。0.7で押下した後、0.5まで戻すとどうなりますか？",
              "options": [
                "解放扱いになる",
                "押下状態を保つ",
                "もう一度押した扱いになる"
              ],
              "correct": 2,
              "feedback": [
                "すでに押下中なので、解放側の閾値0.4で判定します。",
                "正解。0.5は解放閾値より上です。判定の切り替わり付近で入力がちらつくのを抑えます。",
                "押下状態が続いています。新しい押下の瞬間は作りません。"
              ]
            },
            {
              "source": "Engine/src/gameplay/GameActionReader.cpp  /  Read",
              "code": "states_.push_back({binding.name, down,\n                   ",
              "after": ",\n                   !down && h.down && !cancelled, value});",
              "blank": true,
              "prompt": "第3フィールドには、このアクションを押し始めた瞬間を入れます。どの式ですか？",
              "options": [
                "down && h.down",
                "!down && h.down",
                "down && !h.down"
              ],
              "correct": 3,
              "feedback": [
                "今回も前回も押されています。長押しの次フレームまで反応してしまいます。",
                "前回押されて今回押されていないので、押下ではなく解放側の条件です。",
                "正解。前回は押されず、今回初めて押されました。複数の割り当てをまとめた後で判定します。"
              ]
            }
          ]
        }
      }
