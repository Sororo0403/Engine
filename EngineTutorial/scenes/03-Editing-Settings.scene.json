        "state": {
          "entries": [
            {
              "label": "EditorScene.h",
              "path": "Editor/include/scene/EditorScene.h",
              "topic": "Editorの各機能をまとめるIScene",
              "explanation": "パネルや編集シーン、試遊状態を保持し、IScene の起動・更新・描画・終了に接続します。",
              "follow": "Initialize・Update・Draw・Finalize の宣言。"
            },
            {
              "label": "EditorScene.cpp",
              "path": "Editor/src/scene/EditorScene.cpp",
              "topic": "UIの要求を編集・試遊・描画に振り分ける",
              "explanation": "Update でパネルや選択を扱います。UpdateDialogs がファイル操作などの結果を受け、RequestClose では編集内容に応じて終了を保留します。",
              "follow": "Update → UpdateDialogs。終了側は RequestClose → Finalize。"
            },
            {
              "label": "BoxCreationSettings.h",
              "path": "Editor/include/scene/BoxCreationSettings.h",
              "topic": "新しいBoxの実寸と中心を保持",
              "explanation": "作成する名前、ワールド座標の中心、各軸の寸法をまとめます。入力画面から物体を作る処理への受け渡しに使います。",
              "follow": "BoxCreationDialog → PrimitiveObjects::TryCreateBox。"
            },
            {
              "label": "PrimitiveObjects.h",
              "path": "Editor/include/scene/PrimitiveObjects.h",
              "topic": "組み込みのBox物体を作るAPI",
              "explanation": "既定のBox、またはモデルのローカル範囲から指定した実寸のBoxを作ります。戻り値のデータを別途シーンへ登録します。",
              "follow": "CreateBox と TryCreateBox の違い。"
            },
            {
              "label": "PrimitiveObjects.cpp",
              "path": "Editor/src/scene/PrimitiveObjects.cpp",
              "topic": "モデルの寸法とColliderがそろうBoxを作る",
              "explanation": "既定のBoxには組み込みモデルと一致するColliderが入ります。指定寸法の作成では、元のモデルの境界から拡大率と位置を計算します。",
              "follow": "CreateBox と TryCreateBox の計算。"
            },
            {
              "label": "SceneGrid.h",
              "path": "Editor/include/scene/SceneGrid.h",
              "topic": "グリッド線の間隔や作業平面を指定",
              "explanation": "間隔・セル数・強調線の周期・平面の高さを保持します。Update はSceneビューの線の描画を登録します。",
              "follow": "Settings・SetSettings・Update。"
            },
            {
              "label": "SceneGrid.cpp",
              "path": "Editor/src/scene/SceneGrid.cpp",
              "topic": "Sceneビュー用にグリッド線を配置",
              "explanation": "線間隔と高さを設定から読み、グリッドと原点を通る座標軸を描画へ登録します。",
              "follow": "Update の線を並べる処理と中心軸の分岐。"
            },
            {
              "label": "SceneObjects.h",
              "path": "Editor/include/scene/SceneObjects.h",
              "topic": "選択の切り出しと別シーンからの追加",
              "explanation": "Capture は選択した階層をシーンデータにまとめます。Append は別シーンの物体を追加し、操作を履歴にまとめます。",
              "follow": "Capture と Append の引数を比較。"
            },
            {
              "label": "SceneObjects.cpp",
              "path": "Editor/src/scene/SceneObjects.cpp",
              "topic": "コピーの参照を整理して追加する",
              "explanation": "Capture は範囲外への参照を外し、保存可能なデータか検証してから結果を置き換えます。Append で履歴付きの物体追加へ渡します。",
              "follow": "Capture → DetachExternalReferences。Append → EditorHistory::CreateObjects。"
            },
            {
              "label": "EditorPreferences.h",
              "path": "Editor/include/settings/EditorPreferences.h",
              "topic": "エディター専用の設定と復元情報",
              "explanation": "画面表示や操作の好み、シーンごとの視点と選択、出力設定などを保持します。",
              "follow": "Load・Save と RememberSceneView。"
            },
            {
              "label": "EditorPreferences.cpp",
              "path": "Editor/src/settings/EditorPreferences.cpp",
              "topic": "プロジェクトやシーンの状態を保存・復元",
              "explanation": "Load は設定を読み、Save は一時ファイルを使って置き換えます。RememberSceneView や RememberProjectScene で、再び開くときに使う状態を記録します。",
              "follow": "RememberProjectScene → LastProjectScene。別のシーンへは CopySceneViewAndSelection。"
            },
            {
              "label": "RecentScenes.h",
              "path": "Editor/include/settings/RecentScenes.h",
              "topic": "最近使用したシーンを順に保つAPI",
              "explanation": "最近使ったシーンの絶対パスを新しい順に管理します。消えたパスの整理やプロジェクト移動にも対応します。",
              "follow": "Add・GetPaths・FollowProjectMove。"
            },
            {
              "label": "RecentScenes.cpp",
              "path": "Editor/src/settings/RecentScenes.cpp",
              "topic": "重複を除いて最近使ったシーンを先頭に置く",
              "explanation": "Add はパスを解決し、重複する項目を外して先頭へ移します。多すぎる場合は末尾を切って件数をそろえます。",
              "follow": "Add の erase・insert・resize。"
            }
          ]
        }
      }
    },
