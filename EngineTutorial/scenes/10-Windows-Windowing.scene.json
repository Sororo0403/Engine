        "state": {
          "entries": [
            {
              "label": "Window.h",
              "path": "Engine/include/platform/windows/Window.h",
              "topic": "Win32ウィンドウの寿命とイベント",
              "explanation": "ネイティブウィンドウの作成・破棄と、サイズや閉じる要求を管理するインターフェースです。",
              "follow": "Create・Destroy・ConsumeCloseRequest。"
            },
            {
              "label": "Window.cpp",
              "path": "Engine/src/platform/windows/Window.cpp",
              "topic": "閉じる要求を保存し、ループへ渡す",
              "explanation": "WM_SIZEで寸法を更新し、WM_CLOSEでは閉じる要求を記録します。破棄側のWM_DESTROYは終了の通知を送ります。",
              "follow": "ウィンドウプロシージャの WM_CLOSE／WM_DESTROY と ConsumeCloseRequest。"
            },
            {
              "label": "WinApp.h",
              "path": "Engine/include/platform/windows/WinApp.h",
              "topic": "WindowとEngineの間の窓口",
              "explanation": "ウィンドウを所有し、フレームでのメッセージ処理やサイズ・タイトルの操作を公開します。",
              "follow": "ProcessMessages・SetTitle・GetWidth。"
            },
            {
              "label": "WinApp.cpp",
              "path": "Engine/src/platform/windows/WinApp.cpp",
              "topic": "キュー内のメッセージをさばく",
              "explanation": "ProcessMessages はたまったメッセージを取得し、必要に応じて各処理へ渡します。WM_QUITで更新ループを終える結果を返します。",
              "follow": "ProcessMessages の PeekMessageW・DispatchMessageW・WM_QUIT。"
            },
            {
              "label": "StringConversion.h",
              "path": "Engine/include/platform/windows/StringConversion.h",
              "topic": "UTF-8とWindows文字列を変換するAPI",
              "explanation": "エンジン側の文字列とWin32 APIやファイルパスで使うワイド文字列の相互変換を公開します。",
              "follow": "Utf8ToWide と WideToUtf8。"
            },
            {
              "label": "StringConversion.cpp",
              "path": "Engine/src/platform/windows/StringConversion.cpp",
              "topic": "文字数を確認してから変換する",
              "explanation": "Windowsの文字列変換APIで必要なサイズを求めてから変換します。不正なUTF-8は空の文字列として返します。",
              "follow": "Utf8ToWide の MultiByteToWideChar とフラグ。"
            }
          ]
        }
      }
    },
