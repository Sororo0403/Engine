        "state": {
          "entries": [
            {
              "label": "WindowsInputBackend.h",
              "path": "Engine/include/platform/windows/WindowsInputBackend.h",
              "topic": "GameInputをWindows入力へつなぐ",
              "explanation": "集約キーボードとマウスの機器情報を持ちます。Wiiリモコンは別のオブジェクトから読み、同じ InputState へまとめます。",
              "follow": "IInputBackend の実装と WindowsWiiRemote のメンバー。"
            },
            {
              "label": "WindowsInputBackend.cpp",
              "path": "Engine/src/platform/windows/WindowsInputBackend.cpp",
              "topic": "各機器の状態を共通形式へ変換",
              "explanation": "GameInput v4からキーボード・マウス・ゲームパッドの値を読みます。累積マウス値は前回との差にし、フォーカスを外したら差分の基準もリセットします。",
              "follow": "Initialize の CreateAggregateDevice → Update → ReadMouse。"
            },
            {
              "label": "WiiRemotePairing.h",
              "path": "Engine/include/platform/windows/WiiRemotePairing.h",
              "topic": "Bluetoothペアリングの入口",
              "explanation": "赤いSYNCボタンで待機中のWiiリモコンを登録する関数です。検索・認証に時間がかかるためUIスレッドの外から使います。",
              "follow": "WiiRemotePairing::Pair → Editor側の呼び出し。"
            },
            {
              "label": "WiiRemotePairing.cpp",
              "path": "Engine/src/platform/windows/WiiRemotePairing.cpp",
              "topic": "WindowsのBluetoothで接続を登録",
              "explanation": "アダプターと機器を検索し、Bluetooth認証とHIDサービスの有効化を行います。処理結果は文字列で返します。",
              "follow": "Pair と BluetoothAuthenticateDevice、BluetoothSetServiceState。"
            },
            {
              "label": "WindowsWiiRemote.h",
              "path": "Engine/include/platform/windows/WindowsWiiRemote.h",
              "topic": "ペアリング済みのHIDを読むAPI",
              "explanation": "Windowsが認識したWiiリモコンを読み取り、Update の結果で接続と入力状態を渡します。",
              "follow": "Update・ReadReports・Close。"
            },
            {
              "label": "WindowsWiiRemote.cpp",
              "path": "Engine/src/platform/windows/WindowsWiiRemote.cpp",
              "topic": "レポートからAボタンと振りを取り出す",
              "explanation": "HIDレポートを読み、Aのビットと加速度を取り出します。緩やかな傾きには基準を追従させ、急な変化で振りを検出します。",
              "follow": "Open のHID検索 → ReadReport の motionSquared と閾値。"
            },
            {
              "label": "WiiRemoteState.h",
              "path": "Engine/include/input/WiiRemoteState.h",
              "topic": "Wiiリモコン入力の最小単位",
              "explanation": "1台目の接続、Aボタン、振りを保持します。shake は検出したフレームだけ真になります。",
              "follow": "WindowsWiiRemote::Update → GameActionReader::Read。"
            }
          ]
        }
      }
    },
