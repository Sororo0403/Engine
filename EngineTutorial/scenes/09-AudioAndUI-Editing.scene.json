          "entries": [
            {
              "label": "SceneUISerializer.h",
              "path": "Engine/src/scene/SceneUISerializer.h",
              "topic": "UIコンポーネントをシーンに保存するAPI",
              "explanation": "UIの設定を物体のJSONへ書き込み、形式の版に応じて値を検証しながら読み込みます。",
              "follow": "Write と Read の引数。"
            },
            {
              "label": "SceneUISerializer.cpp",
              "path": "Engine/src/scene/SceneUISerializer.cpp",
              "topic": "UIとAnimation Clipの読み書き",
              "explanation": "Canvas、文字、ボタンなどの保存値を扱います。クリップアセットの保存と割り当て枠の解決もこのファイルにあります。",
              "follow": "Write／Read と AnimationClipAsset::Save／Resolve。"
            },
            {
              "label": "UIObjects.h",
              "path": "Editor/include/ui/UIObjects.h",
              "topic": "必要なCanvasとUI物体を一緒に作る",
              "explanation": "文字や画像を置くとき、必要なCanvasも含めて1操作で作るAPIです。",
              "follow": "Create の Scene と EditorHistory。"
            },
            {
              "label": "UIObjects.cpp",
              "path": "Editor/src/ui/UIObjects.cpp",
              "topic": "UIの新規作成を履歴付きでシーンへ追加",
              "explanation": "必要な親やコンポーネントを準備して、CanvasやUIの物体を追加します。",
              "follow": "Create で親と追加する物体を組み立てる箇所。"
            },
            {
              "label": "UIInspector.h",
              "path": "Editor/include/ui/UIInspector.h",
              "topic": "UIの配置や表示を画面から編集",
              "explanation": "Canvas・Rect Transform・Text・Image・Buttonを編集し、連続操作を1回の編集として扱う入口です。",
              "follow": "Draw と DrawReadOnly。"
            },
            {
              "label": "UIInspector.cpp",
              "path": "Editor/src/ui/UIInspector.cpp",
              "topic": "入力開始から確定までを履歴と結ぶ",
              "explanation": "各コンポーネントの変更を画面で受け付け、編集開始、値の変更、確定を履歴へ渡します。",
              "follow": "Draw のフィールド編集と履歴の接続。"
            }
          ]
        }
      }
