        "state": {
          "entries": [
            {
              "label": "EditorSelection.h",
              "path": "Editor/include/selection/EditorSelection.h",
              "topic": "選択した順序を管理",
              "explanation": "物体IDの選択順を保持します。フォーカスの基準になるアクティブ物体は、現在選択中の最後の1件です。",
              "follow": "GetIds と GetActiveId。"
            },
            {
              "label": "EditorSelection.cpp",
              "path": "Editor/src/selection/EditorSelection.cpp",
              "topic": "選択内容を安全に更新",
              "explanation": "SelectOnly は選択を1件にし、Toggle は選択の有無を反転します。RemoveMissing でシーンに存在しないIDを取り除きます。",
              "follow": "Toggle と RemoveMissing の後に GetActiveId を確認。"
            },
            {
              "label": "EditorClipboard.h",
              "path": "Editor/include/selection/EditorClipboard.h",
              "topic": "編集用クリップボードの独立した内容",
              "explanation": "物体一式、変形やCollider、カメラのレンズなどを別々に保持します。コピーする項目によって別の項目を書き換えずに済みます。",
              "follow": "Copy と CopyTransform、CopyCameraLens の引数を比較。"
            },
            {
              "label": "EditorClipboard.cpp",
              "path": "Editor/src/selection/EditorClipboard.cpp",
              "topic": "親子を含めてコピーする",
              "explanation": "Copy は子孫も親から先に保存します。コピー範囲外の親はワールド変形を保って解除し、複製元IDも同じ順で保持します。",
              "follow": "Copy から GetObjects／GetSourceIds を追う。"
            },
            {
              "label": "ObjectMarkers.h",
              "path": "Editor/include/selection/ObjectMarkers.h",
              "topic": "メッシュのない物体を見つける",
              "explanation": "空の物体やモデルが読めない物体の位置を、Sceneビューで原点の目印として描きます。Pick はレイと目印の交差で選択します。",
              "follow": "GetBounds・BuildLines・Pick の役割を比較。"
            },
            {
              "label": "ObjectMarkers.cpp",
              "path": "Editor/src/selection/ObjectMarkers.cpp",
              "topic": "レイで手前の目印を選ぶ",
              "explanation": "Pick はモデルより手前で一番近い目印を選びます。同じ距離では小さいIDを優先し、選択結果を一定にします。",
              "follow": "Pick の距離比較と、Update が線を登録する箇所。"
            },
            {
              "label": "SelectionBounds.h",
              "path": "Editor/include/selection/SelectionBounds.h",
              "topic": "選択中の物体に外接ボックスを表示",
              "explanation": "描画用の外接ボックスを囲む12本の線を SceneRenderer に登録するインターフェースです。",
              "follow": "Update を EditorScene の補助描画から追う。"
            },
            {
              "label": "SelectionBounds.cpp",
              "path": "Editor/src/selection/SelectionBounds.cpp",
              "topic": "モデルの境界から線を作る",
              "explanation": "選択物体の範囲をレンダラーから取得し、辺を線の描画として登録します。選択を示す補助表示はメッシュ本体と別に扱えます。",
              "follow": "Update の範囲の取得と線の登録。"
            },
            {
              "label": "SelectionFrustum.h",
              "path": "Editor/include/selection/SelectionFrustum.h",
              "topic": "ドラッグした矩形を3Dの選択範囲へ",
              "explanation": "カメラのビューと投影、画面上の選択矩形から範囲を作り、ワールド座標にある外接ボックスとの交差を調べるAPIです。",
              "follow": "Initialize → Intersects。"
            },
            {
              "label": "SelectionFrustum.cpp",
              "path": "Editor/src/selection/SelectionFrustum.cpp",
              "topic": "ドラッグ選択の交差判定",
              "explanation": "Initialize は画面矩形をカメラの座標変換と組み合わせます。Intersects がその範囲に入る外接ボックスを判定します。",
              "follow": "Initialize で範囲を作る数式と Intersects の判定。"
            },
            {
              "label": "SelectionMeasurement.h",
              "path": "Editor/include/selection/SelectionMeasurement.h",
              "topic": "原点間距離と衝突形状の測定結果",
              "explanation": "複数選択の衝突形状をまとめた範囲や、2物体の原点間距離・Colliderのすき間を表します。",
              "follow": "Result と Pair、表示側の SelectionMeasurementsPanel。"
            },
            {
              "label": "SelectionMeasurement.cpp",
              "path": "Editor/src/selection/SelectionMeasurement.cpp",
              "topic": "選択した物体の配置を測る",
              "explanation": "親子合成後の座標で原点と衝突形状を測り、2物体の原点が離れていれば Sceneビューに引く線を組み立てます。",
              "follow": "Measure → BuildLine → AppendLine。"
            },
            {
              "label": "SelectionPivot.h",
              "path": "Editor/include/selection/SelectionPivot.h",
              "topic": "複数選択の支点を選ぶ",
              "explanation": "全選択の中央を使う CENTER と、最後に選んだ物体を使う ACTIVE を定義します。戻り値の Transform はギズモの支点になります。",
              "follow": "Mode と Make → TransformGizmo。"
            },
            {
              "label": "SelectionPivot.cpp",
              "path": "Editor/src/selection/SelectionPivot.cpp",
              "topic": "支点をワールド座標で求める",
              "explanation": "CENTER は各物体の原点の平均です。ACTIVE はアクティブ物体の原点を使います。どちらも親子合成後の位置から求めます。",
              "follow": "Make の SceneHierarchy::GetWorldTransform と座標の合計。"
            },
            {
              "label": "TransformGizmo.h",
              "path": "Editor/include/gizmo/TransformGizmo.h",
              "topic": "ギズモの設定と編集結果",
              "explanation": "移動・回転・拡縮、座標系、スナップ、支点の設定を管理します。Result は変形の変更と選択を止めるべき状態を返します。",
              "follow": "Draw の Result → EditorScene のドラッグ処理。"
            },
            {
              "label": "TransformGizmo.cpp",
              "path": "Editor/src/gizmo/TransformGizmo.cpp",
              "topic": "ImGuizmoの操作を編集へつなぐ",
              "explanation": "Scene画像の矩形とカメラ行列を ImGuizmo に渡します。ドラッグ中やギズモ上では、背後の物体を選択しないよう結果にフラグを立てます。",
              "follow": "BeginFrame と Draw の ImGuizmo::Manipulate、blocksSelection。"
            },
            {
              "label": "ImGuizmo.vcxproj",
              "path": "Editor/external/imguizmo/ImGuizmo.vcxproj",
              "topic": "ImGuizmoをEditorへリンクする設定",
              "explanation": "Editorがプロジェクト参照し、外部のImGuizmo.cppを別プロジェクトでビルドします。ImGuizmoにはEngine側のDear ImGuiヘッダーを使います。",
              "follow": "Editor.vcxproj の ProjectReference → TransformGizmo::BeginFrame。"
            }
          ]
        }
      }
    },
