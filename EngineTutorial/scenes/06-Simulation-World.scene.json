        "state": {
          "entries": [
            {
              "label": "CollisionWorld.h",
              "path": "Engine/include/physics/CollisionWorld.h",
              "topic": "固体に対する移動や滑りを調べる",
              "explanation": "静的な障害物を保持します。配置できるか、一方向に動かすといつ触れるか、滑った結果どこまで進めるかを調べられます。",
              "follow": "CanPlace・Sweep・Move の違い。"
            },
            {
              "label": "CollisionWorld.cpp",
              "path": "Engine/src/physics/CollisionWorld.cpp",
              "topic": "移動を止める面と残り移動を処理",
              "explanation": "Rebuild は実効状態やColliderを見て候補を構成します。MoveAlongSurfaces は接触を反映しながら移動を進めます。",
              "follow": "Rebuild → Sweep → MoveAlongSurfaces。"
            },
            {
              "label": "CollisionMoveResult.h",
              "path": "Engine/include/physics/CollisionMoveResult.h",
              "topic": "衝突で調整された移動量と接地状態",
              "explanation": "実際に進む変位と、地面・天井・壁の接触フラグを返します。",
              "follow": "displacement・grounded・hitCeiling・hitWall。"
            },
            {
              "label": "CollisionSweepResult.h",
              "path": "Engine/include/physics/CollisionSweepResult.h",
              "topic": "直線移動で最初に発生する接触",
              "explanation": "Sweep の結果を表す型です。移動形状が障害物に触れる情報を持ち、接触後の滑りは別の処理が行います。",
              "follow": "CollisionWorld::Sweep と Move の戻り値を比較。"
            },
            {
              "label": "CollisionContact.h",
              "path": "Engine/include/physics/CollisionContact.h",
              "topic": "通常の接触をIDの組で表す",
              "explanation": "Trigger以外の接触について小さいIDから順に保持します。順序を決めることで集合で重複を扱えます。",
              "follow": "first・second と既定の比較演算子。"
            },
            {
              "label": "CollisionEvent.h",
              "path": "Engine/include/physics/CollisionEvent.h",
              "topic": "通常の接触開始・継続・終了",
              "explanation": "接触した物体の組と ENTER／STAY／EXIT を保持します。通常のCollider接触をゲーム側へ通知する型です。",
              "follow": "CollisionEvents::Update が設定する Type。"
            },
            {
              "label": "CollisionEvents.h",
              "path": "Engine/include/physics/CollisionEvents.h",
              "topic": "前回と今回の接触を比べるAPI",
              "explanation": "1ゲームフレーム分の通常接触のイベントを保持します。物理ワールドと移動時の衝突も入力にできます。",
              "follow": "Update の world と impacts。"
            },
            {
              "label": "CollisionEvents.cpp",
              "path": "Engine/src/physics/CollisionEvents.cpp",
              "topic": "接触集合を比較して通知を作る",
              "explanation": "前回と今回の接触を比較し、継続か新規か終了かを決めます。フレーム内の衝突だけが残る場合も通知します。",
              "follow": "Update の current・contacts_・impacts の比較。"
            },
            {
              "label": "TriggerContact.h",
              "path": "Engine/include/physics/TriggerContact.h",
              "topic": "Triggerを含む2物体の組",
              "explanation": "少なくとも片方がTriggerの接触を表します。組はID順に並び、同じ接触を同じ鍵として扱えます。",
              "follow": "TriggerWorld が作る接触の組。"
            },
            {
              "label": "TriggerEvent.h",
              "path": "Engine/include/physics/TriggerEvent.h",
              "topic": "Triggerへの入場・滞在・退出",
              "explanation": "接触の組とイベント種別を持ちます。IDを保持するため、相手が削除された後の退出も識別できます。",
              "follow": "Type と contact を TriggerWorld::Update で確認。"
            },
            {
              "label": "TriggerWorld.h",
              "path": "Engine/include/physics/TriggerWorld.h",
              "topic": "Triggerの接触状態を管理するAPI",
              "explanation": "実形状と相互マスクを使って重なりを調べ、接触の変化をイベントにします。シーンに応じた初期化も行えます。",
              "follow": "Reset・Update・Clear。"
            },
            {
              "label": "TriggerWorld.cpp",
              "path": "Engine/src/physics/TriggerWorld.cpp",
              "topic": "重なりの変化をTriggerイベントへ変換",
              "explanation": "ワールド形状の重なりとレイヤーの条件を確認します。前回と今回の接触から進入・滞在・退出を区別します。",
              "follow": "Update のマスク判定とイベント生成。"
            },
            {
              "label": "RigidBodyDescription.h",
              "path": "Engine/include/physics/RigidBodyDescription.h",
              "topic": "シーンからJoltへ渡す剛体の記述",
              "explanation": "物体ID、ワールド姿勢、Collider、任意の剛体設定をまとめます。剛体設定が未指定または無効化なら静的に扱います。",
              "follow": "RigidBodyWorld::Rebuild が受け取る bodies。"
            },
            {
              "label": "RigidBodySettings.h",
              "path": "Engine/include/physics/RigidBodySettings.h",
              "topic": "剛体のシーン設定",
              "explanation": "質量・摩擦・反発、開始時の速度、回転固定などを保持します。記述は物理ワールドへ登録するときに使われます。",
              "follow": "フィールドを RigidBodyWorld の登録処理と照合。"
            },
            {
              "label": "RigidBodySettings.cpp",
              "path": "Engine/src/physics/RigidBodySettings.cpp",
              "topic": "無効な剛体設定を除く",
              "explanation": "IsValid は質量・摩擦などの範囲や、初速の成分が有限かを確認します。履歴などでは設定同士の比較も使えます。",
              "follow": "IsValid と operator==。"
            },
            {
              "label": "RigidBodyState.h",
              "path": "Engine/include/physics/RigidBodyState.h",
              "topic": "演算後の姿勢・速度を返す",
              "explanation": "物理側で確定したTransform、並進と回転の速度、動作状態をシーン側へ渡すデータです。",
              "follow": "RigidBodyWorld::GetState → ScenePhysics。"
            },
            {
              "label": "RigidBodyWorld.h",
              "path": "Engine/include/physics/RigidBodyWorld.h",
              "topic": "Jolt型を隠した物理ワールドのAPI",
              "explanation": "物体の登録や物理更新、状態の取得、速度・衝撃の設定などを公開します。Jolt本体の型は内部実装に保持します。",
              "follow": "Rebuild・Update・GetState・AddImpulse。"
            },
            {
              "label": "RigidBodyWorld.cpp",
              "path": "Engine/src/physics/RigidBodyWorld.cpp",
              "topic": "エンジンの剛体をJoltへ登録・更新",
              "explanation": "形状・姿勢と剛体設定をJoltへ渡し、物理世界を進めます。物体IDとJoltの剛体を対応付け、姿勢や接触を取り出せます。",
              "follow": "CreateShape → Rebuild → Update → GetState。"
            },
            {
              "label": "JoltRuntime.h",
              "path": "Engine/src/physics/JoltRuntime.h",
              "topic": "ワールドと形状に共通の型登録",
              "explanation": "剛体と形状問い合わせに共通のJolt型登録を返します。ヘッダーは Registry の内部を公開しません。",
              "follow": "Initialize と Registry の前方宣言。"
            },
            {
              "label": "JoltRuntime.cpp",
              "path": "Engine/src/physics/JoltRuntime.cpp",
              "topic": "最初の利用時にJoltを設定する",
              "explanation": "最初の Initialize でアロケーターとFactoryを準備し、ビルド条件を照合して型を登録します。終了時に登録を解除します。",
              "follow": "Registry の RegisterTypes／UnregisterTypes と VerifyJoltVersionID。"
            },
            {
              "label": "Jolt.vcxproj",
              "path": "Engine/external/jolt/Jolt.vcxproj",
              "topic": "外部物理ライブラリのビルド設定",
              "explanation": "Engineがプロジェクト参照するJoltの設定です。自作側はワールドや形状問い合わせでこのライブラリを使います。",
              "follow": "Engine.vcxproj の ProjectReference と JoltRuntime。"
            }
          ]
        }
      }
    },
