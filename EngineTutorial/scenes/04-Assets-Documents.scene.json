        "state": {
          "entries": [
            {
              "label": "ProjectDocument.h",
              "path": "Editor/include/scene/ProjectDocument.h",
              "topic": "プロジェクトと起動シーンを保持",
              "explanation": "起動シーンとゲーム設定の管理に加え、素材とシーンのディレクトリを取得できます。",
              "follow": "Open・GetAssetsDirectory・GetStartupScene。"
            },
            {
              "label": "ProjectDocument.cpp",
              "path": "Editor/src/scene/ProjectDocument.cpp",
              "topic": "project.jsonを開く",
              "explanation": "形式の版と各パスを検証し、プロジェクトルートから起動シーンを解決して scenes 内にあることを確認します。",
              "follow": "Open → GetStartupScene。保存側は Save。"
            },
            {
              "label": "SceneDocument.h",
              "path": "Editor/include/scene/SceneDocument.h",
              "topic": "編集中のシーンと保存地点",
              "explanation": "Scene・EditorHistory・ファイルパスをまとめます。SaveCopy は別ファイルへのコピーを扱います。",
              "follow": "IsModified・SaveAs・SaveCopy。"
            },
            {
              "label": "SceneDocument.cpp",
              "path": "Editor/src/scene/SceneDocument.cpp",
              "topic": "保存成功後に保存地点を更新",
              "explanation": "書き込んでからファイルパスや保存済みデータ、履歴の保存地点を更新します。",
              "follow": "SaveAs → FileUtils::WriteTextAtomically と MarkSaved。"
            },
            {
              "label": "SceneSerializer.h",
              "path": "Engine/include/scene/SceneSerializer.h",
              "topic": "シーンのJSON変換を提供",
              "explanation": "メモリ上の変換とファイル用の変換を公開します。ファイル用の変換に保存位置を渡せます。",
              "follow": "Serialize と SerializeForFile の引数。"
            },
            {
              "label": "SceneSerializer.cpp",
              "path": "Engine/src/scene/SceneSerializer.cpp",
              "topic": "素材の相対参照と版の互換性",
              "explanation": "シーンJSONを読み、設定と物体の候補を検証します。プロジェクト内の素材は @project で参照でき、読み込み時はルートを基準に解決します。",
              "follow": "SerializeForFile と Load。JSONの読み書きには nlohmann/json を使う。"
            },
            {
              "label": "SceneAssetReferences.h",
              "path": "Engine/include/scene/SceneAssetReferences.h",
              "topic": "ファイル参照を調べる共通API",
              "explanation": "モデル・画像などを種類付きで訪問できます。参照を書き換える処理も同じフィールド群を扱います。",
              "follow": "Visit と Rewrite の引数を比較。"
            },
            {
              "label": "SceneAssetReferences.cpp",
              "path": "Engine/src/scene/SceneAssetReferences.cpp",
              "topic": "各コンポーネントから素材参照を列挙",
              "explanation": "物体の素材参照をまとめて走査します。コピーや移動の処理はこのAPIを使って対象パスを集めたり書き換えたりできます。",
              "follow": "Visit と Rewrite がモデルや画像を扱う箇所。"
            },
            {
              "label": "GameConfig.h",
              "path": "Engine/include/gameplay/GameConfig.h",
              "topic": "シーンと別に保つゲーム設定",
              "explanation": "起動シーンへのパス、タイトル、ウィンドウ寸法、入力設定などを持ちます。",
              "follow": "HasValidWindowSettings・HasValidStartupSettings。"
            },
            {
              "label": "GameConfig.cpp",
              "path": "Engine/src/gameplay/GameConfig.cpp",
              "topic": "game.jsonと実行時の設定を読み込む",
              "explanation": "Deserialize は読み込んだ設定を検証します。出力ゲームのスクリプト設定の読み込みもこの実装にあります。",
              "follow": "Deserialize と LoadScriptSettings。配布時の使い方は第11章。"
            },
            {
              "label": "SceneRecovery.h",
              "path": "Editor/include/files/SceneRecovery.h",
              "topic": "セッションごとに未保存シーンを記録",
              "explanation": "スナップショットと候補の情報を定義し、候補の列挙や読み込みを行うAPIを公開します。",
              "follow": "Record・Enumerate・Read。"
            },
            {
              "label": "SceneRecovery.cpp",
              "path": "Editor/src/files/SceneRecovery.cpp",
              "topic": "未保存の状態と復旧候補を管理",
              "explanation": "Record で復旧用に状態を記録します。Enumerate と Read で候補を調べ、明示したファイルを復旧に使えます。",
              "follow": "Initialize → Record、復旧側は Enumerate → Read。"
            },
            {
              "label": "OutputDirectory.h",
              "path": "Editor/include/files/OutputDirectory.h",
              "topic": "新規フォルダへの出力と片付け",
              "explanation": "出力ファイルの作成、コピー、完了を扱います。失敗時に出力中に作ったものを片付ける情報も持ちます。",
              "follow": "Create・Copy・Complete・Cleanup。"
            },
            {
              "label": "OutputDirectory.cpp",
              "path": "Editor/src/files/OutputDirectory.cpp",
              "topic": "出力失敗時に作成物の識別を確認",
              "explanation": "作ったファイルを記録し、失敗後の片付けでは識別情報を確かめます。置き換わったファイルを削除しないための処理です。",
              "follow": "Copy と Text の作成処理、Cleanup の識別情報確認。"
            }
          ]
        }
      }
    },
