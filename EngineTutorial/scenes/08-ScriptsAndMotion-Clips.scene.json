        "state": {
          "entries": [
            {
              "label": "AnimationClipComponent.h",
              "path": "Engine/include/animation/AnimationClipComponent.h",
              "topic": "物体やUIのプロパティに時刻を割り当てる型",
              "explanation": "各トラックで秒単位のキーを持ちます。マーカーやクリップ末尾では Trigger Actions と接続できます。",
              "follow": "トラックの値型と SceneSimulation のクリップ更新。"
            },
            {
              "label": "AnimationClipAsset.h",
              "path": "Engine/include/animation/AnimationClipAsset.h",
              "topic": "クリップをシーンから独立して保存",
              "explanation": ".clip.json を読み書きします。素材上の割り当て枠は再生用に解決してからシーンの物体IDへ結び付けます。",
              "follow": "IsPath・Load・Save・Resolve。"
            },
            {
              "label": "AnimationPlaybackState.h",
              "path": "Engine/include/animation/AnimationPlaybackState.h",
              "topic": "クリップの再生位置と再生状態",
              "explanation": "再生用データから得られる、クリップの時刻や再生状態を表します。",
              "follow": "アニメーションを問い合わせる処理が返す状態。"
            },
            {
              "label": "TransformAnimationComponent.h",
              "path": "Engine/include/animation/TransformAnimationComponent.h",
              "topic": "開始姿勢に対する変形をキーにする",
              "explanation": "変形のキーに移動量、回転、拡大率を格納します。開始姿勢を基準として変形を再生できます。",
              "follow": "キーフレームと Sample の出力。"
            },
            {
              "label": "TransformAnimationComponent.cpp",
              "path": "Engine/src/animation/TransformAnimationComponent.cpp",
              "topic": "経過秒数からキーの間を評価",
              "explanation": "キーや設定を検証し、再生時間からクリップ内の時刻を得ます。Sample は該当する変形を計算します。",
              "follow": "IsValid → GetClipTime → Sample。"
            },
            {
              "label": "SceneAnimations.h",
              "path": "Engine/include/animation/SceneAnimations.h",
              "topic": "編集データと各物体の再生状態を分ける",
              "explanation": "開始姿勢と再生時刻・制御状態を物体ごとに保ちます。更新では評価した変形を再生シーンへ反映できます。",
              "follow": "Configure・Advance・Control。"
            },
            {
              "label": "SceneAnimations.cpp",
              "path": "Engine/src/animation/SceneAnimations.cpp",
              "topic": "物体の開始姿勢に評価値を適用",
              "explanation": "Apply は評価した値を変形へ反映します。進行と操作の中で元の姿勢との関係を維持します。",
              "follow": "Configure → Advance → Apply。開始姿勢の調整は Rebase。"
            },
            {
              "label": "AnimationClipEditor.h",
              "path": "Editor/include/animation/AnimationClipEditor.h",
              "topic": "Assetsからアニメーションクリップを開く",
              "explanation": "素材として保存するクリップの編集状態と保存操作を持ちます。タイムラインのキーを画面で編集できます。",
              "follow": "ShowCreate・ShowEdit・Draw。"
            },
            {
              "label": "AnimationClipEditor.cpp",
              "path": "Editor/src/animation/AnimationClipEditor.cpp",
              "topic": "トラックとキーフレームを編集して保存",
              "explanation": "対象や時刻、値を一時データに編集します。確定側でクリップアセットとして保存します。",
              "follow": "DrawKeys と Draw の保存処理。"
            },
            {
              "label": "TransformAnimationInspector.h",
              "path": "Editor/include/animation/TransformAnimationInspector.h",
              "topic": "物体の変形アニメーション設定の画面",
              "explanation": "キーと再生設定をInspectorで変更し、連続入力を一つの取り消し操作へまとめます。",
              "follow": "Draw と DrawReadOnly。"
            },
            {
              "label": "TransformAnimationInspector.cpp",
              "path": "Editor/src/animation/TransformAnimationInspector.cpp",
              "topic": "変形のキーの編集を履歴へつなぐ",
              "explanation": "物体のキーと再生設定の入力を扱い、設定変更を編集履歴へ渡します。",
              "follow": "Draw の設定編集と EditorHistory。"
            }
          ]
        }
      }
    },
