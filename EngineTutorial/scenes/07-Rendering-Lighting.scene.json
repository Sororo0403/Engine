        "state": {
          "entries": [
            {
              "label": "LightingSettings.h",
              "path": "Engine/include/graphics/lighting/LightingSettings.h",
              "topic": "環境光と従来の平行光設定",
              "explanation": "シーンやゲームで使う環境光の値を持ちます。従来の平行光の値も、旧データを移行できるよう保持します。",
              "follow": "SceneLighting::MigrateLegacyDirectionalLight と環境光の取得。"
            },
            {
              "label": "DirectionalLightData.h",
              "path": "Engine/include/graphics/lighting/DirectionalLightData.h",
              "topic": "GPUへ環境光と平行光を渡す型",
              "explanation": "光の方向・色・強度と、複数の平行光や環境光を固定のレイアウトでまとめます。",
              "follow": "DirectionalLightsData と Mesh.PS.hlsl の定数。"
            },
            {
              "label": "DirectionalLight.h",
              "path": "Engine/include/graphics/lighting/DirectionalLight.h",
              "topic": "平行光を定数バッファへ送る",
              "explanation": "平行光と環境光の値をGPU向けの領域へ保持し、メッシュ描画が使うアドレスを返します。",
              "follow": "Initialize・Update と GetConstantBufferAddress。"
            },
            {
              "label": "DirectionalLight.cpp",
              "path": "Engine/src/graphics/lighting/DirectionalLight.cpp",
              "topic": "複数の平行光の定数を更新",
              "explanation": "有効な範囲の光や環境光データを受け取り、プールから割り当てた定数バッファを更新します。",
              "follow": "Initialize と Update の検証・書き込み。"
            },
            {
              "label": "PointLightData.h",
              "path": "Engine/include/graphics/lighting/PointLightData.h",
              "topic": "点光源のGPU用の32バイト配置",
              "explanation": "位置・届く範囲・色・強度をGPU側の定義に合わせて持ちます。",
              "follow": "Mesh.PS.hlsl の PointLight とメンバー順を比較。"
            },
            {
              "label": "PointLights.h",
              "path": "Engine/include/graphics/lighting/PointLights.h",
              "topic": "ワールドの点光源を一括で転送",
              "explanation": "複数の点光源のデータをまとめて保持し、メッシュで参照する定数バッファを公開します。",
              "follow": "Update と GetConstantBufferAddress。"
            },
            {
              "label": "PointLights.cpp",
              "path": "Engine/src/graphics/lighting/PointLights.cpp",
              "topic": "点光源一覧と件数をGPUへ反映",
              "explanation": "今回の一覧を定数バッファへまとめます。適用できる件数の範囲も確認します。",
              "follow": "Update の件数確認から書き込みまで。"
            },
            {
              "label": "SpotLightData.h",
              "path": "Engine/include/graphics/lighting/SpotLightData.h",
              "topic": "スポットライトのGPU用の64バイト配置",
              "explanation": "位置、方向、範囲、照射角などをHLSLに対応する配置で持ちます。",
              "follow": "Mesh.PS.hlsl の SpotLight と配置を比較。"
            },
            {
              "label": "SpotLights.h",
              "path": "Engine/include/graphics/lighting/SpotLights.h",
              "topic": "スポットライト群を転送するAPI",
              "explanation": "1描画ワールドのスポットライトをまとめてGPUへ渡す定数バッファを管理します。",
              "follow": "Update と GetConstantBufferAddress。"
            },
            {
              "label": "SpotLights.cpp",
              "path": "Engine/src/graphics/lighting/SpotLights.cpp",
              "topic": "スポットライトの定数データを更新",
              "explanation": "光源一覧の件数を検査し、各光源の値をシェーダー向けの定数領域にまとめます。",
              "follow": "Update のデータ構築。"
            },
            {
              "label": "ShadowSettings.h",
              "path": "Engine/include/graphics/lighting/ShadowSettings.h",
              "topic": "平行光が作る影の範囲と精度",
              "explanation": "影の有効化、範囲、解像度や濃さと、自己遮蔽を抑える補正を保持します。",
              "follow": "ShadowCamera::Build と LightingControls::DrawShadows。"
            },
            {
              "label": "FogSettings.h",
              "path": "Engine/include/graphics/lighting/FogSettings.h",
              "topic": "カメラから離れた物体へ掛ける霧",
              "explanation": "霧の範囲や色などの設定を保持します。メッシュ描画がカメラからの距離に応じて使用します。",
              "follow": "MeshFogData と Mesh.PS.hlsl の FogBuffer。"
            },
            {
              "label": "SceneLighting.h",
              "path": "Engine/include/scene/SceneLighting.h",
              "topic": "シーンの照明を集めるAPI",
              "explanation": "光源オブジェクトを描画用に収集し、環境光を反映します。旧形式の平行光をオブジェクトへ移す処理も公開します。",
              "follow": "CollectDirectionalLights・CollectPointLights・CollectSpotLights。"
            },
            {
              "label": "SceneLighting.cpp",
              "path": "Engine/src/scene/SceneLighting.cpp",
              "topic": "親子合成後の位置や向きで光を集める",
              "explanation": "有効な光をID順に集めます。スポットライトの方向には親子合成後の回転を使います。",
              "follow": "CollectSpotLights の方向、MigrateLegacyDirectionalLight。"
            },
            {
              "label": "LightingControls.h",
              "path": "Editor/include/lighting/LightingControls.h",
              "topic": "影の編集項目を表示するAPI",
              "explanation": "平行光用の ShadowSettings を受け取り、Editorで項目を表示・編集する関数を公開します。",
              "follow": "DrawShadows と呼び出し元の平行光編集。"
            },
            {
              "label": "LightingControls.cpp",
              "path": "Editor/src/lighting/LightingControls.cpp",
              "topic": "影の解像度や補正を編集する",
              "explanation": "平行光の影の設定を画面に表示し、範囲やバイアスなどを入力できます。",
              "follow": "DrawShadows の各項目と ShadowSettings。"
            },
            {
              "label": "PointLightInspector.h",
              "path": "Editor/include/lighting/PointLightInspector.h",
              "topic": "点光源コンポーネントの編集画面",
              "explanation": "色・強さ・範囲を履歴付きで編集します。読み取り専用の表示も持ちます。",
              "follow": "Draw・DrawReadOnly。"
            },
            {
              "label": "PointLightInspector.cpp",
              "path": "Editor/src/lighting/PointLightInspector.cpp",
              "topic": "点光源の変更を履歴へつなぐ",
              "explanation": "色や強度などへの入力を受け、物体ごとの点光源設定の変更として扱います。",
              "follow": "Draw の継続編集と EditorHistory。"
            },
            {
              "label": "SpotLightInspector.h",
              "path": "Editor/include/lighting/SpotLightInspector.h",
              "topic": "スポットライトの編集画面",
              "explanation": "色・強さ・範囲に加え、照射角を履歴付きで編集できます。",
              "follow": "Draw と DrawReadOnly、角度の入力。"
            },
            {
              "label": "SpotLightInspector.cpp",
              "path": "Editor/src/lighting/SpotLightInspector.cpp",
              "topic": "照射角を含むライト設定を変更する",
              "explanation": "スポットライトのプロパティを表示し、画面の変更を履歴を通じて設定に反映します。",
              "follow": "Draw の角度入力と EditorHistory。"
            }
          ]
        }
      }
    },
