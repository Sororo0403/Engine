        "state": {
          "entries": [
            {
              "label": "PathUtils.h",
              "path": "Engine/include/platform/windows/PathUtils.h",
              "topic": "パスの表示・判定・解決を共通化",
              "explanation": "実行ファイル基準の解決、UTF-8との変換、拡張子やファイル名の検査などを公開します。",
              "follow": "ResolveFromExecutable・RelativeInside・IsValidFileName。"
            },
            {
              "label": "PathUtils.cpp",
              "path": "Engine/src/platform/windows/PathUtils.cpp",
              "topic": "パスを解決して範囲と同一性を調べる",
              "explanation": "Win32から実行ファイルの位置を取得します。素材の操作では同じファイルか、対象が指定範囲内かを確認できます。",
              "follow": "GetExecutablePath・ResolveFromExecutable・RelativeInside。"
            },
            {
              "label": "FileUtils.h",
              "path": "Engine/include/platform/windows/FileUtils.h",
              "topic": "書き終えた内容を保存先へ確定するAPI",
              "explanation": "テキストやバイト列を一時ファイルへ書いてから確定し、上書きの可否やエラーを呼び出し側が扱えるようにします。",
              "follow": "WriteTextAtomically と WriteBytesAtomically。"
            },
            {
              "label": "FileUtils.cpp",
              "path": "Engine/src/platform/windows/FileUtils.cpp",
              "topic": "保存先の置き換えと失敗時の片付け",
              "explanation": "一時ファイルへの書き込みを終えてから保存先に切り替えます。失敗した場合は作成物の片付けも試みます。",
              "follow": "WriteBytesAtomically の書き込み・フラッシュ・名前変更。"
            },
            {
              "label": "ShellUtils.h",
              "path": "Engine/include/platform/windows/ShellUtils.h",
              "topic": "Explorer、ごみ箱、別プロセスの入口",
              "explanation": "フォルダの表示やファイルの選択、ごみ箱への移動、実行ファイルの起動・状態確認を扱います。",
              "follow": "RevealInExplorer・RecycleAsset・ExecutableProcess。"
            },
            {
              "label": "ShellUtils.cpp",
              "path": "Engine/src/platform/windows/ShellUtils.cpp",
              "topic": "Windowsのシェル操作とプロセス管理",
              "explanation": "ごみ箱にはシェルの操作を使います。ゲームを別プロセスで起動し、終了を待たずに状態を確認する経路もあります。",
              "follow": "RecycleAsset と ExecutableProcess::Start／Poll。"
            }
          ]
        }
      }
    },
