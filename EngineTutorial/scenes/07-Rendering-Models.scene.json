        "state": {
          "entries": [
            {
              "label": "ModelLoader.h",
              "path": "Engine/include/graphics/model/ModelLoader.h",
              "topic": "モデルのCPU側読み込み口",
              "explanation": "形状・材質と、存在すればボーンやアニメーションクリップを共通のデータへ読み込みます。依存ファイルも取得できます。",
              "follow": "Load の ModelData 出力と注意事項。"
            },
            {
              "label": "ModelLoader.cpp",
              "path": "Engine/src/graphics/model/ModelLoader.cpp",
              "topic": "Assimpのシーンを描画用データに変える",
              "explanation": "Assimpのメッシュや材質を変換します。glTFの外部画像や埋め込み画像も材質からたどります。",
              "follow": "Load と LoadBaseColorTexture。外部依存はAssimpの読み込みI/Oへ。"
            },
            {
              "label": "ModelData.h",
              "path": "Engine/include/graphics/model/ModelData.h",
              "topic": "読み込んだ形状と材質の関係",
              "explanation": "複数のメッシュ、メッシュが参照する材質、読み込み済みの材質やアニメーションの情報をCPU側で保持します。",
              "follow": "ModelLoader::Load → Model::Initialize。"
            },
            {
              "label": "Model.h",
              "path": "Engine/include/graphics/model/Model.h",
              "topic": "複数物体で共有するモデル",
              "explanation": "メッシュや初期材質など、同じモデルを配置した物体が共有できるリソースを保持します。",
              "follow": "GetMeshCount・GetMaterialCount・GetBoundsCorners。"
            },
            {
              "label": "Model.cpp",
              "path": "Engine/src/graphics/model/Model.cpp",
              "topic": "メッシュと材質をGPUリソースへ変える",
              "explanation": "Initialize で CPU側のモデルからメッシュと材質を用意します。選択のための境界やレイ判定も提供します。",
              "follow": "Initialize → CreateMeshes。選択側は Raycast。"
            },
            {
              "label": "ModelHandle.h",
              "path": "Engine/include/graphics/model/ModelHandle.h",
              "topic": "マネージャーから渡すモデル参照",
              "explanation": "読み込み済みモデルを共有参照で保持し、呼び出し側がモデルの寿命を共有できるようにします。",
              "follow": "ModelManager::Load の戻り値と RenderWorld。"
            },
            {
              "label": "ModelManager.h",
              "path": "Engine/include/graphics/model/ModelManager.h",
              "topic": "モデル読み込みとキャッシュのAPI",
              "explanation": "モデルを読み込んで共有し、変更を反映する再読み込みも扱います。境界や材質の一覧を取得できます。",
              "follow": "Load・Reload・GetLocalBounds。"
            },
            {
              "label": "ModelManager.cpp",
              "path": "Engine/src/graphics/model/ModelManager.cpp",
              "topic": "読み込み済みモデルをパスで再利用",
              "explanation": "LoadFile でキャッシュを確認し、必要ならCPUデータとGPUリソースを準備します。再読込に使う更新情報も管理します。",
              "follow": "Load → LoadFile。変更側は LoadUpdated／Reload。"
            },
            {
              "label": "ModelInstance.h",
              "path": "Engine/include/graphics/model/ModelInstance.h",
              "topic": "物体ごとの描画状態",
              "explanation": "共有モデルを使いながら、物体ごとの変形、材質の割り当て、アニメーション姿勢を扱います。",
              "follow": "Update・SetMaterial・SetAnimationPose。"
            },
            {
              "label": "ModelInstance.cpp",
              "path": "Engine/src/graphics/model/ModelInstance.cpp",
              "topic": "共有メッシュを物体の姿勢で描く",
              "explanation": "Modelのメッシュからインスタンスを用意し、今回の姿勢や材質で更新します。描画時は必要なメッシュを描きます。",
              "follow": "Initialize → Update → Draw。骨の姿勢は SetAnimationPose。"
            },
            {
              "label": "Vertex.h",
              "path": "Engine/include/graphics/mesh/Vertex.h",
              "topic": "メッシュの頂点レイアウト",
              "explanation": "位置、色、テクスチャ座標、法線などを頂点の値として持ちます。GPUに渡す型とHLSLの入力が対応します。",
              "follow": "Vertex と MeshRenderer の入力レイアウトを照合。"
            },
            {
              "label": "MeshData.h",
              "path": "Engine/include/graphics/mesh/MeshData.h",
              "topic": "CPU側の頂点とインデックス",
              "explanation": "メッシュになる頂点列と、頂点の組み合わせを指定するインデックス列を保持します。",
              "follow": "ModelData が持つ形状から Mesh の初期化へ。"
            },
            {
              "label": "Mesh.h",
              "path": "Engine/include/graphics/mesh/Mesh.h",
              "topic": "GPUへ送った共有の頂点と索引",
              "explanation": "頂点・インデックスのバッファと描画用のビューを管理します。変形や材質とは別に保持できます。",
              "follow": "Initialize・Draw・Finalize。"
            },
            {
              "label": "Mesh.cpp",
              "path": "Engine/src/graphics/mesh/Mesh.cpp",
              "topic": "頂点と索引を描画命令につなぐ",
              "explanation": "受け取った頂点と索引をGPUで読めるようにし、Draw でバッファを設定して索引付きの描画を記録します。",
              "follow": "Initialize と Draw のバッファ設定。"
            },
            {
              "label": "MeshInstance.h",
              "path": "Engine/include/graphics/mesh/MeshInstance.h",
              "topic": "個々のメッシュの変形と描画データ",
              "explanation": "同じ Mesh を参照しながら、変形・材質・ボーンの状態を個別に持てます。",
              "follow": "Initialize の Mesh と UpdateSkinning。"
            },
            {
              "label": "MeshInstance.cpp",
              "path": "Engine/src/graphics/mesh/MeshInstance.cpp",
              "topic": "シェーダー用の変換行列を更新",
              "explanation": "ワールド行列とカメラ行列から頂点変換用の定数を用意します。スキニング用の定数も更新できます。",
              "follow": "Update と UpdateSkinning、GetSkinningAddress。"
            },
            {
              "label": "SkinningConstants.h",
              "path": "Engine/include/graphics/mesh/SkinningConstants.h",
              "topic": "ボーンと法線用の変換を保持",
              "explanation": "各ボーンの位置用・法線用の行列を持ちます。末尾の枠は重みがない頂点が所属ノードの変換を使うために予約します。",
              "follow": "Skinning.hlsli の Skinning と配列の上限を照合。"
            }
          ]
        }
      }
    },
