        "state": {
          "entries": [
            {
              "label": "D3D12Graphics.h",
              "path": "Engine/include/graphics/render/D3D12Graphics.h",
              "topic": "D3D12のフレームとGPUリソースの入口",
              "explanation": "デバイス、コマンドの送信、スワップチェーン、描画用のバッファを管理します。",
              "follow": "Initialize・BeginFrame・EndFrame・Resize。"
            },
            {
              "label": "D3D12Graphics.cpp",
              "path": "Engine/src/graphics/render/D3D12Graphics.cpp",
              "topic": "命令送信・表示・GPU待機の順番",
              "explanation": "BeginFrame で描画命令を記録できるようにし、EndFrame で送信し Present します。GPU完了を待って定数領域を再利用できます。",
              "follow": "BeginFrame → EndFrame → ReclaimCompletedFrame。"
            },
            {
              "label": "D3D12Helpers.h",
              "path": "Engine/include/graphics/render/D3D12Helpers.h",
              "topic": "リソースの状態遷移を記録するAPI",
              "explanation": "テクスチャ全体の状態を切り替えるバリアを記録します。現在の状態は呼び出し側が渡します。",
              "follow": "D3D12Helpers.cpp と RenderTexture の呼び出し。"
            },
            {
              "label": "D3D12Helpers.cpp",
              "path": "Engine/src/graphics/render/D3D12Helpers.cpp",
              "topic": "遷移前後の状態からバリアを作る",
              "explanation": "渡された状態を使ってコマンドリストへリソースバリアを記録します。GPUが処理を終えるのを待つ役割は別です。",
              "follow": "バリアの StateBefore／StateAfter と ResourceBarrier。"
            },
            {
              "label": "RenderTexture.h",
              "path": "Engine/include/graphics/render/RenderTexture.h",
              "topic": "テクスチャを描画先にするAPI",
              "explanation": "色と深度を持ち、描いた色をUIなどから画像として使えます。表示領域に合わせて大きさを変更できます。",
              "follow": "Resize と描画を開始・終了する操作。"
            },
            {
              "label": "RenderTexture.cpp",
              "path": "Engine/src/graphics/render/RenderTexture.cpp",
              "topic": "描画した色を次の処理で読めるようにする",
              "explanation": "色と深度のバッファを準備し、描画先として使う状態とシェーダーから読み出す状態を切り替えます。",
              "follow": "Resize とバリアを記録する箇所。"
            },
            {
              "label": "ShadowMap.h",
              "path": "Engine/include/graphics/render/ShadowMap.h",
              "topic": "ライトから見た深度と参照を保持",
              "explanation": "影の深度、光源の行列、参照に使うSRV領域を描画ワールドごとに管理します。",
              "follow": "Update・Begin・End と GetShadowSrv。"
            },
            {
              "label": "ShadowMap.cpp",
              "path": "Engine/src/graphics/render/ShadowMap.cpp",
              "topic": "深度の書き込みとサンプリングを切り替える",
              "explanation": "影を描くときに深度バッファを準備し、メッシュ描画ではシェーダーから影の深度を参照できるようにします。",
              "follow": "Begin と End の遷移、GetShadowSrv。"
            },
            {
              "label": "ShaderCompiler.h",
              "path": "Engine/include/graphics/render/ShaderCompiler.h",
              "topic": "HLSLをコンパイルして渡すAPI",
              "explanation": "シェーダーのコンパイル環境と結果を扱います。コンパイルした結果は各レンダラーが初期化に使います。",
              "follow": "Initialize と Compile の entryPoint／profile。"
            },
            {
              "label": "ShaderCompiler.cpp",
              "path": "Engine/src/graphics/render/ShaderCompiler.cpp",
              "topic": "DXCでHLSLをGPU向けにコンパイル",
              "explanation": "頂点・ピクセルなどのシェーダーを読み込み、DXCへコンパイル引数を渡します。失敗はログへ出力します。",
              "follow": "Initialize と DXC のコンパイル呼び出し。"
            },
            {
              "label": "ConstantBuffer.h",
              "path": "Engine/include/graphics/buffer/ConstantBuffer.h",
              "topic": "型付きデータをGPUへ渡す定数バッファ",
              "explanation": "CPUが書けるようにマップされた定数領域と、そのGPUアドレスを保持します。",
              "follow": "GPU仮想アドレスの取得と ConstantBufferPool。"
            },
            {
              "label": "ConstantBufferPool.h",
              "path": "Engine/include/graphics/buffer/ConstantBufferPool.h",
              "topic": "定数用のアップロード領域を共有",
              "explanation": "ページを分割して割り当てるAPIです。Allocation がその領域の寿命を管理します。",
              "follow": "Allocate と Allocation、ReclaimCompletedFrame。"
            },
            {
              "label": "ConstantBufferPool.cpp",
              "path": "Engine/src/graphics/buffer/ConstantBufferPool.cpp",
              "topic": "空きスロットを確保して完了後に再利用",
              "explanation": "一定の境界にそろえたスロットの位置からCPUとGPUのアドレスを求めます。使用済み領域はGPU完了後に空きへ戻ります。",
              "follow": "Allocate → Allocation::Reset → ReclaimCompletedFrame。"
            }
          ]
        }
      }
    },
