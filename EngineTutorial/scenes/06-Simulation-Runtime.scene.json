        "state": {
          "entries": [
            {
              "label": "SceneCameraUtils.h",
              "path": "Engine/include/gameplay/SceneCameraUtils.h",
              "topic": "カメラ姿勢と更新順の共通API",
              "explanation": "Primary Camera、親子合成後の姿勢、追従と壁回避を扱います。同じ障害物の形状を複数の追従カメラで共有できます。",
              "follow": "GetUpdateOrder・FollowObstacleCache・BlendPose。"
            },
            {
              "label": "SceneCameraUtils.cpp",
              "path": "Engine/src/gameplay/SceneCameraUtils.cpp",
              "topic": "依存順と障害物を考慮して追従",
              "explanation": "親と追従元を先に評価します。壁回避では注視点からの移動経路を調べ、障害物の手前へ視点を寄せます。",
              "follow": "GetUpdateOrder と FollowObstacleCache::AvoidObstacles。"
            },
            {
              "label": "ScenePhysics.h",
              "path": "Engine/include/gameplay/ScenePhysics.h",
              "topic": "シーンと物理ワールドの橋渡し",
              "explanation": "シーンのColliderと剛体設定を使い、編集状態と独立した実行時の物理状態を扱います。",
              "follow": "Configure・Advance・AddImpulse。"
            },
            {
              "label": "ScenePhysics.cpp",
              "path": "Engine/src/gameplay/ScenePhysics.cpp",
              "topic": "物理で進めた姿勢をシーンへ戻す",
              "explanation": "Configure はシーンの設定を物理側へ準備し、Advance では運動を進めて動的な物体の姿勢をシーンへ反映します。",
              "follow": "Configure → Advance 内の SetWorldPose。"
            },
            {
              "label": "SceneSimulation.h",
              "path": "Engine/include/gameplay/SceneSimulation.h",
              "topic": "試遊シーンの実行と状態の取得",
              "explanation": "編集シーンと独立したデータで、物理・移動・追従・スクリプトなどを実行します。",
              "follow": "Start・Update・Stop と GetScene。"
            },
            {
              "label": "SceneSimulation.cpp",
              "path": "Engine/src/gameplay/SceneSimulation.cpp",
              "topic": "フレームの処理順と遷移を管理",
              "explanation": "更新では作業シーンを使い、アニメーション、経路、物理、物体ごとの処理などを進めます。問題なく進んだ状態を採用します。",
              "follow": "StartScene と Update → Advance。"
            },
            {
              "label": "SceneSimulationActions.cpp",
              "path": "Engine/src/gameplay/SceneSimulationActions.cpp",
              "topic": "イベントを物体操作へ変換",
              "explanation": "接触や操作入力の通知をため、Trigger Actions の条件と照合します。瞬間移動などの操作後は関連状態を同期します。",
              "follow": "QueueActionSignals → ApplyTriggerActions → ApplyTeleports。"
            },
            {
              "label": "SceneSimulationObjects.cpp",
              "path": "Engine/src/gameplay/SceneSimulationObjects.cpp",
              "topic": "再生中にPrefabを生成・削除する",
              "explanation": "Prefabを候補シーンへ配置し、再生状態を更新します。削除では対象と参照を整理して、必要なTriggerイベントを扱います。",
              "follow": "InstantiatePrefab と DestroyObjects。"
            },
            {
              "label": "SceneValidation.h",
              "path": "Engine/include/gameplay/SceneValidation.h",
              "topic": "試遊前に見つけた問題の型とAPI",
              "explanation": "コンポーネント設定や初期配置の問題を識別し、名前付き操作が現在のゲーム設定にあるかも調べます。",
              "follow": "SceneValidationIssue・Inspect・InspectInputs。"
            },
            {
              "label": "SceneValidation.cpp",
              "path": "Engine/src/gameplay/SceneValidation.cpp",
              "topic": "開始時の問題を物体と関連付けて報告",
              "explanation": "再生に使う設定や配置を検証し、エディターが確認できる情報を返します。入力の割り当てを調べる処理もあります。",
              "follow": "Inspect と InspectInputs。"
            },
            {
              "label": "ScriptComponent.h",
              "path": "Engine/include/gameplay/ScriptComponent.h",
              "topic": "編集時に指定するLuaの起動情報",
              "explanation": "Luaアセット、初期状態、名前付きの参照を保持します。実行中のスクリプト状態は別の領域で管理します。",
              "follow": "IsValid と SceneSimulation からの初期化。"
            },
            {
              "label": "ScriptComponent.cpp",
              "path": "Engine/src/gameplay/ScriptComponent.cpp",
              "topic": "Luaの初期設定の整合性を確認",
              "explanation": "アセットと参照、初期状態などの設定を検証します。",
              "follow": "IsValid の参照名と各値のチェック。"
            },
            {
              "label": "TriggerAction.h",
              "path": "Engine/include/gameplay/TriggerAction.h",
              "topic": "条件と実行内容を表す設定",
              "explanation": "Triggerへの進入・退出や操作入力、UI Buttonなどを実行条件にし、対象への操作内容を設定します。",
              "follow": "UsesTarget・UsesDestination と ApplyTriggerActions。"
            },
            {
              "label": "TriggerActionsComponent.h",
              "path": "Engine/include/gameplay/TriggerActionsComponent.h",
              "topic": "物体ごとの操作を指定順で保持",
              "explanation": "同じ物体に設定した複数の操作を順番付きで保持します。アクションの組をシーン内のコンポーネントとして保存します。",
              "follow": "actions の並びを SceneSimulationActions で読む。"
            }
          ]
        }
      }
    },
